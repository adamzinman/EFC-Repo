{
  "projects": [
    "projects/EFC_Library"
  ],
  "output_dir": "steward",
  "template_folders": [
    "Templates"
  ],
  "dock_map": {
    "Templates/Valves": "dw_ValveDiscrete",
    "Templates/Valves/Valve_Control": "dw_ValveAnalog",
    "Templates/Rotating": "dw_Rotating",
    "Templates/Rotating/VFD": "dw_VFD",
    "Templates/HeatTransfer": "dw_HeatTransfer",
    "Templates/ProcessValues": "dw_ProcessValue",
    "Templates/AnalogIndicator": "dw_ProcessValue",
    "Templates/Loops": "dw_Loop",
    "Templates/Station": "dw_Station",
    "Templates/IO": "dw_IOCard",
    "Templates/HeatTransfer/Heater_Electric": "dw_Heater"
  },
  "rules": {
    "require_dock": false,
    "dock_events": [],
    "require_pclib": true,
    "max_inline_styles": 0,
    "check_palette": true,
    "require_docs": true,
    "project_json_at_root": true
  },
  "pclib": {
    "type_regex": "\\bT_[A-Za-z0-9_]+",
    "udt_exports": [
      "types/export/PCLib_Ignition81.json",
      "types/T_KPI/T_KPI_Ignition81.json"
    ]
  },
  "styles": {
    "projects": [
      "EFC_Library"
    ],
    "palette_from_style_classes": true,
    "palette": [
      "#262626",
      "#EBEBEB",
      "#F2F2F2",
      "#333333"
    ]
  },
  "deprecated_calls": {},
  "exempt": [
    "Templates/AnalogIndicator/_Examples",
    "Styles/_Catalog",
    "Templates/IO/Parts/AnalogRow_AI",
    "Templates/IO/Parts/AnalogRow_AO",
    "Templates/IO/Parts/AnalogRow_TEMP",
    "Templates/IO/Parts/DiscreteTile",
    "Templates/IO/Parts/SlotTile",
    "Templates/IO/_Demo",
    "Templates/Loops/_Demo",
    "Templates/ProcessValues/_Demo",
    "Templates/Dynamic Window/IO/IOCard",
    "Templates/Dynamic Window/Parts/BypassConfirm",
    "Templates/Dynamic Window/Parts/IntlkList",
    "Templates/Dynamic Window/Parts/Trend",
    "Templates/Dynamic Window/Station/Station",
    "Templates/Station/_Demo",
    "Templates/_Demo"
  ],
  "upstream_check_days": 30,
  "_note": "require_dock off: templates call efc.ui.openDynamic, which opens the dynamic window in the dw_Right dock via alterDock + openDock (decision 31); wiring is checked by steward/tools/gaps.py.",
  "_exempt_note": "exempt = demo screens, catalogs and parts with no T_ type of their own (IO Parts, Dynamic Window/Parts), the native x80 IOCard window, and Dynamic Window/Station/Station (imported Station_Sidebar, relocated by build.py; binds T_Station members through tagPath only). LoopConfig was retired (decision 15)."
}
