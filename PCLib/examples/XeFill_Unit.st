PROGRAM XeFill_Unit
(* =====================================================================
   EXAMPLE unit program: xenon cylinder filling
   One large source cylinder -> diaphragm compressor -> fill header -> 6 fill
   stations, each filling one cylinder by weight.
     PH_Feed / fbFeed : FB_PhFeed   pressurises the header, owned by this unit
                                    logic and started when a station asks for feed
     PH_Stn[n] / fbStnN : FB_PhFill fills the cylinder on station n, started by
                                    the operator (or a batch server via Prog_Cmd)
   In Control Expert: create the VAR block below in the Data Editor (DFB
   instances cannot be arrays, so there is one fbStnN per station) and paste
   the body into an ST section of the MAST task.
   PCLib 1.00 - generated by gen_phase.py
   ===================================================================== *)
VAR
    EStopAct : BOOL;                        (* E-stop active, from the safety relay *)
    FeedAuto : BOOL := TRUE;                (* HMI: the unit runs the feed phase *)
    xFeedOwned : BOOL;                      (* the unit owned the feed phase last scan *)
    xInit : BOOL := TRUE;                   (* first scan of this program *)
    nFeedReq : INT;                         (* stations asking for feed *)
    i : INT;

    PH_Feed : T_Phase;                      (* feed phase *)
    BAR_Feed : T_SeqBar;
    fbFeed : FB_PhFeed;
    Feed_PermOK : BOOL := TRUE;             (* feed start permissives (T_Intlk group) *)
    Feed_IntlkOK : BOOL := TRUE;            (* feed interlocks healthy (T_Intlk group) *)
    Src_Wt : REAL;                          (* WT-100 source cylinder net weight (kg) *)
    Suct_PT : REAL;                         (* PT-101 compressor suction (bar g) *)
    Hdr_PT : REAL;                          (* PT-110 fill header (bar g) *)
    Comp_Rdy : BOOL;                        (* K-100 ready *)
    Comp_Run : BOOL;                        (* K-100 running *)
    Src_VlvReq : BOOL;                      (* -> XV-100 source cylinder valve *)
    Comp_RunReq : BOOL;                     (* -> K-100 run *)
    Comp_LoadReq : BOOL;                    (* -> K-100 load *)
    Recycle_VlvReq : BOOL;                  (* -> XV-105 recycle / bypass *)

    PH_Stn : ARRAY[1..6] OF T_Phase;         (* station fill phases *)
    BAR_Stn : ARRAY[1..6] OF T_SeqBar;
    fbStn1, fbStn2, fbStn3, fbStn4, fbStn5, fbStn6 : FB_PhFill;
    Stn_Perm : ARRAY[1..6] OF BOOL;          (* station start permissives *)
    Stn_IntlkOK : ARRAY[1..6] OF BOOL;       (* station interlocks healthy *)
    Stn_Vessel : ARRAY[1..6] OF BOOL;        (* cylinder connected, valve open *)
    Stn_Wt : ARRAY[1..6] OF REAL;            (* WT-1n1 net weight (kg) *)
    Stn_Stable : ARRAY[1..6] OF BOOL;        (* scale motion-free *)
    Stn_PT : ARRAY[1..6] OF REAL;            (* PT-1n1 station pressure (bar g) *)
    Stn_Vac : ARRAY[1..6] OF REAL;           (* PT-1n2 vacuum gauge (mbar abs) *)
    Stn_InletReq : ARRAY[1..6] OF BOOL;      (* -> XV-1n1 fill inlet *)
    Stn_RecoverReq : ARRAY[1..6] OF BOOL;    (* -> XV-1n2 to recovery header *)
    Stn_VacReq : ARRAY[1..6] OF BOOL;        (* -> XV-1n3 vacuum *)
    Stn_SampleReq : ARRAY[1..6] OF BOOL;     (* -> XV-1n4 sample *)
    Stn_TareReq : ARRAY[1..6] OF BOOL;       (* -> WT-1n1 tare *)
    Stn_FeedReq : ARRAY[1..6] OF BOOL;       (* station asks for feed *)
END_VAR

(* ---- 1. Inputs: map from the control modules, e.g. PCLib T_AI / T_DI ----
   Stn_Wt[1] := WT_111.Val_PV;    Stn_PT[1] := PT_111.Val_PV;    Stn_Vac[1] := PT_112.Val_PV;
   Src_Wt := WT_100.Val_PV;       Hdr_PT := PT_110.Val_PV;       Comp_Run := K_100.Sts_Running;
   Stn_IntlkOK[1] := ILK_111.Sts_OK;  (T_Intlk group: e.g. PT-111 HH, XV-1n3 not open with XV-1n1) *)

(* ---- 2. Feed phase: owned by the unit, started on demand, reset when complete ----
   The operator takes the feed for manual work with Cmd_TakeOwn; that also turns FeedAuto off. *)
IF FeedAuto AND (PH_Feed.Sts_Owner = 0) THEN
    IF xFeedOwned THEN
        FeedAuto := FALSE;                  (* operator took the phase *)
    ELSE
        PH_Feed.Prog_Acquire := TRUE;
    END_IF;
END_IF;
IF NOT FeedAuto AND (PH_Feed.Sts_Owner = 1) THEN
    PH_Feed.Prog_Release := TRUE;
END_IF;
xFeedOwned := PH_Feed.Sts_Owner = 1;

nFeedReq := 0;
FOR i := 1 TO 6 DO
    IF Stn_FeedReq[i] THEN
        nFeedReq := nFeedReq + 1;
    END_IF;
END_FOR;
IF PH_Feed.Sts_Owner = 1 THEN
    IF (PH_Feed.Sts_State = 0) AND (nFeedReq > 0) THEN
        PH_Feed.Prog_Cmd := 1;              (* Start *)
    ELSIF PH_Feed.Sts_State = 2 THEN
        PH_Feed.Prog_Cmd := 6;              (* Reset: ready for the next demand *)
    END_IF;
END_IF;

(* ---- 3. Phases ---- *)
fbFeed(PermOK := Feed_PermOK, IntlkOK := Feed_IntlkOK, IntlkAbort := FALSE, EStop := EStopAct,
       SrcWt := Src_Wt, SuctPT := Suct_PT, HdrPT := Hdr_PT, CompRdy := Comp_Rdy, CompRun := Comp_Run,
       FeedReqs := nFeedReq, Ph := PH_Feed, Bar := BAR_Feed,
       Out_SrcVlv => Src_VlvReq, Out_CompRun => Comp_RunReq, Out_CompLoad => Comp_LoadReq,
       Out_Recycle => Recycle_VlvReq);

fbStn1(PermOK := Stn_Perm[1], IntlkOK := Stn_IntlkOK[1], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[1], NetWt := Stn_Wt[1], WtStable := Stn_Stable[1],
       PT := Stn_PT[1], VacPT := Stn_Vac[1], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[1], Bar := BAR_Stn[1],
       Out_Inlet => Stn_InletReq[1], Out_Recover => Stn_RecoverReq[1], Out_Vac => Stn_VacReq[1],
       Out_Sample => Stn_SampleReq[1], Out_Tare => Stn_TareReq[1], FeedReq => Stn_FeedReq[1]);
fbStn2(PermOK := Stn_Perm[2], IntlkOK := Stn_IntlkOK[2], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[2], NetWt := Stn_Wt[2], WtStable := Stn_Stable[2],
       PT := Stn_PT[2], VacPT := Stn_Vac[2], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[2], Bar := BAR_Stn[2],
       Out_Inlet => Stn_InletReq[2], Out_Recover => Stn_RecoverReq[2], Out_Vac => Stn_VacReq[2],
       Out_Sample => Stn_SampleReq[2], Out_Tare => Stn_TareReq[2], FeedReq => Stn_FeedReq[2]);
fbStn3(PermOK := Stn_Perm[3], IntlkOK := Stn_IntlkOK[3], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[3], NetWt := Stn_Wt[3], WtStable := Stn_Stable[3],
       PT := Stn_PT[3], VacPT := Stn_Vac[3], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[3], Bar := BAR_Stn[3],
       Out_Inlet => Stn_InletReq[3], Out_Recover => Stn_RecoverReq[3], Out_Vac => Stn_VacReq[3],
       Out_Sample => Stn_SampleReq[3], Out_Tare => Stn_TareReq[3], FeedReq => Stn_FeedReq[3]);
fbStn4(PermOK := Stn_Perm[4], IntlkOK := Stn_IntlkOK[4], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[4], NetWt := Stn_Wt[4], WtStable := Stn_Stable[4],
       PT := Stn_PT[4], VacPT := Stn_Vac[4], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[4], Bar := BAR_Stn[4],
       Out_Inlet => Stn_InletReq[4], Out_Recover => Stn_RecoverReq[4], Out_Vac => Stn_VacReq[4],
       Out_Sample => Stn_SampleReq[4], Out_Tare => Stn_TareReq[4], FeedReq => Stn_FeedReq[4]);
fbStn5(PermOK := Stn_Perm[5], IntlkOK := Stn_IntlkOK[5], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[5], NetWt := Stn_Wt[5], WtStable := Stn_Stable[5],
       PT := Stn_PT[5], VacPT := Stn_Vac[5], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[5], Bar := BAR_Stn[5],
       Out_Inlet => Stn_InletReq[5], Out_Recover => Stn_RecoverReq[5], Out_Vac => Stn_VacReq[5],
       Out_Sample => Stn_SampleReq[5], Out_Tare => Stn_TareReq[5], FeedReq => Stn_FeedReq[5]);
fbStn6(PermOK := Stn_Perm[6], IntlkOK := Stn_IntlkOK[6], IntlkAbort := FALSE, EStop := EStopAct,
       VesselOK := Stn_Vessel[6], NetWt := Stn_Wt[6], WtStable := Stn_Stable[6],
       PT := Stn_PT[6], VacPT := Stn_Vac[6], FeedReady := fbFeed.FeedReady,
       Ph := PH_Stn[6], Bar := BAR_Stn[6],
       Out_Inlet => Stn_InletReq[6], Out_Recover => Stn_RecoverReq[6], Out_Vac => Stn_VacReq[6],
       Out_Sample => Stn_SampleReq[6], Out_Tare => Stn_TareReq[6], FeedReq => Stn_FeedReq[6]);

(* ---- 4. First scan: bar titles and phase IDs (after the DFBs have loaded their labels) ---- *)
IF xInit THEN
    BAR_Feed.Cfg_Title := 'Xenon feed';
    PH_Feed.Cfg_PhaseID := 100;
    FOR i := 1 TO 6 DO
        PH_Stn[i].Cfg_PhaseID := 100 + i;
    END_FOR;
    BAR_Stn[1].Cfg_Title := 'Station 1 fill';
    BAR_Stn[2].Cfg_Title := 'Station 2 fill';
    BAR_Stn[3].Cfg_Title := 'Station 3 fill';
    BAR_Stn[4].Cfg_Title := 'Station 4 fill';
    BAR_Stn[5].Cfg_Title := 'Station 5 fill';
    BAR_Stn[6].Cfg_Title := 'Station 6 fill';
    xInit := FALSE;
END_IF;

(* ---- 5. Requests to the control modules, e.g. PCLib T_DValve / T_Motor in Auto ----
   XV_111.Prog_Open := Stn_InletReq[1];      XV_100.Prog_Open := Src_VlvReq;
   K_100.Prog_Start := Comp_RunReq;          K_100.Prog_Stop := NOT Comp_RunReq;
   Valve-to-valve interlocks (never vacuum and inlet open together, never recovery
   and inlet) belong in the control modules' interlocks, not only in the sequence. *)
END_PROGRAM
