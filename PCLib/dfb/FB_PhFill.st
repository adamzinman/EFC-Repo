FUNCTION_BLOCK FB_PhFill
(* EXAMPLE phase: fill one xenon cylinder by weight - check, heel recovery, evacuation, leak check, tare, fast / slow fill, settle and top-up, optional sample. One instance per fill station *)
(* PCLib 1.00 - generated by gen_phase.py; edit the generator, not this file *)

VAR_INPUT
    PermOK : BOOL;                          (* Start permissives OK *)
    IntlkOK : BOOL;                         (* Interlocks healthy (FALSE while running -> Holding) *)
    IntlkAbort : BOOL;                      (* TRUE = interlock trip aborts instead of holding *)
    EStop : BOOL;                           (* Emergency stop active -> Aborting *)
    VesselOK : BOOL;                        (* Cylinder connected and its valve confirmed open *)
    NetWt : REAL;                           (* Scale net weight (kg) *)
    WtStable : BOOL;                        (* Scale motion-free *)
    PT : REAL;                              (* Station pressure (bar g) *)
    VacPT : REAL;                           (* Station vacuum gauge (mbar abs) *)
    FeedReady : BOOL;                       (* Fill header at pressure (FB_PhFeed.FeedReady) *)
END_VAR

VAR_IN_OUT
    Ph : T_Phase;                           (* Phase object *)
    Bar : T_SeqBar;                         (* Sequence bar for the HMI *)
END_VAR

VAR_OUTPUT
    Running : BOOL;                         (* Phase Running or Pausing *)
    Held : BOOL;                            (* Phase Held *)
    Complete : BOOL;                        (* Phase Complete *)
    Failed : BOOL;                          (* Phase failure active *)
    Out_Inlet : BOOL;                       (* Request: fill inlet valve open *)
    Out_Recover : BOOL;                     (* Request: recovery valve open (heel to recovery header) *)
    Out_Vac : BOOL;                         (* Request: vacuum valve open *)
    Out_Sample : BOOL;                      (* Request: sample valve open *)
    Out_Tare : BOOL;                        (* Request: tare the scale (pulse) *)
    FeedReq : BOOL;                         (* This station needs feed pressure *)
END_VAR

VAR
    xFirst : BOOL := TRUE;                  (* First scan: load sequence-bar labels *)
    fbCore : FB_PhaseCore;                  (* ISA-88 phase core *)
    xTrans : BOOL;                          (* Request: go to iNext *)
    iNext : INT;                            (* Request: next step *)
    xDone : BOOL;                           (* Request: current state logic finished *)
    iFail : INT;                            (* Request: failure code *)
    sFail : STRING[40];                     (* Request: failure text *)
    iSeg : INT;                             (* Sequence-bar segment of the active step *)
    sMsg : STRING[40];                      (* Operator message of the active step *)
    iPct : INT;                             (* Progress within the segment, 0..100 *)
    tStepMax : TIME;                        (* Watchdog for this step, T#0S = Ph.Cfg_StepTimeout *)
    xWdogOff : BOOL;                        (* No watchdog in this step *)
    xInlet : BOOL;                          (* Inlet request *)
    xRecover : BOOL;                        (* Recovery request *)
    xVac : BOOL;                            (* Vacuum request *)
    xSample : BOOL;                         (* Sample request *)
    xTare : BOOL;                           (* Tare request *)
    xFeedReq : BOOL;                        (* Feed request *)
    rTarget : REAL;                         (* Target net weight (kg) *)
    rPct : REAL;                            (* Fill progress (% of target) *)
    rVacRef : REAL;                         (* Vacuum at start of leak check (mbar abs) *)
    tHold : TIME;                           (* Leak check time *)
    iTopUp : INT;                           (* Top-ups done *)
    xTopUp : BOOL;                          (* Top-up requested by step 90 *)
    tPulseOn : TIME;                        (* Slow fill pulse on *)
    tPulseOff : TIME;                       (* Slow fill pulse off *)
    dCyc : DINT;                            (* Slow fill pulse cycle (ms) *)
    tonOk : TON;                            (* Condition-stable timer *)
END_VAR

(* ---- A. Sequence-bar labels (first scan, or after the T_SeqBar is re-initialised) ---- *)
IF xFirst OR (Bar.Cfg_NumSeg = 0) THEN
    Bar.Cfg_Title := 'Cylinder fill';
    Bar.Cfg_NumSeg := 6;
    Bar.Cfg_SegText[1] := 'Vessel';
    Bar.Cfg_SegText[2] := 'Vac';
    Bar.Cfg_SegText[3] := 'Prefill';
    Bar.Cfg_SegText[4] := 'Fill';
    Bar.Cfg_SegText[5] := 'Sample';
    Bar.Cfg_SegText[6] := 'Done';
    xFirst := FALSE;
END_IF;

(* ---- B. Requests to the core and equipment requests: cleared every scan, set by the active step ---- *)
xTrans := FALSE;
iNext := 0;
xDone := FALSE;
iFail := 0;
sFail := '';
sMsg := '';
iPct := 0;
tStepMax := T#0S;
xWdogOff := FALSE;
xInlet := FALSE;
xRecover := FALSE;
xVac := FALSE;
xSample := FALSE;
xTare := FALSE;
xFeedReq := FALSE;

(* =====================================================================
   C. SEQUENCE LOGIC - xenon cylinder fill by weight (one station)
   Parameters (Ph.Prm_Real):  1 target net weight (kg)   2 tolerance + (kg)
       3 tolerance - (kg)     4 fast -> slow change-over before target (kg)
       5 preact / in-flight (kg)   6 heel recovered down to (bar g)
       7 evacuation target (mbar abs)   8 leak check max rise (mbar)
       9 maximum cylinder fill pressure (bar g)
   Parameters (Ph.Prm_DInt):  1 sample required (0/1)   2 max top-ups
       3 leak check time (s)   4 settle time (s)   5 slow fill pulse on (ms)
       6 slow fill pulse off (ms)   7 sample fill time (s)
   Reports:  Rpt_Real 1 final net weight (kg)  2 final pressure (bar g)
             3 run time (s)  4 leak check rise (mbar);  Rpt_DInt 1 top-ups
   Xenon is never vented to atmosphere: the heel goes to the recovery header,
   and Hold / Stop / Abort isolate the cylinder.
   ===================================================================== *)
rTarget := Ph.Prm_Real[1];
IF rTarget > 0.0 THEN
    rPct := NetWt * 100.0 / rTarget;
ELSE
    rPct := 0.0;
END_IF;

CASE Ph.Sts_State OF

1, 3:   (* ---------- RUNNING / PAUSING: the procedure ---------- *)
    IF NOT Ph.Sts_WaitAdvance THEN                  (* Semi-automatic: the step waits for Advance *)
    CASE Ph.Sts_Step OF
    10: (* Check the recipe and the cylinder *)
        iSeg := 1;
        sMsg := 'Checking cylinder and recipe';
        iTopUp := 0;
        xTopUp := FALSE;
        tonOk(IN := VesselOK AND WtStable AND NOT fbCore.StepEntry, PT := T#3S);
        IF (rTarget <= 0.0) OR (Ph.Prm_Real[9] <= 0.0) OR (Ph.Prm_Real[5] < 0.0)
           OR (Ph.Prm_Real[4] < Ph.Prm_Real[5]) THEN
            iFail := 100;
            sFail := 'Invalid recipe parameters';
        ELSIF tonOk.Q THEN
            iNext := 20;
            xTrans := TRUE;
        END_IF;

    20: (* Recover the heel to the recovery header *)
        iSeg := 2;
        sMsg := 'Recovering heel';
        xRecover := TRUE;
        IF PT <= Ph.Prm_Real[6] THEN
            iNext := 30;
            xTrans := TRUE;
        END_IF;

    30: (* Evacuate *)
        iSeg := 2;
        sMsg := 'Evacuating cylinder';
        xVac := TRUE;
        IF VacPT <= Ph.Prm_Real[7] THEN
            iNext := 40;
            xTrans := TRUE;
        END_IF;

    40: (* Vacuum hold: leak check *)
        iSeg := 2;
        sMsg := 'Vacuum hold - leak check';
        IF fbCore.StepEntry THEN
            rVacRef := VacPT;
        END_IF;
        tHold := DINT_TO_TIME(Ph.Prm_DInt[3] * 1000);
        tStepMax := tHold + T#60S;
        Ph.Rpt_Real[4] := VacPT - rVacRef;
        IF fbCore.StepTime >= tHold THEN
            IF VacPT - rVacRef > Ph.Prm_Real[8] THEN
                iFail := 101;
                sFail := 'Leak check failed';
            ELSE
                iNext := 50;
                xTrans := TRUE;
            END_IF;
        END_IF;

    50: (* Tare the evacuated cylinder *)
        iSeg := 3;
        sMsg := 'Taring scale';
        xTare := fbCore.StepTime < T#1S;                (* 1 s tare pulse to the scale *)
        tonOk(IN := WtStable AND (fbCore.StepTime >= T#2S) AND NOT fbCore.StepEntry, PT := T#2S);
        IF tonOk.Q THEN
            iNext := 60;
            xTrans := TRUE;
        END_IF;

    60: (* Wait for feed pressure from the compressor *)
        iSeg := 3;
        sMsg := 'Waiting for feed pressure';
        xFeedReq := TRUE;
        xWdogOff := TRUE;                               (* may wait for other stations *)
        IF FeedReady THEN
            iNext := 70;
            xTrans := TRUE;
        END_IF;

    70: (* Fast fill *)
        iSeg := 4;
        sMsg := 'Fast fill';
        xFeedReq := TRUE;
        xInlet := FeedReady;                            (* inlet closes if feed pressure is lost *)
        iPct := REAL_TO_INT(LIMIT(0.0, rPct, 100.0));
        IF PT >= Ph.Prm_Real[9] THEN
            iFail := 102;
            sFail := 'Cylinder above max fill pressure';
        ELSIF NetWt >= rTarget - Ph.Prm_Real[4] THEN
            iNext := 80;
            xTrans := TRUE;
        END_IF;

    80: (* Slow fill: pulsed inlet *)
        iSeg := 4;
        sMsg := 'Slow fill';
        IF fbCore.StepEntry AND xTopUp THEN             (* entered from 90 for a top-up *)
            iTopUp := iTopUp + 1;
            xTopUp := FALSE;
        END_IF;
        xFeedReq := TRUE;
        tPulseOn := DINT_TO_TIME(Ph.Prm_DInt[5]);
        tPulseOff := DINT_TO_TIME(Ph.Prm_DInt[6]);
        dCyc := TIME_TO_DINT(tPulseOn + tPulseOff);
        IF (dCyc > 0) AND (tPulseOff > T#0S) THEN
            xInlet := FeedReady AND ((TIME_TO_DINT(fbCore.StepTime) MOD dCyc) < TIME_TO_DINT(tPulseOn));
        ELSE
            xInlet := FeedReady;
        END_IF;
        iPct := REAL_TO_INT(LIMIT(0.0, rPct, 100.0));
        IF PT >= Ph.Prm_Real[9] THEN
            iFail := 102;
            sFail := 'Cylinder above max fill pressure';
        ELSIF NetWt >= rTarget - Ph.Prm_Real[5] THEN
            iNext := 90;
            xTrans := TRUE;
        END_IF;

    90: (* Settle, then check the weight *)
        iSeg := 4;
        sMsg := 'Settling - checking weight';
        xFeedReq := TRUE;                               (* keep feed for a top-up *)
        iPct := REAL_TO_INT(LIMIT(0.0, rPct, 100.0));
        tonOk(IN := WtStable AND (fbCore.StepTime >= DINT_TO_TIME(Ph.Prm_DInt[4] * 1000))
                    AND NOT fbCore.StepEntry, PT := T#1S);
        IF tonOk.Q THEN
            IF NetWt > rTarget + Ph.Prm_Real[2] THEN
                iFail := 103;
                sFail := 'Overfill - above tolerance';
            ELSIF NetWt < rTarget - Ph.Prm_Real[3] THEN
                IF iTopUp < DINT_TO_INT(Ph.Prm_DInt[2]) THEN
                    xTopUp := TRUE;                     (* counted on entry to step 80 *)
                    iNext := 80;
                    xTrans := TRUE;
                ELSE
                    iFail := 104;
                    sFail := 'Under weight after max top-ups';
                END_IF;
            ELSE
                iNext := 100;
                xTrans := TRUE;
            END_IF;
        END_IF;

    100: (* Sample (optional) *)
        iSeg := 5;
        IF Ph.Prm_DInt[1] = 0 THEN
            Bar.Sts_Skip[5] := TRUE;
            sMsg := 'No sample required';
            iNext := 110;
            xTrans := TRUE;
        ELSE
            sMsg := 'Filling sample cylinder';
            xSample := TRUE;
            IF fbCore.StepTime >= DINT_TO_TIME(Ph.Prm_DInt[7] * 1000) THEN
                iNext := 110;
                xTrans := TRUE;
            END_IF;
        END_IF;

    110: (* Fill complete: reports *)
        iSeg := 6;
        sMsg := 'Fill complete';
        Ph.Rpt_Real[1] := NetWt;
        Ph.Rpt_Real[2] := PT;
        Ph.Rpt_Real[3] := DINT_TO_REAL(TIME_TO_DINT(Ph.Val_RunTime)) / 1000.0;
        Ph.Rpt_DInt[1] := INT_TO_DINT(iTopUp);
        xDone := TRUE;
    END_CASE;
    END_IF;

5:  (* ---------- HOLDING: all station valves closed, feed released (section B) ---------- *)
    xDone := TRUE;

7:  (* ---------- RESTARTING: re-establish feed before resuming a fill step ---------- *)
    IF (fbCore.RunStep >= 60) AND (fbCore.RunStep <= 90) THEN
        xFeedReq := TRUE;
        IF FeedReady THEN
            xDone := TRUE;
        END_IF;
    ELSE
        xDone := TRUE;
    END_IF;

8:  (* ---------- STOPPING: isolate the cylinder ---------- *)
    xDone := TRUE;

10: (* ---------- ABORTING: isolate the cylinder ---------- *)
    xDone := TRUE;

END_CASE;

(* ---- D. Core: ISA-88 states, commands, modes, ownership, watchdog, alarms, sequence bar ---- *)
fbCore(PermOK := PermOK, IntlkOK := IntlkOK, IntlkAbort := IntlkAbort, EStop := EStop,
       Trans := xTrans, NextStep := iNext, StateDone := xDone,
       FailCode := iFail, FailText := sFail,
       Seg := iSeg, Msg := sMsg, Pct := iPct,
       StepTmo := tStepMax, WdogOff := xWdogOff,
       Ph := Ph, Bar := Bar);

(* ---- E. Outputs ---- *)
Running := fbCore.Running;
Held := fbCore.Held;
Complete := fbCore.Complete;
Failed := fbCore.Failed;
Out_Inlet := xInlet;
Out_Recover := xRecover;
Out_Vac := xVac;
Out_Sample := xSample;
Out_Tare := xTare;
FeedReq := xFeedReq;

END_FUNCTION_BLOCK
