FUNCTION_BLOCK FB_PhFeed
(* EXAMPLE phase: xenon feed - large source cylinder and diaphragm compressor pressurise the fill header and hold it at setpoint while stations request feed *)
(* PCLib 1.00 - generated by gen_phase.py; edit the generator, not this file *)

VAR_INPUT
    PermOK : BOOL;                          (* Start permissives OK *)
    IntlkOK : BOOL;                         (* Interlocks healthy (FALSE while running -> Holding) *)
    IntlkAbort : BOOL;                      (* TRUE = interlock trip aborts instead of holding *)
    EStop : BOOL;                           (* Emergency stop active -> Aborting *)
    SrcWt : REAL;                           (* Source cylinder net weight (kg) *)
    SuctPT : REAL;                          (* Compressor suction pressure (bar g) *)
    HdrPT : REAL;                           (* Fill header pressure (bar g) *)
    CompRdy : BOOL;                         (* Compressor ready to start (no trip, in Auto) *)
    CompRun : BOOL;                         (* Compressor running feedback *)
    FeedReqs : INT;                         (* Number of stations requesting feed *)
END_VAR

VAR_IN_OUT
    Ph : T_Phase;                           (* Phase object *)
    Bar : T_SeqBar;                         (* Sequence bar for the HMI *)
END_VAR

VAR_OUTPUT
    Running : BOOL;                         (* Phase Running or Pausing *)
    Held : BOOL;                            (* Phase Held *)
    Complete : BOOL;                        (* Phase Complete *)
    Failed : BOOL;                          (* Phase failure active *)
    Out_SrcVlv : BOOL;                      (* Request: source cylinder valve open *)
    Out_CompRun : BOOL;                     (* Request: compressor run *)
    Out_CompLoad : BOOL;                    (* Request: compressor loaded *)
    Out_Recycle : BOOL;                     (* Request: recycle / bypass valve open *)
    FeedReady : BOOL;                       (* Fill header at pressure: stations may fill *)
END_VAR

VAR
    xFirst : BOOL := TRUE;                  (* First scan: load sequence-bar labels *)
    fbCore : FB_PhaseCore;                  (* ISA-88 phase core *)
    xTrans : BOOL;                          (* Request: go to iNext *)
    iNext : INT;                            (* Request: next step *)
    xDone : BOOL;                           (* Request: current state logic finished *)
    iFail : INT;                            (* Request: failure code *)
    sFail : STRING[40];                     (* Request: failure text *)
    iSeg : INT;                             (* Sequence-bar segment of the active step *)
    sMsg : STRING[40];                      (* Operator message of the active step *)
    iPct : INT;                             (* Progress within the segment, 0..100 *)
    tStepMax : TIME;                        (* Watchdog for this step, T#0S = Ph.Cfg_StepTimeout *)
    xWdogOff : BOOL;                        (* No watchdog in this step *)
    xSrc : BOOL;                            (* Source valve request *)
    xRun : BOOL;                            (* Compressor run request *)
    xLoad : BOOL;                           (* Compressor load request *)
    xRecyc : BOOL;                          (* Recycle valve request *)
    xReady : BOOL;                          (* Header ready *)
    xLoadMem : BOOL;                        (* Load / unload hysteresis memory *)
    rSP : REAL;                             (* Header pressure setpoint (bar g) *)
    rBand : REAL;                           (* Load band (bar) *)
    tonOk : TON;                            (* Condition-stable timer *)
    tonIdle : TON;                          (* No-demand timer *)
END_VAR

(* ---- A. Sequence-bar labels (first scan, or after the T_SeqBar is re-initialised) ---- *)
IF xFirst OR (Bar.Cfg_NumSeg = 0) THEN
    Bar.Cfg_Title := 'Xenon feed';
    Bar.Cfg_NumSeg := 6;
    Bar.Cfg_SegText[1] := 'Lineup';
    Bar.Cfg_SegText[2] := 'Source';
    Bar.Cfg_SegText[3] := 'Start';
    Bar.Cfg_SegText[4] := 'Pressurise';
    Bar.Cfg_SegText[5] := 'Supply';
    Bar.Cfg_SegText[6] := 'Done';
    xFirst := FALSE;
END_IF;

(* ---- B. Requests to the core and equipment requests: cleared every scan, set by the active step ---- *)
xTrans := FALSE;
iNext := 0;
xDone := FALSE;
iFail := 0;
sFail := '';
sMsg := '';
iPct := 0;
tStepMax := T#0S;
xWdogOff := FALSE;
xSrc := FALSE;
xRun := FALSE;
xLoad := FALSE;
xRecyc := FALSE;
xReady := FALSE;

(* =====================================================================
   C. SEQUENCE LOGIC - xenon feed: large source cylinder -> diaphragm
   compressor -> fill header for the six stations
   Parameters (Ph.Prm_Real):  1 header pressure setpoint (bar g)
       2 load band below setpoint (bar)   3 header maximum, unload above (bar g)
       4 minimum suction pressure (bar g)  5 source cylinder minimum heel (kg)
   Parameters (Ph.Prm_DInt):  1 idle time with no requests before shutdown (s)
       2 unloaded cool-down before stop (s)
   Reports:  Rpt_Real 1 source weight at start (kg)  2 source weight at end (kg)
             3 xenon delivered (kg)  4 run time (s)
   ===================================================================== *)
rSP := Ph.Prm_Real[1];
rBand := Ph.Prm_Real[2];

CASE Ph.Sts_State OF

1, 3:   (* ---------- RUNNING / PAUSING: the procedure ---------- *)
    IF NOT Ph.Sts_WaitAdvance THEN                  (* Semi-automatic: the step waits for Advance *)
    CASE Ph.Sts_Step OF
    10: (* Line-up check *)
        iSeg := 1;
        sMsg := 'Checking line-up';
        IF (rSP <= 0.0) OR (rBand <= 0.0) OR (Ph.Prm_Real[3] <= rSP) THEN
            iFail := 200;
            sFail := 'Invalid recipe parameters';
        ELSIF SrcWt <= Ph.Prm_Real[5] THEN
            iFail := 201;
            sFail := 'Source cylinder at minimum heel';
        ELSIF CompRdy THEN
            Ph.Rpt_Real[1] := SrcWt;                    (* source weight at start *)
            iNext := 20;
            xTrans := TRUE;
        END_IF;

    20: (* Open the source cylinder *)
        iSeg := 2;
        sMsg := 'Opening source cylinder';
        xSrc := TRUE;
        tonOk(IN := (SuctPT >= Ph.Prm_Real[4]) AND NOT fbCore.StepEntry, PT := T#2S);
        IF tonOk.Q THEN
            iNext := 30;
            xTrans := TRUE;
        END_IF;

    30: (* Start the compressor unloaded *)
        iSeg := 3;
        sMsg := 'Starting compressor';
        xSrc := TRUE;
        xRun := TRUE;
        xRecyc := TRUE;
        tonOk(IN := CompRun AND NOT fbCore.StepEntry, PT := T#5S);
        IF tonOk.Q THEN
            iNext := 40;
            xTrans := TRUE;
        END_IF;

    40: (* Pressurise the fill header *)
        iSeg := 4;
        sMsg := 'Pressurising fill header';
        xSrc := TRUE;
        xRun := TRUE;
        xLoad := HdrPT < Ph.Prm_Real[3];
        xRecyc := NOT xLoad;
        iPct := REAL_TO_INT(LIMIT(0.0, HdrPT * 100.0 / rSP, 100.0));
        IF NOT CompRun THEN
            iFail := 202;
            sFail := 'Compressor stopped';
        ELSIF HdrPT >= rSP THEN
            iNext := 50;
            xTrans := TRUE;
        END_IF;

    50: (* Supply: hold header pressure while stations request feed *)
        iSeg := 5;
        xWdogOff := TRUE;                               (* runs as long as there is demand *)
        xSrc := TRUE;
        xRun := TRUE;
        IF HdrPT >= rSP THEN
            xLoadMem := FALSE;
        ELSIF HdrPT <= rSP - rBand THEN
            xLoadMem := TRUE;
        END_IF;
        xLoad := xLoadMem AND (HdrPT < Ph.Prm_Real[3]);
        xRecyc := NOT xLoad;
        xReady := HdrPT >= rSP - rBand;
        IF FeedReqs > 0 THEN
            sMsg := 'Supplying stations';
        ELSE
            sMsg := 'Supply - no requests';
        END_IF;
        tonIdle(IN := (FeedReqs <= 0) AND NOT fbCore.StepEntry, PT := DINT_TO_TIME(Ph.Prm_DInt[1] * 1000));
        IF NOT CompRun THEN
            iFail := 202;
            sFail := 'Compressor stopped';
        ELSIF SrcWt <= Ph.Prm_Real[5] THEN
            iFail := 201;
            sFail := 'Source cylinder at minimum heel';
        ELSIF tonIdle.Q THEN
            iNext := 60;
            xTrans := TRUE;
        END_IF;

    60: (* Shut down: cool down unloaded, then stop *)
        iSeg := 6;
        sMsg := 'Compressor cool-down';
        xRun := fbCore.StepTime < DINT_TO_TIME(Ph.Prm_DInt[2] * 1000);
        xRecyc := xRun;
        IF NOT xRun AND NOT CompRun THEN
            Ph.Rpt_Real[2] := SrcWt;
            Ph.Rpt_Real[3] := Ph.Rpt_Real[1] - SrcWt;
            Ph.Rpt_Real[4] := DINT_TO_REAL(TIME_TO_DINT(Ph.Val_RunTime)) / 1000.0;
            xDone := TRUE;
        END_IF;
    END_CASE;
    END_IF;

4:  (* ---------- PAUSED: keep the compressor running unloaded; stations do not fill ---------- *)
    xSrc := CompRun;
    xRun := CompRun;
    xRecyc := CompRun;

5:  (* ---------- HOLDING: stop the compressor, isolate the source (section B) ---------- *)
    xDone := NOT CompRun;

7:  (* ---------- RESTARTING: open the source and start unloaded, then resume ---------- *)
    CASE Ph.Sts_Step OF
    10: xSrc := TRUE;
        tonOk(IN := (SuctPT >= Ph.Prm_Real[4]) AND NOT fbCore.StepEntry, PT := T#2S);
        IF tonOk.Q THEN
            iNext := 20;
            xTrans := TRUE;
        END_IF;
    20: xSrc := TRUE;
        xRun := TRUE;
        xRecyc := TRUE;
        tonOk(IN := CompRun AND NOT fbCore.StepEntry, PT := T#5S);
        IF tonOk.Q THEN
            xDone := TRUE;
        END_IF;
    END_CASE;

8:  (* ---------- STOPPING: stop the compressor, isolate the source ---------- *)
    xDone := NOT CompRun;

10: (* ---------- ABORTING: everything off at once ---------- *)
    xDone := TRUE;

END_CASE;

(* ---- D. Core: ISA-88 states, commands, modes, ownership, watchdog, alarms, sequence bar ---- *)
fbCore(PermOK := PermOK, IntlkOK := IntlkOK, IntlkAbort := IntlkAbort, EStop := EStop,
       Trans := xTrans, NextStep := iNext, StateDone := xDone,
       FailCode := iFail, FailText := sFail,
       Seg := iSeg, Msg := sMsg, Pct := iPct,
       StepTmo := tStepMax, WdogOff := xWdogOff,
       Ph := Ph, Bar := Bar);

(* ---- E. Outputs ---- *)
Running := fbCore.Running;
Held := fbCore.Held;
Complete := fbCore.Complete;
Failed := fbCore.Failed;
Out_SrcVlv := xSrc;
Out_CompRun := xRun;
Out_CompLoad := xLoad;
Out_Recycle := xRecyc;
FeedReady := xReady AND fbCore.Running;

END_FUNCTION_BLOCK
