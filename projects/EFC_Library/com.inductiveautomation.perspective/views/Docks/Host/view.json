{
  "custom": {
    "default": {
      "path": "",
      "params": {}
    },
    "show": {
      "path": "",
      "params": {}
    },
    "viewportH": 0
  },
  "params": {
    "path": "",
    "tagPath": "",
    "model": "",
    "defaultPath": "",
    "defaultParams": {}
  },
  "propConfig": {
    "params.path": {
      "paramDirection": "input",
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tefc.ui.dockSync(self)"
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tefc.ui.dockSync(self)"
      }
    },
    "params.model": {
      "paramDirection": "input",
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tefc.ui.dockSync(self)"
      }
    },
    "params.defaultPath": {
      "paramDirection": "input",
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tefc.ui.dockSync(self)"
      }
    },
    "params.defaultParams": {
      "paramDirection": "input",
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tefc.ui.dockSync(self)"
      }
    },
    "custom.viewportH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{page.props.dimensions.viewport.height}"
        }
      },
      "onChange": {
        "enabled": true,
        "script": "\tefc.ui.sizeDock(self.view)"
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 860
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Panel"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "version": 0,
        "meta": {
          "name": "Window"
        },
        "position": {
          "shrink": 0,
          "grow": 1,
          "basis": "0px"
        },
        "props": {
          "path": "",
          "params": {},
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.show.path"
              }
            }
          },
          "props.params": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.show.params"
              }
            }
          }
        }
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tefc.ui.dockSync(self.view)\n\tefc.ui.sizeDock(self.view)"
          }
        }
      }
    }
  }
}
