{
  "custom": {
    "dw": {
      "path": "",
      "params": {}
    }
  },
  "params": {
    "defaultDock": "",
    "defaultParams": {}
  },
  "propConfig": {
    "custom.dw": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.custom.efcDw"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.region(value, self.page.props.pageId)"
          }
        ]
      }
    },
    "params.defaultDock": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.defaultParams": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 860
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Panel"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "version": 0,
        "meta": {
          "name": "Window"
        },
        "position": {
          "shrink": 0,
          "grow": 1,
          "basis": "0px"
        },
        "props": {
          "path": "",
          "params": {},
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.dw"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn (value or {}).get('path') or ''"
                }
              ]
            }
          },
          "props.params": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.dw"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn dict((value or {}).get('params') or {})"
                }
              ]
            }
          }
        }
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tefc.ui.setDefaultDock(self, self.view.params.defaultDock, self.view.params.defaultParams)"
          }
        }
      }
    }
  }
}
