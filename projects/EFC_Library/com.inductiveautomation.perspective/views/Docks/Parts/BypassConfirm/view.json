{
  "custom": {
    "level": 0,
    "reason": ""
  },
  "params": {
    "tagPath": "",
    "idx": 0,
    "desc": ""
  },
  "propConfig": {
    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.user.roles"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.idx": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 360,
      "height": 260
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Popup",
        "gap": "0.741vh"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "Bypass condition",
          "style": {
            "classes": "Text/Title"
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Desc"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/Body"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.desc}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Note"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "Supervisor or higher. The reason and your user name go to the audit log; the bypass times out at the block's Cfg_BypassMax.",
          "style": {
            "classes": "Text/Caption Text/Mod/Wrap"
          }
        }
      },
      {
        "type": "ia.input.text-field",
        "version": 0,
        "meta": {
          "name": "Reason"
        },
        "position": {
          "shrink": 0,
          "basis": "2.963vh"
        },
        "props": {
          "placeholder": "Reason (required)",
          "style": {
            "classes": "Input/Field"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.reason",
                "bidirectional": true
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "shrink": 0,
          "grow": 0,
          "basis": "3.333vh"
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "classes": "",
            "gap": "0.556vh"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Cancel"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "CANCEL",
              "style": {
                "classes": "Button/Default"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup('efcBypass')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Ok"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "BYPASS",
              "style": {
                "classes": "Button/Danger"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.level} >= 3 && len(trim({view.custom.reason})) > 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif efc.ui.bypass(self, self.view.params.tagPath, self.view.params.idx, self.view.custom.reason):\n\t\tsystem.perspective.closePopup('efcBypass')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
