        },
        "props": {
          "text": "P",
          "style": {
            "classes": "Indicator/PermissiveBadge"
          }
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({view.custom.permMissing}, false)"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "I",
          "tooltip": {
            "enabled": true,
            "text": "Interlock active - start/open blocked"
          }
        },
        "position": {
          "x": 0.8333,
          "y": 0.1897,
          "width": 0.1167,
          "height": 0.1207
        },
        "props": {
          "text": "I",
          "style": {
            "classes": "Indicator/InterlockBadge"
          }
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "type": "expr",
