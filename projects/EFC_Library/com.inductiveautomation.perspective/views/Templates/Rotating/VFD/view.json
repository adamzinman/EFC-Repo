              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "P",
          "tooltip": {
            "enabled": true,
            "text": "Permissive missing - start/open blocked"
          }
        },
        "position": {
          "x": 0.05,
          "y": 0.1897,
          "width": 0.1167,
