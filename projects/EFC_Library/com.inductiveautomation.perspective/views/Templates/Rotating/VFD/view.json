{
  "custom": {
    "cmd": false,
    "on": false,
    "off": true,
    "fault": false,
    "trip": false,
    "state": 0,
    "command": -1,
    "name": "",
    "desc": "",
    "man": false,
    "oos": false,
    "avail": true,
    "local": false,
    "intlk": false,
    "permMissing": false,
    "firstOut": -1,
    "firstDesc": "",
    "mode": 0,
    "alarm": 0,
    "fill": "#9E9E9E",
    "head": "#9E9E9E",
    "line": "#262626",
    "lw": 3.75,
    "con": "#262626",
    "spd": 0.0,
    "spdEU": "",
    "canCmd": false
  },
  "params": {
    "tagPath": "[default]PID_Demo/M601",
    "useButton": true,
    "tType": "T_VFD",
    "dockId": "",
    "dwTagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.useButton": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.cmd": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Out_Run"
        }
      }
    },
    "custom.on": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Running"
        }
      }
    },
    "custom.off": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Stopped"
        }
      }
    },
    "custom.fault": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Fault"
        }
      }
    },
    "custom.trip": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Tripped"
        }
      }
    },
    "custom.state": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.custom.fault}, false) || coalesce({view.custom.trip}, false), 3, if(coalesce({view.custom.on}, false), 1, if(coalesce({view.custom.off}, false), 0, 2)))"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Cfg_Tag"
        }
      }
    },
    "custom.desc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Cfg_Desc"
        }
      }
    },
    "custom.man": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Mode/Sts_Man"
        }
      }
    },
    "custom.oos": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Mode/Sts_OOS"
        }
      }
    },
    "custom.intlk": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Intlk"
        }
      }
    },
    "custom.firstOut": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Intlk/Sts_FirstOut"
        }
      }
    },
    "custom.firstDesc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}",
            "1": "{view.custom.firstOut}"
          },
          "tagPath": "{0}/Intlk/Cfg_CondDesc/{1}"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.custom.man}, false), 1, 0)"
        }
      }
    },
    "custom.avail": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Avail"
        }
      }
    },
    "custom.local": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_Local"
        }
      }
    },
    "custom.permMissing": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Sts_NotPerm"
        }
      }
    },
    "custom.alarm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 4, 4, 0, 1, 0), false), false)), 4, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 3, 3, 0, 1, 0), false), false)), 3, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 2, 2, 0, 1, 0), false), false)), 2, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 1, 1, 0, 1, 0), false), false)), 1, 0))))"
        }
      }
    },
    "custom.fill": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.state}, 0, \"#9E9E9E\", 1, \"#FFFFFF\", 2, \"#C4C4C4\", 3, \"#3A3A3A\", \"#C4C4C4\")"
        }
      }
    },
    "custom.head": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.command} < 0, {view.custom.fill}, if({view.custom.command} = 1, \"#FFFFFF\", \"#9E9E9E\"))"
        }
      }
    },
    "custom.line": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.state} = 3, \"#D50000\", case({view.custom.alarm}, 1, \"#00A3E0\", 2, \"#FFD200\", 3, \"#FF7A00\", 4, \"#D50000\", \"#262626\"))"
        }
      }
    },
    "custom.con": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.state} = 3, \"#F2F2F2\", \"#262626\")"
        }
      }
    },
    "custom.lw": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.alarm} > 0 || {view.custom.state} = 3, 7.5, 3.75)"
        }
      }
    },
    "custom.spd": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Val_Spd"
        }
      }
    },
    "custom.spdEU": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Cfg_SpdEU"
        }
      }
    },
    "custom.canCmd": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.man}, false) && coalesce({view.custom.avail}, true) && !coalesce({view.custom.local}, false) && !coalesce({view.custom.oos}, false) && (coalesce({view.custom.cmd}, false) || (!coalesce({view.custom.permMissing}, false) && !coalesce({view.custom.intlk}, false)))"
        }
      }
    },
    "params.tType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dockId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dwTagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 120,
      "height": 116
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Tag",
          "tooltip": {
            "enabled": false,
            "text": ""
          }
        },
        "position": {
          "x": 0.0,
          "y": 0.0086,
          "width": 1.0,
          "height": 0.1293
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/TagName Text/Mod/Center Text/Mod/NoWrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len(coalesce({view.custom.name}, \"\")) > 0, {view.custom.name}, substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1))"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({view.custom.desc}, \"\")"
              }
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len(coalesce({view.custom.desc}, \"\")) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.shapes.svg",
        "version": 0,
        "meta": {
          "name": "Symbol",
          "tooltip": {
            "enabled": true,
            "text": "Open dynamic window"
          }
        },
        "position": {
          "x": 0.225,
          "y": 0.1552,
          "width": 0.55,
          "height": 0.569
        },
        "props": {
          "viewBox": "0 0 100 100",
          "preserveAspectRatio": "xMidYMid",
          "elements": [
            {
              "type": "circle",
