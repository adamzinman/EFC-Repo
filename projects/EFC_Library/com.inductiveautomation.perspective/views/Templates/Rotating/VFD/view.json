              "d": "M39.5,58 L39.5,30 L50,46.8 L60.5,30 L60.5,58",
              "fill": {
                "paint": "transparent"
              },
              "stroke": {
                "paint": "#262626",
                "width": 3.75,
                "linejoin": "round"
              }
            },
            {
              "type": "path",
              "name": "cstroke2",
              "d": "M34,70 Q42,62 50,70 T66,70",
              "fill": {
                "paint": "transparent"
              },
              "stroke": {
                "paint": "#262626",
                "width": 3.75,
                "linejoin": "round"
              }
            }
          ],
          "style": {
            "classes": "Util/Pointer"
          }
        },
        "propConfig": {
          "props.elements[0].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.fill}"
              }
            }
          },
          "props.elements[0].stroke.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.line}"
              }
            }
          },
          "props.elements[0].stroke.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.lw}"
              }
            }
          },
          "props.elements[1].stroke.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.con}"
              }
            }
          },
          "props.elements[2].stroke.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.con}"
              }
            }
          }
        },
