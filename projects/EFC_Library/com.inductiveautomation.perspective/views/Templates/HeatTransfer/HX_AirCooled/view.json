{
  "custom": {
    "cmd": false,
    "run": false,
    "fb": true,
    "fault": false,
    "state": 0,
    "command": -1,
    "name": "",
    "desc": "",
    "man": false,
    "auto": false,
    "oos": false,
    "locked": false,
    "intlk": false,
    "permMissing": false,
    "avail": true,
    "mode": 0,
    "manPerm": true,
    "autoPerm": true,
    "canCmd": false,
    "alarm": 0,
    "fill": "#9E9E9E",
    "head": "#9E9E9E",
    "line": "#262626",
    "lw": 2.5,
    "con": "#262626"
  },
  "params": {
    "tagPath": "[default]PID_Demo/P101",
    "useButton": true,
    "tType": "DDT_Device",
    "dockId": "",
    "dwTagPath": "",
    "dblCmd": true
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.useButton": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.cmd": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/CMD"
        }
      }
    },
    "custom.run": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/YI"
        }
      }
    },
    "custom.fb": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/FB_Enb"
        }
      }
    },
    "custom.fault": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Alarm"
        }
      }
    },
    "custom.state": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.custom.fault}, false), 3, if(!coalesce({view.custom.fb}, true), if(coalesce({view.custom.cmd}, false), 1, 0), if(coalesce({view.custom.run}, false) && coalesce({view.custom.cmd}, false), 1, if(!coalesce({view.custom.run}, false) && !coalesce({view.custom.cmd}, false), 0, 2))))"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Name"
        }
      }
    },
    "custom.desc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Description"
        }
      }
    },
    "custom.man": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Manual"
        }
      }
    },
    "custom.auto": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Auto"
        }
      }
    },
    "custom.oos": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Off"
        }
      }
    },
    "custom.locked": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/LockedOut"
        }
      }
    },
    "custom.intlk": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Interlock"
        }
      }
    },
    "custom.avail": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!coalesce({view.custom.locked}, false)"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.custom.man}, false), 1, 0)"
        }
      }
    },
    "custom.manPerm": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Man_Perm"
        }
      }
    },
    "custom.autoPerm": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "fallbackDelay": 2.5,
          "references": {
            "0": "{view.params.tagPath}"
          },
          "tagPath": "{0}/Auto_Perm"
        }
      }
    },
    "custom.permMissing": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!if(coalesce({view.custom.man}, false), coalesce({view.custom.manPerm}, true), coalesce({view.custom.autoPerm}, true))"
        }
      }
    },
    "custom.canCmd": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.man}, false) && !coalesce({view.custom.locked}, false) && !coalesce({view.custom.oos}, false) && (coalesce({view.custom.cmd}, false) || (!coalesce({view.custom.permMissing}, false) && !coalesce({view.custom.intlk}, false)))"
        }
      }
    },
    "custom.alarm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 4, 4, 0, 1, 0), false), false)), 4, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 3, 3, 0, 1, 0), false), false)), 3, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 2, 2, 0, 1, 0), false), false)), 2, if(forceQuality(coalesce(try(isAlarmActiveFiltered({view.params.tagPath} + \"/*\", \"*\", \"*\", 1, 1, 0, 1, 0), false), false)), 1, 0))))"
        }
      }
    },
    "custom.fill": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.state}, 0, \"#9E9E9E\", 1, \"#FFFFFF\", 2, \"#C4C4C4\", 3, \"#3A3A3A\", \"#C4C4C4\")"
        }
      }
    },
    "custom.head": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.command} < 0, {view.custom.fill}, if({view.custom.command} = 1, \"#FFFFFF\", \"#9E9E9E\"))"
        }
      }
    },
    "custom.line": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.state} = 3, \"#D50000\", case({view.custom.alarm}, 1, \"#00A3E0\", 2, \"#FFD200\", 3, \"#FF7A00\", 4, \"#D50000\", \"#262626\"))"
        }
      }
    },
    "custom.con": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.state} = 3, \"#F2F2F2\", \"#262626\")"
        }
      }
    },
    "custom.lw": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.alarm} > 0 || {view.custom.state} = 3, 5.0, 2.5)"
        }
      }
    },
    "params.tType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dockId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dwTagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dblCmd": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 120,
      "height": 116
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "children": [
