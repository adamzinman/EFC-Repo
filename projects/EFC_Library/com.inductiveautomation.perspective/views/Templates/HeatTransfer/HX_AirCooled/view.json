              "config": {
                "expression": "coalesce({view.custom.intlk}, false)"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "StatusGroup"
        },
        "position": {
          "x": 0.1417,
          "y": 0.7759,
          "width": 0.7167,
          "height": 0.1552
        },
        "props": {
          "direction": "row",
          "justify": "center",
          "alignItems": "stretch",
          "style": {
            "classes": ""
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "M"
            },
            "position": {
              "basis": "auto",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "text": "M",
              "style": {
                "classes": "Util/Collapsed"
              }
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "!{view.params.useButton} && coalesce({view.custom.man}, false)"
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(!{view.params.useButton} && coalesce({view.custom.man}, false), \"Mode/ManualSplit\", \"Util/Collapsed\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "Status"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "State/Stopped"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.state}, 0, \"STOPPED\", 1, \"RUNNING\", 2, if(coalesce({view.custom.cmd}, false), \"STARTING\", \"STOPPING\"), 3, \"FAULT\", \"???\")"
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.state}, 0, \"State/Stopped\", 1, \"State/Running\", 2, \"State/Transition\", 3, \"State/Fault\", \"State/Unknown\") + if(!{view.params.useButton} && coalesce({view.custom.man}, false), \" Mode/ManualJoined\", \"\")"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.input.button",
        "version": 0,
        "meta": {
          "name": "PB",
          "tooltip": {
            "enabled": true,
            "text": "Start"
          }
        },
        "position": {
          "x": 0.0167,
          "y": 0.7759,
          "width": 0.15,
          "height": 0.1552
        },
        "props": {
          "text": "",
          "enabled": false,
          "style": {
            "classes": "Button/Command"
          }
        },
