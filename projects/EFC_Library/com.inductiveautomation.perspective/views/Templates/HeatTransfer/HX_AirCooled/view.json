          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.useButton} && coalesce({view.custom.man}, false)"
              }
            }
          },
          "props.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.canCmd}"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.custom.locked}, false), \"Locked out\", if(!coalesce({view.custom.man}, false), \"Manual mode required\", if(coalesce({view.custom.cmd}, false), \"Stop\", \"Start\")))"
              }
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tefc.ui.cmd(self, 'HMI_CMD', not bool(self.view.custom.cmd), 1)"
              }
            }
          }
        }
      }
