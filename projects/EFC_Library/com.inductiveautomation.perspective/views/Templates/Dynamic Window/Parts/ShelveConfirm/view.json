{
  "custom": {
    "level": 0,
    "reason": "",
    "minutes": 60
  },
  "params": {
    "tagPath": "",
    "member": "",
    "desc": ""
  },
  "propConfig": {
    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.securityLevels"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.member": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 360,
      "height": 300
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Popup Util/Gap/L"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "Shelve alarm",
          "style": {
            "classes": "Text/Title"
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Desc"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/Body"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.desc}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Note"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "Supervisor or higher. Hides this alarm in Ignition (alarm table, journal, template outline) for the chosen time. The PLC alarm stays active. The reason and your user name go to the audit log.",
          "style": {
            "classes": "Text/Caption Text/Mod/Wrap"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Presets"
        },
        "position": {
          "shrink": 0,
          "grow": 0,
          "basis": "2.963vh"
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "classes": "Util/Gap/S"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "P15"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "15 min",
              "style": {
                "classes": "Button/Toggle/Off"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.minutes = 15"
                  }
                }
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "try(if({view.custom.minutes} = 15, 'Button/Toggle/On', 'Button/Toggle/Off'), 'Button/Toggle/Off')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "P60"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "1 h",
              "style": {
                "classes": "Button/Toggle/Off"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.minutes = 60"
                  }
                }
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "try(if({view.custom.minutes} = 60, 'Button/Toggle/On', 'Button/Toggle/Off'), 'Button/Toggle/Off')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "P240"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "4 h",
              "style": {
                "classes": "Button/Toggle/Off"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.minutes = 240"
                  }
                }
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "try(if({view.custom.minutes} = 240, 'Button/Toggle/On', 'Button/Toggle/Off'), 'Button/Toggle/Off')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "P480"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "8 h",
              "style": {
                "classes": "Button/Toggle/Off"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.minutes = 480"
                  }
                }
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "try(if({view.custom.minutes} = 480, 'Button/Toggle/On', 'Button/Toggle/Off'), 'Button/Toggle/Off')"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.input.text-field",
        "version": 0,
        "meta": {
          "name": "Reason"
        },
        "position": {
          "shrink": 0,
          "basis": "2.963vh"
        },
        "props": {
          "placeholder": "Reason (required)",
          "style": {
            "classes": "Input/Field"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.reason",
                "bidirectional": true
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "shrink": 0,
          "grow": 0,
          "basis": "3.333vh"
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "classes": "Util/Gap/M"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Cancel"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "CANCEL",
              "style": {
                "classes": "Button/Default"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup('efcShelve')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Ok"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "SHELVE",
              "style": {
                "classes": "Button/Danger"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.level} >= 3 && len(trim({view.custom.reason})) > 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif efc.ui.shelve(self, self.view.params.member, self.view.custom.minutes, self.view.custom.reason):\n\t\tsystem.perspective.closePopup('efcShelve')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
