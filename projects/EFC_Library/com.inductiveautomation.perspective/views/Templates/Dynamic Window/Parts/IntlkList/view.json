    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.user.roles"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "custom.m_InterlockName": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/InterlockName",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.m_Used": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Used",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.m_Description": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Description",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
