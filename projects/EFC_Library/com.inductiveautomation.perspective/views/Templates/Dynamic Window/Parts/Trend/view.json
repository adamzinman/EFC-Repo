        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.trend(self.view.params.tagPath, list(self.view.params.pens or []), self.view.custom.range, 360, 100)"
          }
        ]
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.pens": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.expanded": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 384,
      "height": 170
    }
  },
