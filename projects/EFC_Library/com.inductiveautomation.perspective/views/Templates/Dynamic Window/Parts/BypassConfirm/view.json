{
  "custom": {
    "level": 0,
    "m_Cfg_BypassMax": null,
    "reason": "",
    "error": ""
  },
  "params": {
    "tagPath": "",
    "idx": 0,
    "desc": "",
    "action": "bypass"
  },
  "propConfig": {
    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.securityLevels"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "custom.m_Cfg_BypassMax": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Cfg_BypassMax",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.idx": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.action": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 360,
      "height": 290
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Popup Util/Gap/L"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "Bypass condition",
          "style": {
            "classes": "Text/Title"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.action} = 'unbypass', 'Remove bypass', 'Bypass condition')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Desc"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/Body"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.desc}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Note"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/Caption Text/Mod/Wrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.action} = 'unbypass', 'Supervisor or higher. The reason and your user name go to the audit log.', 'Supervisor or higher. The reason and your user name go to the audit log. The PLC ends the bypass after ' + try(toStr(toInt({view.custom.m_Cfg_BypassMax} / 60000)), '?') + ' min (Cfg_BypassMax).')"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.text-field",
        "version": 0,
        "meta": {
          "name": "Reason"
        },
        "position": {
          "shrink": 0,
          "basis": "2.963vh"
        },
        "props": {
          "placeholder": "Reason (required)",
          "style": {
            "classes": "Input/Field"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.reason",
                "bidirectional": true
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "meta": {
          "name": "Error"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Text/Body Text/Mod/Wrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.error}"
              }
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.error}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "shrink": 0,
          "grow": 0,
          "basis": "3.333vh"
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "classes": "Util/Gap/M"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Cancel"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "CANCEL",
              "style": {
                "classes": "Button/Default"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup('efcBypass')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Ok"
            },
            "position": {
              "shrink": 0,
              "grow": 1,
              "basis": "2.963vh"
            },
            "props": {
              "text": "BYPASS",
              "style": {
                "classes": "Button/Danger"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.level} >= 3 && len(trim({view.custom.reason})) > 0"
                  }
                }
              },
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.params.action} = 'unbypass', 'UNBYPASS', 'BYPASS')"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tfn = efc.ui.unbypass if self.view.params.action == 'unbypass' else efc.ui.bypass\n\terr = fn(self, self.view.params.tagPath, self.view.params.idx, self.view.custom.reason)\n\tself.view.custom.error = err\n\tif not err:\n\t\tsystem.perspective.closePopup('efcBypass')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
