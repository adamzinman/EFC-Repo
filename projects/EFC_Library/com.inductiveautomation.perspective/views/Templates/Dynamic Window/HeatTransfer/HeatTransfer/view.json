{
  "custom": {
    "level": 0
  },
  "params": {
    "tagPath": "",
    "tType": "none"
  },
  "propConfig": {
    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.user.roles"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tType": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 860
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0,
      "grow": 0
    },
    "props": {
      "direction": "column",
      "alignItems": "stretch",
      "style": {
        "classes": "Container/Faceplate Container/Scroll Util/Gap/M"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0,
          "grow": 0,
          "basis": "5.185vh"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "classes": "Container/PopupHeader"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "version": 0,
            "meta": {
              "name": "Names"
            },
            "position": {
              "shrink": 0,
              "grow": 1
            },
            "props": {
              "direction": "column",
              "alignItems": "stretch",
              "style": {
                "classes": ""
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "Tag"
                },
                "position": {
                  "shrink": 0,
                  "grow": 0
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "Text/TagName"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "Desc"
                },
                "position": {
                  "shrink": 0,
                  "grow": 0
                },
                "props": {
                  "text": "Heat exchanger",
                  "style": {
                    "classes": "Text/Caption Text/Mod/Ellipsis"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.input.button",
            "version": 0,
            "meta": {
              "name": "Close"
            },
            "position": {
              "shrink": 0,
              "grow": 0,
              "basis": "2.963vh"
            },
            "props": {
              "text": "\u2715",
              "style": {
                "classes": "Button/Icon"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tefc.ui.closeDynamic(self)"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Note"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "direction": "column",
          "alignItems": "stretch",
          "style": {
            "classes": "Container/GroupBox Util/Gap/S"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "version": 0,
            "meta": {
              "name": "Header"
            },
            "position": {
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "classes": ""
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "shrink": 0,
                  "grow": 1
                },
                "props": {
                  "text": "Legacy types",
                  "style": {
                    "classes": "Text/Subheader Text/Mod/Upper"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "meta": {
              "name": "Body"
            },
            "position": {
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "direction": "column",
              "alignItems": "stretch",
              "style": {
                "classes": "Util/Gap/S"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "Txt"
                },
                "position": {
                  "shrink": 0,
                  "grow": 0
                },
                "props": {
                  "text": "The legacy (DDT_) type set has no heat-exchanger calculation block: duty, LMTD, UA and cleanliness are only available with the EFCLib v1 T_HeatEx type. Open the fan or pump of this exchanger for its DDT_Device window.",
                  "style": {
                    "classes": "Text/Caption Text/Mod/Wrap"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
