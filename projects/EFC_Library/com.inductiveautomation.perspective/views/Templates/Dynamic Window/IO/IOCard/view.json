    "level": 0,
    "m_Module_MOD_ERROR": null,
    "m_Rack": null,
    "m_Slot": null,
    "m_CardDesc": null,
    "m_Module_HMI_DiagText": null
  },
  "params": {
    "tagPath": "",
    "tType": "native",
    "model": ""
  },
  "propConfig": {
    "custom.level": {
      "binding": {
        "type": "property",
        "config": {
          "path": "session.props.auth.user.roles"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn efc.ui.level(value)"
          }
        ]
      }
    },
    "custom.m_Module_MOD_ERROR": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Module/MOD_ERROR",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.m_Rack": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Rack",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.m_Slot": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Slot",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "bidirectional": false,
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.m_CardDesc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/CardDesc",
