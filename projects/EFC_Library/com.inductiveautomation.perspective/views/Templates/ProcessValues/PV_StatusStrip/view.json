                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "FLT",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aFLT} >= 0) && 0 < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aFLT} < 0, \"PV/Chip/Fault\", \"PV/Chip/Fault\" + if({view.custom.aFLT} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aFLT} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_HH",
                          "tooltip": {
                            "enabled": true,
                            "text": "High-high alarm"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "HH",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aHH} >= 0) && (if({view.custom.aFLT} >= 0, 1, 0)) < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aHH} < 0, \"\", \"PV/Chip/\" + case({view.custom.aHH} % 10, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.aHH} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aHH} >= 10, \" Alarm/Mod/Blink\", \"\")))"
