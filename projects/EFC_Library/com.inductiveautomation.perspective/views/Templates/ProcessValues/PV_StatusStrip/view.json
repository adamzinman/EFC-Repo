        }
      }
    },
    "custom.anyUnacked": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "({view.custom.aFLT} >= 10 && {view.custom.aFLT} < 20) || ({view.custom.aHH} >= 10 && {view.custom.aHH} < 20) || ({view.custom.aH} >= 10 && {view.custom.aH} < 20) || ({view.custom.aL} >= 10 && {view.custom.aL} < 20) || ({view.custom.aLL} >= 10 && {view.custom.aLL} < 20) || ({view.custom.aOVR} >= 10 && {view.custom.aOVR} < 20) || ({view.custom.aUNR} >= 10 && {view.custom.aUNR} < 20)"
        }
      }
    },
    "custom.activePri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max(-1, if({view.custom.aHH} >= 0 && {view.custom.aHH} < 20, {view.custom.aHH} % 10, -1), if({view.custom.aH} >= 0 && {view.custom.aH} < 20, {view.custom.aH} % 10, -1), if({view.custom.aL} >= 0 && {view.custom.aL} < 20, {view.custom.aL} % 10, -1), if({view.custom.aLL} >= 0 && {view.custom.aLL} < 20, {view.custom.aLL} % 10, -1), if({view.custom.aOVR} >= 0 && {view.custom.aOVR} < 20, {view.custom.aOVR} % 10, -1), if({view.custom.aUNR} >= 0 && {view.custom.aUNR} < 20, {view.custom.aUNR} % 10, -1))"
        }
      }
    },
    "custom.clearedPri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max(-1, if({view.custom.aHH} >= 20, {view.custom.aHH} % 10, -1), if({view.custom.aH} >= 20, {view.custom.aH} % 10, -1), if({view.custom.aL} >= 20, {view.custom.aL} % 10, -1), if({view.custom.aLL} >= 20, {view.custom.aLL} % 10, -1), if({view.custom.aOVR} >= 20, {view.custom.aOVR} % 10, -1), if({view.custom.aUNR} >= 20, {view.custom.aUNR} % 10, -1))"
        }
      }
    },
    "custom.inh": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "toBoolean(coalesce({view.custom.inhHH}, false)) || toBoolean(coalesce({view.custom.inhH}, false)) || toBoolean(coalesce({view.custom.inhL}, false)) || toBoolean(coalesce({view.custom.inhLL}, false))"
        }
      }
    },
    "custom.badValue": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!isGood({view.custom.pv}) || {view.custom.fltActive} || toBoolean(coalesce({view.custom.hwFault}, false))"
        }
      }
    },
    "params.tType": {
