        },
        "props": {
          "direction": "row",
          "justify": "flex-start",
          "alignItems": "stretch",
          "wrap": "nowrap",
          "style": {
            "classes": "PV/Card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "Strip"
            },
            "position": {
              "basis": "0.37vh",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "PV/Strip/Normal"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.fltActive}, \"PV/Strip/Fault\" + if({view.custom.anyUnacked}, \" Alarm/Mod/Blink\", \"\"),\n if({view.custom.activePri} >= 0, \"PV/Strip/\" + case({view.custom.activePri}, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.anyUnacked}, \" Alarm/Mod/Blink\", \"\"),\n  if({view.custom.aFLT} >= 20, \"PV/Strip/Fault Alarm/Mod/ClearedUnacked\",\n   if({view.custom.clearedPri} >= 0, \"PV/Strip/\" + case({view.custom.clearedPri}, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + \" Alarm/Mod/ClearedUnacked\",\n    \"PV/Strip/Normal\"))))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "meta": {
              "name": "Body"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "direction": "column",
              "justify": "space-between",
              "alignItems": "stretch",
              "wrap": "nowrap",
              "style": {
                "classes": "PV/Body"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "version": 0,
                "meta": {
                  "name": "HeaderRow"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "direction": "row",
                  "justify": "space-between",
                  "alignItems": "center",
                  "wrap": "nowrap",
                  "style": {
                    "classes": "PV/HeaderRow"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "version": 0,
                    "meta": {
                      "name": "Tag",
                      "tooltip": {
                        "enabled": true,
                        "text": ""
                      }
                    },
                    "position": {
                      "basis": "auto",
                      "grow": 1,
                      "shrink": 1
                    },
                    "props": {
                      "text": "PT002",
                      "style": {
                        "classes": "PV/Tag Text/Mod/Ellipsis"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if(isNull({view.custom.name}) || len(toStr({view.custom.name})) = 0 || toStr({view.custom.name}) = \"null\",\n  substring({view.params.tagPath}, max(lastIndexOf({view.params.tagPath}, \"/\"), lastIndexOf({view.params.tagPath}, \"]\")) + 1),\n  toStr({view.custom.name}))"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if(isNull({view.custom.desc}) || toStr({view.custom.desc}) = \"null\", \"\", toStr({view.custom.desc}))"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.container.flex",
                    "version": 0,
                    "meta": {
                      "name": "Chips"
                    },
