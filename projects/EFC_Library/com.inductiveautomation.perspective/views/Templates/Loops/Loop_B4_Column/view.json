{
  "custom": {
    "pv": 0,
    "sp": 0,
    "out": 0,
    "mode": 0,
    "devH": 0,
    "devL": 0,
    "devHAct": false,
    "devLAct": false,
    "almHi": 0,
    "almLo": 0,
    "pvLo": 0,
    "pvHi": 0,
    "units": "",
    "pvPct": 0,
    "spPct": 0,
    "hiPct": 0,
    "loPct": 0,
    "outPct": 0,
    "alarm": false,
    "modeText": "",
    "name": ""
  },
  "params": {
    "tagPath": "[default]PID_Demo/TIC101",
    "label": "",
    "tType": "PID_Loop",
    "dockId": "",
    "dwTagPath": ""
  },
  "propConfig": {
    "custom.pv": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV"
        }
      }
    },
    "custom.sp": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/SP"
        }
      }
    },
    "custom.out": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/OUT"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Mode"
        }
      }
    },
    "custom.devH": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmDev"
        }
      }
    },
    "custom.devL": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmDev"
        }
      }
    },
    "custom.devHAct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.pv} >= {view.custom.almHi}"
        }
      }
    },
    "custom.devLAct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.pv} <= {view.custom.almLo}"
        }
      }
    },
    "custom.almHi": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmHi"
        }
      }
    },
    "custom.almLo": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmLo"
        }
      }
    },
    "custom.pvLo": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engLow"
        }
      }
    },
    "custom.pvHi": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engHigh"
        }
      }
    },
    "custom.units": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engUnit"
        }
      }
    },
    "custom.pvPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.pv} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.spPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.sp} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.hiPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almHi} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.loPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almLo} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.outPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, {view.custom.out}))"
        }
      }
    },
    "custom.alarm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.devHAct} || {view.custom.devLAct}"
        }
      }
    },
    "custom.modeText": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.mode}, 0, \"MAN\", 1, \"AUTO\", 2, \"CAS\", \"---\")"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(len({view.params.label}) > 0, {view.params.label}, substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1))"
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dockId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dwTagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
