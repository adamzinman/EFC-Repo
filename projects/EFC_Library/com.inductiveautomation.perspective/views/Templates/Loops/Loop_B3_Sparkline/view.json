  "propConfig": {
    "custom.pv": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Val_PV"
        }
      }
    },
    "custom.sp": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Val_SP"
        }
      }
    },
    "custom.out": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Out_CV"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Sts_Mode"
        }
      }
    },
    "custom.devH": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Alm_DevH/Cfg_Lim"
        }
      }
    },
    "custom.devL": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Alm_DevL/Cfg_Lim"
        }
      }
    },
    "custom.devHAct": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Alm_DevH/Sts_Active"
        }
      }
    },
    "custom.devLAct": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Alm_DevL/Sts_Active"
        }
      }
    },
    "custom.almHi": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.sp} + {view.custom.devH}"
        }
      }
    },
    "custom.almLo": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.sp} - {view.custom.devL}"
        }
      }
    },
    "custom.pvLo": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Cfg_PVMin"
        }
      }
    },
    "custom.pvHi": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Cfg_PVMax"
        }
      }
    },
    "custom.units": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Cfg_PVEU"
        }
      }
    },
    "custom.pvPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.pv} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.spPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.sp} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.hiPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almHi} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.loPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almLo} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.outPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, {view.custom.out}))"
        }
      }
    },
    "custom.alarm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.devHAct} || {view.custom.devLAct}"
        }
      }
    },
    "custom.modeText": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.mode}, 0, \"MAN\", 1, \"AUTO\", 2, \"CAS\", \"---\")"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(len({view.params.label}) > 0, {view.params.label}, substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1))"
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dockId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dwTagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.devAlm": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Alm_DevH/Cfg_Lim"
        }
      }
    },
    "custom.spark": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(5000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tbase = self.view.params.tagPath\n\tW, H = 150.0, 34.0\n\tempty = {\"pv\": \"\", \"sp\": \"\"}\n\tif not base:\n\t\treturn empty\n\ttry:\n\t\tds = system.tag.queryTagHistory(paths=[base + \"/Val_PV\", base + \"/Val_SP\"], rangeMinutes=1, returnSize=40,\n\t\t\taggregationMode=\"Average\", returnFormat=\"Wide\", ignoreBadQuality=True)\n\texcept:\n\t\treturn empty\n\trows = []\n\tfor r in range(ds.getRowCount()):\n\t\ta, b = ds.getValueAt(r, 1), ds.getValueAt(r, 2)\n\t\tif a is not None and b is not None:\n\t\t\trows.append((float(a), float(b)))\n\tif len(rows) < 2:\n\t\treturn empty\n\tlo = min(min(p) for p in rows)\n\thi = max(max(p) for p in rows)\n\tpad = max((hi - lo) * 0.15, 0.5)\n\tlo, hi = lo - pad, hi + pad\n\tdef y(val):\n\t\treturn H - 3 - (val - lo) / (hi - lo) * (H - 6)\n\tstep = W / (len(rows) - 1)\n\tdef mk(i):\n\t\treturn \" \".join((\"M\" if n == 0 else \"L\") + \"%.1f,%.1f\" % (n * step, y(p[i])) for n, p in enumerate(rows))\n\treturn {\"pv\": mk(0), \"sp\": mk(1)}"
          }
        ]
      }
    }
  },
