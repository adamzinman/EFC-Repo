		<FBProgram name="Runtime_Tracking">
			<STSource>
IF %S6 AND DEV.YI THEN
	IF DEV.Run_Sec &lt; 59.0 THEN
		DEV.Run_Sec := DEV.Run_Sec + 1.0;
	ELSE
		DEV.Run_Sec := 0.0;

		IF DEV.Run_Min &lt; 59.0 THEN
			DEV.Run_Min := Run_Min + 1.0;
		ELSE
			DEV.Run_Min := 0.0;
			DEV.Run_Hour := Run_Hour + 1.0;
		END_IF;
	END_IF;
END_IF;

DEV.Runtime := DEV.Run_Hour + (DEV.Run_Min/60.0);

IF DEV.Reset_Runtime THEN
	DEV.Runtime := 0.0;
	DEV.Reset_Runtime:=FALSE;
END_IF;
</STSource>
		</FBProgram>
