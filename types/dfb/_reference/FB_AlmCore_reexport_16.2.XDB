	<FBSource nameOfFBType="FB_AlmCore" version="1.00" dateTime="dt#2026-10-21-19:00:00">
		<attribute name="TypeCodeCheckSumString" value="09AF"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="2A99"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
