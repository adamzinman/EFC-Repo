FUNCTION_BLOCK FB_AlmCore
(* ISA-18.2 / IEC 62682 alarm state machine: chattering delays, latching, acknowledge, time-limited shelving, suppression, out-of-service *)
(* PCLib 1.00 - generated by gen_dfb.py *)

VAR_INPUT
    Cond : BOOL;                            (* Raw alarm condition *)
    Supp : BOOL;                            (* Suppressed by design (logic) *)
    Enabled : BOOL;                         (* Alarm configured / enabled *)
    LatchCfg : BOOL;                        (* Latching alarm *)
    NoAck : BOOL;                           (* No acknowledge required *)
    OnDly : TIME;                           (* On-delay *)
    OffDly : TIME;                          (* Off-delay *)
    MaxShelf : TIME;                        (* Maximum shelve time *)
    Ack : BOOL;                             (* Acknowledge command *)
    Rst : BOOL;                             (* Reset latched alarm command *)
    Shelve : BOOL;                          (* Shelve command *)
    Unshelve : BOOL;                        (* Unshelve command *)
    RemoveSvc : BOOL;                       (* Remove from service command *)
    ReturnSvc : BOOL;                       (* Return to service command *)
END_VAR

VAR_OUTPUT
    Active : BOOL;                          (* Alarm active (annunciated) *)
    Unack : BOOL;                           (* Unacknowledged *)
    Shelved : BOOL;                         (* Shelved *)
    Suppressed : BOOL;                      (* Suppressed by design *)
    OOS : BOOL;                             (* Out of service *)
    State : INT;                            (* 0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service *)
    ShelfLeft : TIME;                       (* Shelve time remaining *)
    EvtActive : BOOL;                       (* Pulse: alarm became active *)
    EvtRTN : BOOL;                          (* Pulse: alarm returned to normal *)
END_VAR

VAR
    xOOS : BOOL;                            (* Out-of-service memory *)
    xShelved : BOOL;                        (* Shelved memory *)
    xInhibit : BOOL;                        (* Alarm inhibited (OOS, shelved, suppressed, disabled) *)
    xCond : BOOL;                           (* Condition after on/off delays *)
    xLatch : BOOL;                          (* Latched memory *)
    xActive : BOOL;                         (* Active *)
    xUnack : BOOL;                          (* Unacknowledged memory *)
    tonShelf : TON;                         (* Shelve timer *)
    tonOn : TON;                            (* On-delay timer *)
    tofOff : TOF;                           (* Off-delay timer *)
    rtActive : R_TRIG;                      (* Active rising edge *)
    ftActive : F_TRIG;                      (* Active falling edge *)
END_VAR

(* ---- Out of service (ISA-18.2 state H) ---- *)
IF RemoveSvc THEN
    xOOS := TRUE;
END_IF;
IF ReturnSvc THEN
    xOOS := FALSE;
END_IF;

(* ---- Shelving (ISA-18.2 state F), always time-limited ---- *)
IF Shelve AND Enabled AND NOT xOOS THEN
    xShelved := TRUE;
END_IF;
IF Unshelve OR xOOS OR NOT Enabled THEN
    xShelved := FALSE;
END_IF;
tonShelf(IN := xShelved, PT := MaxShelf);
IF tonShelf.Q THEN
    xShelved := FALSE;
END_IF;
IF xShelved THEN
    ShelfLeft := MaxShelf - tonShelf.ET;
ELSE
    ShelfLeft := T#0S;
END_IF;

xInhibit := xOOS OR xShelved OR Supp OR NOT Enabled;

(* ---- Chattering control: on-delay / off-delay ---- *)
tonOn(IN := Cond AND NOT xInhibit, PT := OnDly);
tofOff(IN := tonOn.Q, PT := OffDly);
xCond := tofOff.Q AND NOT xInhibit;

(* ---- Latching (ISA-18.2 state E): reset only after return to normal ---- *)
IF xInhibit OR NOT LatchCfg THEN
    xLatch := FALSE;
ELSIF xCond THEN
    xLatch := TRUE;
ELSIF Rst THEN
    xLatch := FALSE;
END_IF;

xActive := xCond OR xLatch;

(* ---- Annunciation and acknowledge ---- *)
rtActive(CLK := xActive);
ftActive(CLK := xActive);
IF rtActive.Q AND NOT NoAck THEN
    xUnack := TRUE;
END_IF;
IF Ack OR xInhibit OR NoAck THEN
    xUnack := FALSE;
END_IF;

(* ---- State per ISA-18.2 / IEC 62682 state model ---- *)
IF xOOS OR NOT Enabled THEN
    State := 7;
ELSIF Supp THEN
    State := 6;
ELSIF xShelved THEN
    State := 5;
ELSIF xLatch AND NOT xCond THEN
    State := 4;
ELSIF xActive AND xUnack THEN
    State := 1;
ELSIF xActive THEN
    State := 2;
ELSIF xUnack THEN
    State := 3;
ELSE
    State := 0;
END_IF;

Active := xActive;
Unack := xUnack;
Shelved := xShelved;
Suppressed := Supp AND Enabled AND NOT xOOS;
OOS := xOOS;
EvtActive := rtActive.Q;
EvtRTN := ftActive.Q AND NOT xInhibit;

END_FUNCTION_BLOCK
