<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<DDTExchangeFile>
<fileHeader company="Schneider Automation" product="EcoStruxure Control Expert Classic V16.2" dateTime="date_and_time#2026-10-21-3:2:44" content="Derived Data Type source file" DTDVersion="41"></fileHeader>
<contentHeader name="PCLib" version="1.00"></contentHeader>
<DDTSource DDTName="T_IORack" version="1.00" dateTime="dt#2026-10-21-03:02:44">
	<comment>Modicon x80 rack / drop diagnostics: power supply, slot health, communications</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Cfg_Rack" typeName="INT">
			<comment>Rack number</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_Drop" typeName="STRING[20]">
			<comment>Drop / station name</comment>
		</variables>
		<variables name="Cfg_Remote" typeName="BOOL">
			<comment>Remote drop (eRIO / DIO): communications monitored</comment>
		</variables>
		<variables name="Cfg_NumSlots" typeName="INT">
			<comment>Slots on the backplane (4, 6, 8 or 12)</comment>
			<variableInit value="12"></variableInit>
		</variables>
		<variables name="Cfg_PSModel" typeName="STRING[16]">
			<comment>Power supply reference, e.g. BMXCPS3500</comment>
		</variables>
		<variables name="Cfg_SlotUsed" typeName="ARRAY[0..11] OF BOOL">
			<comment>Slot n holds a configured module</comment>
		</variables>
		<variables name="Inp_PSOK" typeName="BOOL">
			<comment>Power supply healthy</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Inp_PSRedOK" typeName="BOOL">
			<comment>Redundant power supply healthy (if fitted)</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Inp_CommOK" typeName="BOOL">
			<comment>Drop communications healthy (remote drops)</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Inp_SlotOK" typeName="ARRAY[0..11] OF BOOL">
			<comment>Module in slot n healthy (from T_IOCard Sts_OK)</comment>
		</variables>
		<variables name="Sts_OK" typeName="BOOL">
			<comment>Power, communications and every used slot healthy</comment>
		</variables>
		<variables name="Sts_NumFaulted" typeName="INT">
			<comment>Number of used slots not healthy</comment>
		</variables>
		<variables name="Sts_SlotWord" typeName="WORD">
			<comment>Faulted used slots packed (bit n = slot n), for SCADA</comment>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Alm_PSFault" typeName="T_Alarm">
			<comment>Power supply fault</comment>
		</variables>
		<variables name="Alm_PSRedFault" typeName="T_Alarm">
			<comment>Redundant power supply fault</comment>
		</variables>
		<variables name="Alm_CommLoss" typeName="T_Alarm">
			<comment>Drop communications lost</comment>
		</variables>
		<variables name="Alm_SlotFault" typeName="T_Alarm">
			<comment>One or more modules faulted</comment>
		</variables>
	</structure>
</DDTSource>
</DDTExchangeFile>
