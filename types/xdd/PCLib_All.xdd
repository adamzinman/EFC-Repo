<DDTExchangeFile>
<fileHeader company="Schneider Automation" product="EcoStruxure Control Expert Classic V16.2" dateTime="date_and_time#2026-10-21-1:58:43" content="Derived Data Type source file" DTDVersion="41"></fileHeader>
<contentHeader name="PCLib" version="1.00"></contentHeader>
<DDTSource DDTName="T_Alarm" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Discrete alarm, ISA-18.2 / IEC 62682 state model, shelving, suppression, out-of-service</comment>
	<structure>
		<variables name="Inp_Cond" typeName="BOOL">
			<comment>Raw alarm condition (written by owner logic)</comment>
		</variables>
		<variables name="Inp_Suppress" typeName="BOOL">
			<comment>Suppressed-by-design: state-based suppression by logic (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Cfg_En" typeName="BOOL">
			<comment>Alarm configured (FALSE = not an alarm, e.g. instrument not fitted)</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Cfg_Latch" typeName="BOOL">
			<comment>Latching alarm: active until Cmd_Reset after RTN (ISA-18.2 state E)</comment>
		</variables>
		<variables name="Cfg_NoAck" typeName="BOOL">
			<comment>No acknowledge required - use only for alarms rationalised as such</comment>
		</variables>
		<variables name="Cfg_OnDly" typeName="TIME">
			<comment>On-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_OffDly" typeName="TIME">
			<comment>Off-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_Priority" typeName="INT">
			<comment>Rationalised priority: 1=Emergency 2=High 3=Medium 4=Low</comment>
			<variableInit value="3"></variableInit>
		</variables>
		<variables name="Cfg_Class" typeName="INT">
			<comment>Alarm class (alarm philosophy): 0=General 1=Safety 2=Environmental 3=Quality 4=Asset</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_MaxShelf" typeName="TIME">
			<comment>Maximum shelve duration (shelving must be time-limited)</comment>
			<variableInit value="T#8H"></variableInit>
		</variables>
		<variables name="Cmd_Ack" typeName="BOOL">
			<comment>Operator acknowledge (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Reset latched alarm (one-shot)</comment>
		</variables>
		<variables name="Cmd_Shelve" typeName="BOOL">
			<comment>Operator shelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_Unshelve" typeName="BOOL">
			<comment>Operator unshelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_RemoveSvc" typeName="BOOL">
			<comment>Remove from service for maintenance (one-shot, permit required)</comment>
		</variables>
		<variables name="Cmd_ReturnSvc" typeName="BOOL">
			<comment>Return to service (one-shot)</comment>
		</variables>
		<variables name="Sts_Active" typeName="BOOL">
			<comment>Alarm active (after delays and latch)</comment>
		</variables>
		<variables name="Sts_Unack" typeName="BOOL">
			<comment>Alarm unacknowledged</comment>
		</variables>
		<variables name="Sts_Shelved" typeName="BOOL">
			<comment>Shelved by operator (ISA-18.2 state F)</comment>
		</variables>
		<variables name="Sts_Suppressed" typeName="BOOL">
			<comment>Suppressed by design (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Sts_OOS" typeName="BOOL">
			<comment>Out of service (ISA-18.2 state H)</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service</comment>
		</variables>
		<variables name="Sts_ShelfLeft" typeName="TIME">
			<comment>Shelve time remaining</comment>
		</variables>
		<variables name="Val_Count" typeName="UDINT">
			<comment>Activation counter (alarm performance KPIs)</comment>
		</variables>
		<variables name="Val_LastActive" typeName="DT">
			<comment>Date/time of last activation</comment>
		</variables>
		<variables name="Val_LastRTN" typeName="DT">
			<comment>Date/time of last return to normal</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_AlmLim" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Analog limit alarm: limit + deadband + ISA-18.2 / IEC 62682 alarm</comment>
	<structure>
		<variables name="Cfg_Lim" typeName="REAL">
			<comment>Alarm limit (EU) - from rationalisation / master alarm database</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_DB" typeName="REAL">
			<comment>Deadband for return to normal (EU, ISA-18.2 chattering control)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Inp_Cond" typeName="BOOL">
			<comment>Raw alarm condition (written by owner logic)</comment>
		</variables>
		<variables name="Inp_Suppress" typeName="BOOL">
			<comment>Suppressed-by-design: state-based suppression by logic (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Cfg_En" typeName="BOOL">
			<comment>Alarm enabled - set TRUE once Cfg_Lim is rationalised</comment>
		</variables>
		<variables name="Cfg_Latch" typeName="BOOL">
			<comment>Latching alarm: active until Cmd_Reset after RTN (ISA-18.2 state E)</comment>
		</variables>
		<variables name="Cfg_NoAck" typeName="BOOL">
			<comment>No acknowledge required - use only for alarms rationalised as such</comment>
		</variables>
		<variables name="Cfg_OnDly" typeName="TIME">
			<comment>On-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_OffDly" typeName="TIME">
			<comment>Off-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_Priority" typeName="INT">
			<comment>Rationalised priority: 1=Emergency 2=High 3=Medium 4=Low</comment>
			<variableInit value="3"></variableInit>
		</variables>
		<variables name="Cfg_Class" typeName="INT">
			<comment>Alarm class (alarm philosophy): 0=General 1=Safety 2=Environmental 3=Quality 4=Asset</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_MaxShelf" typeName="TIME">
			<comment>Maximum shelve duration (shelving must be time-limited)</comment>
			<variableInit value="T#8H"></variableInit>
		</variables>
		<variables name="Cmd_Ack" typeName="BOOL">
			<comment>Operator acknowledge (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Reset latched alarm (one-shot)</comment>
		</variables>
		<variables name="Cmd_Shelve" typeName="BOOL">
			<comment>Operator shelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_Unshelve" typeName="BOOL">
			<comment>Operator unshelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_RemoveSvc" typeName="BOOL">
			<comment>Remove from service for maintenance (one-shot, permit required)</comment>
		</variables>
		<variables name="Cmd_ReturnSvc" typeName="BOOL">
			<comment>Return to service (one-shot)</comment>
		</variables>
		<variables name="Sts_Active" typeName="BOOL">
			<comment>Alarm active (after delays and latch)</comment>
		</variables>
		<variables name="Sts_Unack" typeName="BOOL">
			<comment>Alarm unacknowledged</comment>
		</variables>
		<variables name="Sts_Shelved" typeName="BOOL">
			<comment>Shelved by operator (ISA-18.2 state F)</comment>
		</variables>
		<variables name="Sts_Suppressed" typeName="BOOL">
			<comment>Suppressed by design (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Sts_OOS" typeName="BOOL">
			<comment>Out of service (ISA-18.2 state H)</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service</comment>
		</variables>
		<variables name="Sts_ShelfLeft" typeName="TIME">
			<comment>Shelve time remaining</comment>
		</variables>
		<variables name="Val_Count" typeName="UDINT">
			<comment>Activation counter (alarm performance KPIs)</comment>
		</variables>
		<variables name="Val_LastActive" typeName="DT">
			<comment>Date/time of last activation</comment>
		</variables>
		<variables name="Val_LastRTN" typeName="DT">
			<comment>Date/time of last return to normal</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_Mode" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Control-module mode and ISA-88 ownership (arbitration); maps to MTP OpMode</comment>
	<structure>
		<variables name="Cmd_Auto" typeName="BOOL">
			<comment>Operator request Automatic (one-shot)</comment>
		</variables>
		<variables name="Cmd_Man" typeName="BOOL">
			<comment>Operator request Manual (one-shot)</comment>
		</variables>
		<variables name="Cmd_Maint" typeName="BOOL">
			<comment>Request Maintenance (one-shot)</comment>
		</variables>
		<variables name="Cmd_OOS" typeName="BOOL">
			<comment>Request Out-of-Service (one-shot)</comment>
		</variables>
		<variables name="Prog_Auto" typeName="BOOL">
			<comment>Owner request Automatic</comment>
		</variables>
		<variables name="Prog_Man" typeName="BOOL">
			<comment>Owner request Manual</comment>
		</variables>
		<variables name="Prog_Lock" typeName="BOOL">
			<comment>Owner locks current mode (operator cannot change)</comment>
		</variables>
		<variables name="Prog_Acquire" typeName="BOOL">
			<comment>ISA-88 arbitration: owner (phase / EM) acquires this module</comment>
		</variables>
		<variables name="Prog_Release" typeName="BOOL">
			<comment>ISA-88 arbitration: owner releases this module</comment>
		</variables>
		<variables name="Inp_ReqOwnerID" typeName="DINT">
			<comment>ID of the phase / equipment module requesting ownership</comment>
		</variables>
		<variables name="Cmd_ForceRelease" typeName="BOOL">
			<comment>Supervisor forces release of ownership (one-shot)</comment>
		</variables>
		<variables name="Cfg_PowerUpMode" typeName="INT">
			<comment>Mode at cold start: 0=OOS 1=Maint 2=Man 3=Auto</comment>
			<variableInit value="2"></variableInit>
		</variables>
		<variables name="Cfg_NoMaint" typeName="BOOL">
			<comment>Maintenance mode not allowed</comment>
		</variables>
		<variables name="Sts_Auto" typeName="BOOL">
			<comment>In Automatic (commanded by owner) - MTP Automatic</comment>
		</variables>
		<variables name="Sts_Man" typeName="BOOL">
			<comment>In Manual (commanded by operator) - MTP Operator</comment>
		</variables>
		<variables name="Sts_Maint" typeName="BOOL">
			<comment>In Maintenance</comment>
		</variables>
		<variables name="Sts_OOS" typeName="BOOL">
			<comment>Out of service - MTP Offline</comment>
		</variables>
		<variables name="Sts_Mode" typeName="INT">
			<comment>0=OOS 1=Maint 2=Man 3=Auto  (MTP: 0=Offline 2=Operator 3=Automatic)</comment>
		</variables>
		<variables name="Sts_Owned" typeName="BOOL">
			<comment>Acquired by an owner</comment>
		</variables>
		<variables name="Val_OwnerID" typeName="DINT">
			<comment>ID of current owner, 0 = free</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_RunTime" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Run-hours, starts and maintenance counters</comment>
	<structure>
		<variables name="Inp_Running" typeName="BOOL">
			<comment>Equipment running (from owner logic)</comment>
		</variables>
		<variables name="Cfg_MaintHrs" typeName="REAL">
			<comment>Maintenance interval in run hours, 0 = off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cmd_ResetMaint" typeName="BOOL">
			<comment>Reset hours-since-maintenance (one-shot)</comment>
		</variables>
		<variables name="Cmd_ResetAll" typeName="BOOL">
			<comment>Reset all counters (one-shot, supervisor)</comment>
		</variables>
		<variables name="Val_RunSecs" typeName="UDINT">
			<comment>Total run time (s) - master counter</comment>
		</variables>
		<variables name="Val_RunHrs" typeName="REAL">
			<comment>Total run hours (display)</comment>
		</variables>
		<variables name="Val_Starts" typeName="UDINT">
			<comment>Total starts / cycles</comment>
		</variables>
		<variables name="Val_StartsLastHr" typeName="INT">
			<comment>Starts in the last 60 min (rolling)</comment>
		</variables>
		<variables name="Val_LastRun" typeName="TIME">
			<comment>Duration of last run</comment>
		</variables>
		<variables name="Val_HrsSinceMaint" typeName="REAL">
			<comment>Run hours since last maintenance reset</comment>
		</variables>
		<variables name="Sts_MaintDue" typeName="BOOL">
			<comment>Maintenance due</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_AI" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Analog input: scaling, filtering, NE43 range check, alarms, sim</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Cfg_EU" typeName="STRING[12]">
			<comment>Engineering units text</comment>
		</variables>
		<variables name="Inp_Raw" typeName="INT">
			<comment>Raw counts from analog channel</comment>
		</variables>
		<variables name="Inp_ChFault" typeName="BOOL">
			<comment>Channel / module diagnostic fault</comment>
		</variables>
		<variables name="Cfg_RawMin" typeName="INT">
			<comment>Raw counts at 0% (M340/M580 4-20mA default 0)</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_RawMax" typeName="INT">
			<comment>Raw counts at 100% (M340/M580 4-20mA default 10000)</comment>
			<variableInit value="10000"></variableInit>
		</variables>
		<variables name="Cfg_EUMin" typeName="REAL">
			<comment>PV at 0% (EU)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_EUMax" typeName="REAL">
			<comment>PV at 100% (EU)</comment>
			<variableInit value="100.0"></variableInit>
		</variables>
		<variables name="Cfg_FiltTC" typeName="REAL">
			<comment>1st-order filter time constant (s), 0 = off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_SqrtExtract" typeName="BOOL">
			<comment>Square-root extraction (DP flow)</comment>
		</variables>
		<variables name="Cfg_LoCutoff" typeName="REAL">
			<comment>Low cutoff (% span): PV forced to EUMin below this, 0 = off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_BadLoPct" typeName="REAL">
			<comment>Bad below this % span (NE43 3.6mA = -2.5%)</comment>
			<variableInit value="-2.5"></variableInit>
		</variables>
		<variables name="Cfg_BadHiPct" typeName="REAL">
			<comment>Bad above this % span (NE43 21mA = 106.25%)</comment>
			<variableInit value="106.25"></variableInit>
		</variables>
		<variables name="Cfg_BadAction" typeName="INT">
			<comment>On bad PV: 0=Hold last good 1=Substitute 2=EUMin 3=EUMax</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_SubstPV" typeName="REAL">
			<comment>Substitute PV used when Cfg_BadAction = 1</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation enabled</comment>
		</variables>
		<variables name="Sim_PV" typeName="REAL">
			<comment>Simulated PV (EU)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Val_PV" typeName="REAL">
			<comment>Process value (EU) - use this in logic</comment>
		</variables>
		<variables name="Val_PVPct" typeName="REAL">
			<comment>Process value (% of span)</comment>
		</variables>
		<variables name="Val_ROC" typeName="REAL">
			<comment>Rate of change (EU/s, 1 s window) - input to Alm_ROC</comment>
		</variables>
		<variables name="Sts_Bad" typeName="BOOL">
			<comment>PV bad (out of range or channel fault)</comment>
		</variables>
		<variables name="Sts_URng" typeName="BOOL">
			<comment>Under range</comment>
		</variables>
		<variables name="Sts_ORng" typeName="BOOL">
			<comment>Over range</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Sts_Subst" typeName="BOOL">
			<comment>Substitute / held value in use</comment>
		</variables>
		<variables name="Sts_Quality" typeName="INT">
			<comment>0=Good 1=Uncertain (simulation, NE107 C or S) 2=Bad</comment>
		</variables>
		<variables name="Inp_NE107" typeName="INT">
			<comment>NE107 status reported by smart device (HART / fieldbus)</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Alm_HH" typeName="T_AlmLim">
			<comment>High-high alarm</comment>
		</variables>
		<variables name="Alm_H" typeName="T_AlmLim">
			<comment>High alarm</comment>
		</variables>
		<variables name="Alm_L" typeName="T_AlmLim">
			<comment>Low alarm</comment>
		</variables>
		<variables name="Alm_LL" typeName="T_AlmLim">
			<comment>Low-low alarm</comment>
		</variables>
		<variables name="Alm_ROC" typeName="T_AlmLim">
			<comment>Rate-of-change alarm (Cfg_Lim in EU/s)</comment>
		</variables>
		<variables name="Alm_Bad" typeName="T_Alarm">
			<comment>Bad PV alarm</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_DI" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Digital input: invert, debounce, sim, optional state alarm</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Inp_Raw" typeName="BOOL">
			<comment>Raw input from channel</comment>
		</variables>
		<variables name="Inp_ChFault" typeName="BOOL">
			<comment>Channel / module diagnostic fault</comment>
		</variables>
		<variables name="Cfg_Invert" typeName="BOOL">
			<comment>Invert raw signal (fail-safe NC contacts)</comment>
		</variables>
		<variables name="Cfg_OnDly" typeName="TIME">
			<comment>Debounce on-delay</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_OffDly" typeName="TIME">
			<comment>Debounce off-delay</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_AlmMode" typeName="INT">
			<comment>0=No alarm 1=Alarm when Val TRUE 2=Alarm when Val FALSE</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_TrueText" typeName="STRING[16]">
			<comment>HMI text for TRUE state, e.g. OPEN</comment>
		</variables>
		<variables name="Cfg_FalseText" typeName="STRING[16]">
			<comment>HMI text for FALSE state, e.g. CLOSED</comment>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation enabled</comment>
		</variables>
		<variables name="Sim_Val" typeName="BOOL">
			<comment>Simulated value</comment>
		</variables>
		<variables name="Val" typeName="BOOL">
			<comment>Conditioned value - use this in logic</comment>
		</variables>
		<variables name="Sts_Bad" typeName="BOOL">
			<comment>Channel fault</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Val_Transitions" typeName="UDINT">
			<comment>Count of FALSE-&gt;TRUE transitions</comment>
		</variables>
		<variables name="Alm" typeName="T_Alarm">
			<comment>State alarm (see Cfg_AlmMode)</comment>
		</variables>
		<variables name="Alm_Bad" typeName="T_Alarm">
			<comment>Channel fault alarm</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_DValve" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>On/off valve: single or dual solenoid, limit switches, travel alarms</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Mode" typeName="T_Mode">
			<comment>Mode block</comment>
		</variables>
		<variables name="Inp_ZSO" typeName="BOOL">
			<comment>Open limit switch</comment>
		</variables>
		<variables name="Inp_ZSC" typeName="BOOL">
			<comment>Closed limit switch</comment>
		</variables>
		<variables name="Inp_Remote" typeName="BOOL">
			<comment>Local/Remote switch in REMOTE (if fitted)</comment>
		</variables>
		<variables name="Inp_IntlkOK" typeName="BOOL">
			<comment>Interlocks healthy (FALSE drives to interlock position)</comment>
		</variables>
		<variables name="Inp_PermOK" typeName="BOOL">
			<comment>Permissives healthy (TRUE = may leave safe position)</comment>
		</variables>
		<variables name="Inp_IOFault" typeName="BOOL">
			<comment>I/O channel or comms fault</comment>
		</variables>
		<variables name="Cfg_HasZSO" typeName="BOOL">
			<comment>Open limit switch fitted</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Cfg_HasZSC" typeName="BOOL">
			<comment>Closed limit switch fitted</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Cfg_FailOpen" typeName="BOOL">
			<comment>Fail position: TRUE = fail open, FALSE = fail closed</comment>
		</variables>
		<variables name="Cfg_IntlkOpen" typeName="BOOL">
			<comment>Interlock drives valve: TRUE = open, FALSE = closed</comment>
		</variables>
		<variables name="Cfg_DualCoil" typeName="BOOL">
			<comment>Dual solenoid (uses Out_Open and Out_Close)</comment>
		</variables>
		<variables name="Cfg_TravelTime" typeName="TIME">
			<comment>Maximum travel time before failure alarm</comment>
			<variableInit value="T#10S"></variableInit>
		</variables>
		<variables name="Cmd_Open" typeName="BOOL">
			<comment>Operator open (one-shot)</comment>
		</variables>
		<variables name="Cmd_Close" typeName="BOOL">
			<comment>Operator close (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Fault reset (one-shot)</comment>
		</variables>
		<variables name="Prog_Open" typeName="BOOL">
			<comment>Program open request (Auto)</comment>
		</variables>
		<variables name="Prog_Close" typeName="BOOL">
			<comment>Program close request (Auto)</comment>
		</variables>
		<variables name="Out_Open" typeName="BOOL">
			<comment>Solenoid output: open (energise)</comment>
		</variables>
		<variables name="Out_Close" typeName="BOOL">
			<comment>Solenoid output: close (dual-coil only)</comment>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation: ignore field I/O, logic generates feedback</comment>
		</variables>
		<variables name="Sts_Opened" typeName="BOOL">
			<comment>Confirmed open</comment>
		</variables>
		<variables name="Sts_Closed" typeName="BOOL">
			<comment>Confirmed closed</comment>
		</variables>
		<variables name="Sts_Opening" typeName="BOOL">
			<comment>Travelling open</comment>
		</variables>
		<variables name="Sts_Closing" typeName="BOOL">
			<comment>Travelling closed</comment>
		</variables>
		<variables name="Sts_Avail" typeName="BOOL">
			<comment>Available to Auto/program control</comment>
		</variables>
		<variables name="Sts_Intlk" typeName="BOOL">
			<comment>Interlock not healthy</comment>
		</variables>
		<variables name="Sts_NotPerm" typeName="BOOL">
			<comment>Permissive not healthy</comment>
		</variables>
		<variables name="Sts_Local" typeName="BOOL">
			<comment>In local control</comment>
		</variables>
		<variables name="Sts_Fault" typeName="BOOL">
			<comment>Any fault present</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=Transit/unknown 1=Closed 2=Open 3=Opening 4=Closing 5=Fault</comment>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Alm_FailOpen" typeName="T_Alarm">
			<comment>Failed to open within travel time</comment>
		</variables>
		<variables name="Alm_FailClose" typeName="T_Alarm">
			<comment>Failed to close within travel time</comment>
		</variables>
		<variables name="Alm_PosConflict" typeName="T_Alarm">
			<comment>Both limit switches made</comment>
		</variables>
		<variables name="Alm_Uncmd" typeName="T_Alarm">
			<comment>Left commanded position without a command</comment>
		</variables>
		<variables name="Alm_IntlkTrip" typeName="T_Alarm">
			<comment>Driven to safe position by interlock</comment>
		</variables>
		<variables name="Run" typeName="T_RunTime">
			<comment>Cycle counter (Val_Starts = operations)</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_CValve" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Modulating control valve: limits, rate limit, positioner feedback</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Mode" typeName="T_Mode">
			<comment>Mode block</comment>
		</variables>
		<variables name="Inp_PosFbk" typeName="REAL">
			<comment>Position feedback (%)</comment>
		</variables>
		<variables name="Inp_FbkBad" typeName="BOOL">
			<comment>Feedback signal bad</comment>
		</variables>
		<variables name="Inp_ZSC" typeName="BOOL">
			<comment>Closed limit switch (optional)</comment>
		</variables>
		<variables name="Inp_IntlkOK" typeName="BOOL">
			<comment>Interlocks healthy (FALSE drives to Cfg_IntlkPos)</comment>
		</variables>
		<variables name="Inp_IOFault" typeName="BOOL">
			<comment>I/O channel or comms fault</comment>
		</variables>
		<variables name="Cfg_HasFbk" typeName="BOOL">
			<comment>Position feedback fitted</comment>
		</variables>
		<variables name="Cfg_FailPos" typeName="REAL">
			<comment>Fail position (%): 0 = fail closed, 100 = fail open</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_IntlkPos" typeName="REAL">
			<comment>Position driven to on interlock (%)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_OutMin" typeName="REAL">
			<comment>Minimum output (%)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_OutMax" typeName="REAL">
			<comment>Maximum output (%)</comment>
			<variableInit value="100.0"></variableInit>
		</variables>
		<variables name="Cfg_RateUp" typeName="REAL">
			<comment>Opening rate limit (%/s), 0 = none</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_RateDn" typeName="REAL">
			<comment>Closing rate limit (%/s), 0 = none</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_TightShut" typeName="REAL">
			<comment>Demand below this (%) forces 0 for tight shut-off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_ReverseAct" typeName="BOOL">
			<comment>Reverse-acting output (100% signal = closed)</comment>
		</variables>
		<variables name="Cfg_RawMin" typeName="INT">
			<comment>Analog output raw counts at 0%</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_RawMax" typeName="INT">
			<comment>Analog output raw counts at 100%</comment>
			<variableInit value="10000"></variableInit>
		</variables>
		<variables name="Cfg_DevLim" typeName="REAL">
			<comment>Position deviation alarm limit (%)</comment>
			<variableInit value="5.0"></variableInit>
		</variables>
		<variables name="Cfg_DevTime" typeName="TIME">
			<comment>Deviation must persist this long</comment>
			<variableInit value="T#15S"></variableInit>
		</variables>
		<variables name="Cmd_ManPos" typeName="REAL">
			<comment>Operator manual demand (%)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Fault reset (one-shot)</comment>
		</variables>
		<variables name="Prog_Pos" typeName="REAL">
			<comment>Program / PID demand (%) - Auto mode</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Out_CV" typeName="REAL">
			<comment>Output demand (%) after limits and rate limit</comment>
		</variables>
		<variables name="Out_CVRaw" typeName="INT">
			<comment>Output in raw counts for AO channel</comment>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation: ignore field I/O, logic generates feedback</comment>
		</variables>
		<variables name="Val_Demand" typeName="REAL">
			<comment>Active demand before rate limit (%)</comment>
		</variables>
		<variables name="Val_Pos" typeName="REAL">
			<comment>Position (%) - feedback, or demand if no feedback</comment>
		</variables>
		<variables name="Val_Dev" typeName="REAL">
			<comment>Demand minus position (%)</comment>
		</variables>
		<variables name="Val_Travel" typeName="REAL">
			<comment>Accumulated travel (% of full stroke, summed) for diagnostics</comment>
		</variables>
		<variables name="Val_Reversals" typeName="UDINT">
			<comment>Direction reversal count</comment>
		</variables>
		<variables name="Sts_Closed" typeName="BOOL">
			<comment>Valve closed</comment>
		</variables>
		<variables name="Sts_Intlk" typeName="BOOL">
			<comment>Interlock active</comment>
		</variables>
		<variables name="Sts_RateLim" typeName="BOOL">
			<comment>Output is being rate limited</comment>
		</variables>
		<variables name="Sts_Fault" typeName="BOOL">
			<comment>Any fault present</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Inp_NE107" typeName="INT">
			<comment>NE107 status reported by smart device (HART / fieldbus)</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Alm_PosDev" typeName="T_Alarm">
			<comment>Position deviation</comment>
		</variables>
		<variables name="Alm_FbkBad" typeName="T_Alarm">
			<comment>Feedback bad</comment>
		</variables>
		<variables name="Alm_IntlkTrip" typeName="T_Alarm">
			<comment>Driven to interlock position</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_Motor" version="1.00" dateTime="dt#2026-10-21-01:58:43">
	<comment>Direct-on-line / star-delta / soft-start motor</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Mode" typeName="T_Mode">
			<comment>Mode block</comment>
		</variables>
		<variables name="Inp_RunFbk" typeName="BOOL">
			<comment>Run feedback (contactor aux / drive running)</comment>
		</variables>
		<variables name="Inp_Remote" typeName="BOOL">
			<comment>Local/Remote switch in REMOTE</comment>
		</variables>
		<variables name="Inp_AvailOK" typeName="BOOL">
			<comment>MCC available: breaker closed, control power OK</comment>
		</variables>
		<variables name="Inp_EStopOK" typeName="BOOL">
			<comment>Field E-stop circuit healthy</comment>
		</variables>
		<variables name="Inp_IntlkOK" typeName="BOOL">
			<comment>Interlocks healthy (TRUE = may run; FALSE trips)</comment>
		</variables>
		<variables name="Inp_PermOK" typeName="BOOL">
			<comment>Permissives healthy (TRUE = may start)</comment>
		</variables>
		<variables name="Inp_IOFault" typeName="BOOL">
			<comment>I/O channel or comms fault</comment>
		</variables>
		<variables name="Inp_OL" typeName="BOOL">
			<comment>Overload / motor protection relay tripped</comment>
		</variables>
		<variables name="Inp_Current" typeName="REAL">
			<comment>Motor current (A), optional</comment>
		</variables>
		<variables name="Cfg_FbkTime" typeName="TIME">
			<comment>Time allowed for run feedback after start/stop</comment>
			<variableInit value="T#5S"></variableInit>
		</variables>
		<variables name="Cfg_RestartDly" typeName="TIME">
			<comment>Minimum stopped time before restart</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_NoFbk" typeName="BOOL">
			<comment>No run feedback wired (feedback follows output)</comment>
		</variables>
		<variables name="Cfg_AutoRestart" typeName="BOOL">
			<comment>Auto mode restarts after power loss / interlock clears</comment>
		</variables>
		<variables name="Cfg_RatedAmps" typeName="REAL">
			<comment>Motor nameplate full-load current (A)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_MaxStartsHr" typeName="INT">
			<comment>Maximum starts per hour, 0 = no limit</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cmd_Start" typeName="BOOL">
			<comment>Operator start (one-shot)</comment>
		</variables>
		<variables name="Cmd_Stop" typeName="BOOL">
			<comment>Operator stop (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Fault / trip reset (one-shot)</comment>
		</variables>
		<variables name="Cmd_Jog" typeName="BOOL">
			<comment>Maintenance jog (maintained, Maint mode only)</comment>
		</variables>
		<variables name="Prog_Start" typeName="BOOL">
			<comment>Program / sequence start request (Auto mode)</comment>
		</variables>
		<variables name="Prog_Stop" typeName="BOOL">
			<comment>Program / sequence stop request (Auto mode)</comment>
		</variables>
		<variables name="Out_Run" typeName="BOOL">
			<comment>Run output to contactor / starter</comment>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation: ignore field I/O, logic generates feedback</comment>
		</variables>
		<variables name="Sts_Running" typeName="BOOL">
			<comment>Running (feedback confirmed)</comment>
		</variables>
		<variables name="Sts_Stopped" typeName="BOOL">
			<comment>Stopped (feedback confirmed)</comment>
		</variables>
		<variables name="Sts_Starting" typeName="BOOL">
			<comment>Start commanded, waiting for feedback</comment>
		</variables>
		<variables name="Sts_Stopping" typeName="BOOL">
			<comment>Stop commanded, waiting for feedback</comment>
		</variables>
		<variables name="Sts_Avail" typeName="BOOL">
			<comment>Available to Auto/program control</comment>
		</variables>
		<variables name="Sts_Ready" typeName="BOOL">
			<comment>Ready to start now (all permissives, no trip)</comment>
		</variables>
		<variables name="Sts_Intlk" typeName="BOOL">
			<comment>Interlock not healthy</comment>
		</variables>
		<variables name="Sts_NotPerm" typeName="BOOL">
			<comment>Permissive not healthy</comment>
		</variables>
		<variables name="Sts_Local" typeName="BOOL">
			<comment>In local control</comment>
		</variables>
		<variables name="Sts_Tripped" typeName="BOOL">
			<comment>Tripped - reset required</comment>
		</variables>
		<variables name="Sts_Fault" typeName="BOOL">
			<comment>Any fault present</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=Stopped 1=Starting 2=Running 3=Stopping 4=Tripped 5=Not available</comment>
		</variables>
		<variables name="Sts_RestartLeft" typeName="TIME">
			<comment>Restart-delay time remaining</comment>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Val_Current" typeName="REAL">
			<comment>Motor current (A)</comment>
		</variables>
		<variables name="Val_LoadPct" typeName="REAL">
			<comment>Load (% of Cfg_RatedAmps)</comment>
		</variables>
		<variables name="Alm_FailStart" typeName="T_Alarm">
			<comment>No run feedback within Cfg_FbkTime</comment>
		</variables>
		<variables name="Alm_FailStop" typeName="T_Alarm">
			<comment>Run feedback still present after stop</comment>
		</variables>
		<variables name="Alm_Uncmd" typeName="T_Alarm">
			<comment>Running without a command</comment>
		</variables>
		<variables name="Alm_EStop" typeName="T_Alarm">
			<comment>E-stop activated</comment>
		</variables>
		<variables name="Alm_IntlkTrip" typeName="T_Alarm">
			<comment>Tripped by interlock</comment>
		</variables>
		<variables name="Alm_ExcessStarts" typeName="T_Alarm">
			<comment>Start blocked: Cfg_MaxStartsHr exceeded</comment>
		</variables>
		<variables name="Alm_OL" typeName="T_Alarm">
			<comment>Overload trip</comment>
		</variables>
		<variables name="Alm_HiCurrent" typeName="T_AlmLim">
			<comment>High current (A)</comment>
		</variables>
		<variables name="Run" typeName="T_RunTime">
			<comment>Run hours / starts</comment>
		</variables>
	</structure>
</DDTSource>
