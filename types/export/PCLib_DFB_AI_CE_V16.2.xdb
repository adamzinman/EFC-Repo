<FBExchangeFile>
<fileHeader company="Schneider Automation" product="EcoStruxure Control Expert Classic V16.2" dateTime="date_and_time#2026-10-20-14:49:5" content="Function Block source file" DTDVersion="41"></fileHeader>
<contentHeader name="PCLib" version="1.00"></contentHeader>
<DDTSource DDTName="T_Alarm" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Discrete alarm, ISA-18.2 / IEC 62682 state model, shelving, suppression, out-of-service</comment>
	<structure>
		<variables name="Inp_Cond" typeName="BOOL">
			<comment>Raw alarm condition (written by owner logic)</comment>
		</variables>
		<variables name="Inp_Suppress" typeName="BOOL">
			<comment>Suppressed-by-design: state-based suppression by logic (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Cfg_En" typeName="BOOL">
			<comment>Alarm configured (FALSE = not an alarm, e.g. instrument not fitted)</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="Cfg_Latch" typeName="BOOL">
			<comment>Latching alarm: active until Cmd_Reset after RTN (ISA-18.2 state E)</comment>
		</variables>
		<variables name="Cfg_NoAck" typeName="BOOL">
			<comment>No acknowledge required - use only for alarms rationalised as such</comment>
		</variables>
		<variables name="Cfg_OnDly" typeName="TIME">
			<comment>On-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_OffDly" typeName="TIME">
			<comment>Off-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_Priority" typeName="INT">
			<comment>Rationalised priority: 1=Critical 2=High 3=Medium 4=Low</comment>
			<variableInit value="3"></variableInit>
		</variables>
		<variables name="Cfg_Class" typeName="INT">
			<comment>Alarm class (alarm philosophy): 0=General 1=Safety 2=Environmental 3=Quality 4=Asset</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_MaxShelf" typeName="TIME">
			<comment>Maximum shelve duration (shelving must be time-limited)</comment>
			<variableInit value="T#8H"></variableInit>
		</variables>
		<variables name="Cmd_Ack" typeName="BOOL">
			<comment>Operator acknowledge (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Reset latched alarm (one-shot)</comment>
		</variables>
		<variables name="Cmd_Shelve" typeName="BOOL">
			<comment>Operator shelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_Unshelve" typeName="BOOL">
			<comment>Operator unshelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_RemoveSvc" typeName="BOOL">
			<comment>Remove from service for maintenance (one-shot, permit required)</comment>
		</variables>
		<variables name="Cmd_ReturnSvc" typeName="BOOL">
			<comment>Return to service (one-shot)</comment>
		</variables>
		<variables name="Sts_Active" typeName="BOOL">
			<comment>Alarm active (after delays and latch)</comment>
		</variables>
		<variables name="Sts_Unack" typeName="BOOL">
			<comment>Alarm unacknowledged</comment>
		</variables>
		<variables name="Sts_Shelved" typeName="BOOL">
			<comment>Shelved by operator (ISA-18.2 state F)</comment>
		</variables>
		<variables name="Sts_Suppressed" typeName="BOOL">
			<comment>Suppressed by design (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Sts_OOS" typeName="BOOL">
			<comment>Out of service (ISA-18.2 state H)</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service</comment>
		</variables>
		<variables name="Sts_ShelfLeft" typeName="TIME">
			<comment>Shelve time remaining</comment>
		</variables>
		<variables name="Val_Count" typeName="UDINT">
			<comment>Activation counter (alarm performance KPIs)</comment>
		</variables>
		<variables name="Val_LastActive" typeName="DT">
			<comment>Date/time of last activation</comment>
		</variables>
		<variables name="Val_LastRTN" typeName="DT">
			<comment>Date/time of last return to normal</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_AlmLim" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Analog limit alarm: limit + deadband + ISA-18.2 / IEC 62682 alarm</comment>
	<structure>
		<variables name="Cfg_Lim" typeName="REAL">
			<comment>Alarm limit (EU) - from rationalisation / master alarm database</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_DB" typeName="REAL">
			<comment>Deadband for return to normal (EU, ISA-18.2 chattering control)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Inp_Cond" typeName="BOOL">
			<comment>Raw alarm condition (written by owner logic)</comment>
		</variables>
		<variables name="Inp_Suppress" typeName="BOOL">
			<comment>Suppressed-by-design: state-based suppression by logic (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Cfg_En" typeName="BOOL">
			<comment>Alarm enabled - set TRUE once Cfg_Lim is rationalised</comment>
		</variables>
		<variables name="Cfg_Latch" typeName="BOOL">
			<comment>Latching alarm: active until Cmd_Reset after RTN (ISA-18.2 state E)</comment>
		</variables>
		<variables name="Cfg_NoAck" typeName="BOOL">
			<comment>No acknowledge required - use only for alarms rationalised as such</comment>
		</variables>
		<variables name="Cfg_OnDly" typeName="TIME">
			<comment>On-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_OffDly" typeName="TIME">
			<comment>Off-delay (ISA-18.2 chattering control)</comment>
			<variableInit value="T#0S"></variableInit>
		</variables>
		<variables name="Cfg_Priority" typeName="INT">
			<comment>Rationalised priority: 1=Critical 2=High 3=Medium 4=Low</comment>
			<variableInit value="3"></variableInit>
		</variables>
		<variables name="Cfg_Class" typeName="INT">
			<comment>Alarm class (alarm philosophy): 0=General 1=Safety 2=Environmental 3=Quality 4=Asset</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_MaxShelf" typeName="TIME">
			<comment>Maximum shelve duration (shelving must be time-limited)</comment>
			<variableInit value="T#8H"></variableInit>
		</variables>
		<variables name="Cmd_Ack" typeName="BOOL">
			<comment>Operator acknowledge (one-shot)</comment>
		</variables>
		<variables name="Cmd_Reset" typeName="BOOL">
			<comment>Reset latched alarm (one-shot)</comment>
		</variables>
		<variables name="Cmd_Shelve" typeName="BOOL">
			<comment>Operator shelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_Unshelve" typeName="BOOL">
			<comment>Operator unshelve (one-shot)</comment>
		</variables>
		<variables name="Cmd_RemoveSvc" typeName="BOOL">
			<comment>Remove from service for maintenance (one-shot, permit required)</comment>
		</variables>
		<variables name="Cmd_ReturnSvc" typeName="BOOL">
			<comment>Return to service (one-shot)</comment>
		</variables>
		<variables name="Sts_Active" typeName="BOOL">
			<comment>Alarm active (after delays and latch)</comment>
		</variables>
		<variables name="Sts_Unack" typeName="BOOL">
			<comment>Alarm unacknowledged</comment>
		</variables>
		<variables name="Sts_Shelved" typeName="BOOL">
			<comment>Shelved by operator (ISA-18.2 state F)</comment>
		</variables>
		<variables name="Sts_Suppressed" typeName="BOOL">
			<comment>Suppressed by design (ISA-18.2 state G)</comment>
		</variables>
		<variables name="Sts_OOS" typeName="BOOL">
			<comment>Out of service (ISA-18.2 state H)</comment>
		</variables>
		<variables name="Sts_State" typeName="INT">
			<comment>0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service</comment>
		</variables>
		<variables name="Sts_ShelfLeft" typeName="TIME">
			<comment>Shelve time remaining</comment>
		</variables>
		<variables name="Val_Count" typeName="UDINT">
			<comment>Activation counter (alarm performance KPIs)</comment>
		</variables>
		<variables name="Val_LastActive" typeName="DT">
			<comment>Date/time of last activation</comment>
		</variables>
		<variables name="Val_LastRTN" typeName="DT">
			<comment>Date/time of last return to normal</comment>
		</variables>
	</structure>
</DDTSource>
<DDTSource DDTName="T_AI" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Analog input: scaling, filtering, NE43 range check, alarms, sim</comment>
	<structure>
		<variables name="Cfg_Tag" typeName="STRING[20]">
			<comment>Equipment / instrument tag, e.g. FT-101</comment>
		</variables>
		<variables name="Cfg_Desc" typeName="STRING[40]">
			<comment>Description shown on HMI faceplate</comment>
		</variables>
		<variables name="Cfg_EU" typeName="STRING[12]">
			<comment>Engineering units text</comment>
		</variables>
		<variables name="Inp_Raw" typeName="INT">
			<comment>Raw counts from analog channel</comment>
		</variables>
		<variables name="Inp_ChFault" typeName="BOOL">
			<comment>Channel / module diagnostic fault</comment>
		</variables>
		<variables name="Cfg_RawMin" typeName="INT">
			<comment>Raw counts at 0% (M340/M580 4-20mA default 0)</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_RawMax" typeName="INT">
			<comment>Raw counts at 100% (M340/M580 4-20mA default 10000)</comment>
			<variableInit value="10000"></variableInit>
		</variables>
		<variables name="Cfg_EUMin" typeName="REAL">
			<comment>PV at 0% (EU)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_EUMax" typeName="REAL">
			<comment>PV at 100% (EU)</comment>
			<variableInit value="100.0"></variableInit>
		</variables>
		<variables name="Cfg_FiltTC" typeName="REAL">
			<comment>1st-order filter time constant (s), 0 = off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_SqrtExtract" typeName="BOOL">
			<comment>Square-root extraction (DP flow)</comment>
		</variables>
		<variables name="Cfg_LoCutoff" typeName="REAL">
			<comment>Low cutoff (% span): PV forced to EUMin below this, 0 = off</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Cfg_BadLoPct" typeName="REAL">
			<comment>Bad below this % span (NE43 3.6mA = -2.5%)</comment>
			<variableInit value="-2.5"></variableInit>
		</variables>
		<variables name="Cfg_BadHiPct" typeName="REAL">
			<comment>Bad above this % span (NE43 21mA = 106.25%)</comment>
			<variableInit value="106.25"></variableInit>
		</variables>
		<variables name="Cfg_BadAction" typeName="INT">
			<comment>On bad PV: 0=Hold last good 1=Substitute 2=EUMin 3=EUMax</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Cfg_SubstPV" typeName="REAL">
			<comment>Substitute PV used when Cfg_BadAction = 1</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Sim_En" typeName="BOOL">
			<comment>Simulation enabled</comment>
		</variables>
		<variables name="Sim_PV" typeName="REAL">
			<comment>Simulated PV (EU)</comment>
			<variableInit value="0.0"></variableInit>
		</variables>
		<variables name="Val_PV" typeName="REAL">
			<comment>Process value (EU) - use this in logic</comment>
		</variables>
		<variables name="Val_PVPct" typeName="REAL">
			<comment>Process value (% of span)</comment>
		</variables>
		<variables name="Val_ROC" typeName="REAL">
			<comment>Rate of change (EU/s, 1 s window) - input to Alm_ROC</comment>
		</variables>
		<variables name="Sts_Bad" typeName="BOOL">
			<comment>PV bad (out of range or channel fault)</comment>
		</variables>
		<variables name="Sts_URng" typeName="BOOL">
			<comment>Under range</comment>
		</variables>
		<variables name="Sts_ORng" typeName="BOOL">
			<comment>Over range</comment>
		</variables>
		<variables name="Sts_Sim" typeName="BOOL">
			<comment>Simulation active</comment>
		</variables>
		<variables name="Sts_Subst" typeName="BOOL">
			<comment>Substitute / held value in use</comment>
		</variables>
		<variables name="Sts_Quality" typeName="INT">
			<comment>0=Good 1=Uncertain (simulation, NE107 C or S) 2=Bad</comment>
		</variables>
		<variables name="Inp_NE107" typeName="INT">
			<comment>NE107 status reported by smart device (HART / fieldbus)</comment>
			<variableInit value="0"></variableInit>
		</variables>
		<variables name="Sts_NE107" typeName="INT">
			<comment>NAMUR NE107 status: 0=Good 1=Failure (F) 2=Function check (C) 3=Out of specification (S) 4=Maintenance required (M)</comment>
		</variables>
		<variables name="Alm_HH" typeName="T_AlmLim">
			<comment>High-high alarm</comment>
		</variables>
		<variables name="Alm_H" typeName="T_AlmLim">
			<comment>High alarm</comment>
		</variables>
		<variables name="Alm_L" typeName="T_AlmLim">
			<comment>Low alarm</comment>
		</variables>
		<variables name="Alm_LL" typeName="T_AlmLim">
			<comment>Low-low alarm</comment>
		</variables>
		<variables name="Alm_ROC" typeName="T_AlmLim">
			<comment>Rate-of-change alarm (Cfg_Lim in EU/s)</comment>
		</variables>
		<variables name="Alm_Bad" typeName="T_Alarm">
			<comment>Bad PV alarm</comment>
		</variables>
	</structure>
</DDTSource>
<FBSource nameOfFBType="FB_AlmCore" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>ISA-18.2 / IEC 62682 alarm state machine: chattering delays, latching, acknowledge, time-limited shelving, suppression, out-of-service</comment>
	<inputParameters>
		<variables name="Cond" typeName="BOOL">
			<comment>Raw alarm condition</comment>
			<attribute name="PositionPin" value="1"></attribute>
		</variables>
		<variables name="Supp" typeName="BOOL">
			<comment>Suppressed by design (logic)</comment>
			<attribute name="PositionPin" value="2"></attribute>
		</variables>
		<variables name="Enabled" typeName="BOOL">
			<comment>Alarm configured / enabled</comment>
			<attribute name="PositionPin" value="3"></attribute>
		</variables>
		<variables name="LatchCfg" typeName="BOOL">
			<comment>Latching alarm</comment>
			<attribute name="PositionPin" value="4"></attribute>
		</variables>
		<variables name="NoAck" typeName="BOOL">
			<comment>No acknowledge required</comment>
			<attribute name="PositionPin" value="5"></attribute>
		</variables>
		<variables name="OnDly" typeName="TIME">
			<comment>On-delay</comment>
			<attribute name="PositionPin" value="6"></attribute>
		</variables>
		<variables name="OffDly" typeName="TIME">
			<comment>Off-delay</comment>
			<attribute name="PositionPin" value="7"></attribute>
		</variables>
		<variables name="MaxShelf" typeName="TIME">
			<comment>Maximum shelve time</comment>
			<attribute name="PositionPin" value="8"></attribute>
		</variables>
		<variables name="Ack" typeName="BOOL">
			<comment>Acknowledge command</comment>
			<attribute name="PositionPin" value="9"></attribute>
		</variables>
		<variables name="Rst" typeName="BOOL">
			<comment>Reset latched alarm command</comment>
			<attribute name="PositionPin" value="10"></attribute>
		</variables>
		<variables name="Shelve" typeName="BOOL">
			<comment>Shelve command</comment>
			<attribute name="PositionPin" value="11"></attribute>
		</variables>
		<variables name="Unshelve" typeName="BOOL">
			<comment>Unshelve command</comment>
			<attribute name="PositionPin" value="12"></attribute>
		</variables>
		<variables name="RemoveSvc" typeName="BOOL">
			<comment>Remove from service command</comment>
			<attribute name="PositionPin" value="13"></attribute>
		</variables>
		<variables name="ReturnSvc" typeName="BOOL">
			<comment>Return to service command</comment>
			<attribute name="PositionPin" value="14"></attribute>
		</variables>
	</inputParameters>
	<outputParameters>
		<variables name="Active" typeName="BOOL">
			<comment>Alarm active (annunciated)</comment>
			<attribute name="PositionPin" value="15"></attribute>
		</variables>
		<variables name="Unack" typeName="BOOL">
			<comment>Unacknowledged</comment>
			<attribute name="PositionPin" value="16"></attribute>
		</variables>
		<variables name="Shelved" typeName="BOOL">
			<comment>Shelved</comment>
			<attribute name="PositionPin" value="17"></attribute>
		</variables>
		<variables name="Suppressed" typeName="BOOL">
			<comment>Suppressed by design</comment>
			<attribute name="PositionPin" value="18"></attribute>
		</variables>
		<variables name="OOS" typeName="BOOL">
			<comment>Out of service</comment>
			<attribute name="PositionPin" value="19"></attribute>
		</variables>
		<variables name="State" typeName="INT">
			<comment>0=A Normal 1=B Unack 2=C Acked 3=D RTN-Unack 4=E Latched 5=F Shelved 6=G Suppressed-by-design 7=H Out-of-service</comment>
			<attribute name="PositionPin" value="20"></attribute>
		</variables>
		<variables name="ShelfLeft" typeName="TIME">
			<comment>Shelve time remaining</comment>
			<attribute name="PositionPin" value="21"></attribute>
		</variables>
		<variables name="EvtActive" typeName="BOOL">
			<comment>Pulse: alarm became active</comment>
			<attribute name="PositionPin" value="22"></attribute>
		</variables>
		<variables name="EvtRTN" typeName="BOOL">
			<comment>Pulse: alarm returned to normal</comment>
			<attribute name="PositionPin" value="23"></attribute>
		</variables>
	</outputParameters>
	<privateLocalVariables>
		<variables name="xOOS" typeName="BOOL">
			<comment>Out-of-service memory</comment>
		</variables>
		<variables name="xShelved" typeName="BOOL">
			<comment>Shelved memory</comment>
		</variables>
		<variables name="xInhibit" typeName="BOOL">
			<comment>Alarm inhibited (OOS, shelved, suppressed, disabled)</comment>
		</variables>
		<variables name="xCond" typeName="BOOL">
			<comment>Condition after on/off delays</comment>
		</variables>
		<variables name="xLatch" typeName="BOOL">
			<comment>Latched memory</comment>
		</variables>
		<variables name="xActive" typeName="BOOL">
			<comment>Active</comment>
		</variables>
		<variables name="xUnack" typeName="BOOL">
			<comment>Unacknowledged memory</comment>
		</variables>
		<variables name="tonShelf" typeName="TON">
			<comment>Shelve timer</comment>
		</variables>
		<variables name="tonOn" typeName="TON">
			<comment>On-delay timer</comment>
		</variables>
		<variables name="tofOff" typeName="TOF">
			<comment>Off-delay timer</comment>
		</variables>
		<variables name="rtActive" typeName="R_TRIG">
			<comment>Active rising edge</comment>
		</variables>
		<variables name="ftActive" typeName="F_TRIG">
			<comment>Active falling edge</comment>
		</variables>
	</privateLocalVariables>
	<FBProgram name="Main">
		<STSource>(* ---- Out of service (ISA-18.2 state H) ---- *)
IF RemoveSvc THEN
    xOOS := TRUE;
END_IF;
IF ReturnSvc THEN
    xOOS := FALSE;
END_IF;

(* ---- Shelving (ISA-18.2 state F), always time-limited ---- *)
IF Shelve AND Enabled AND NOT xOOS THEN
    xShelved := TRUE;
END_IF;
IF Unshelve OR xOOS OR NOT Enabled THEN
    xShelved := FALSE;
END_IF;
tonShelf(IN := xShelved, PT := MaxShelf);
IF tonShelf.Q THEN
    xShelved := FALSE;
END_IF;
IF xShelved THEN
    ShelfLeft := MaxShelf - tonShelf.ET;
ELSE
    ShelfLeft := T#0S;
END_IF;

xInhibit := xOOS OR xShelved OR Supp OR NOT Enabled;

(* ---- Chattering control: on-delay / off-delay ---- *)
tonOn(IN := Cond AND NOT xInhibit, PT := OnDly);
tofOff(IN := tonOn.Q, PT := OffDly);
xCond := tofOff.Q AND NOT xInhibit;

(* ---- Latching (ISA-18.2 state E): reset only after return to normal ---- *)
IF xInhibit OR NOT LatchCfg THEN
    xLatch := FALSE;
ELSIF xCond THEN
    xLatch := TRUE;
ELSIF Rst THEN
    xLatch := FALSE;
END_IF;

xActive := xCond OR xLatch;

(* ---- Annunciation and acknowledge ---- *)
rtActive(CLK := xActive);
ftActive(CLK := xActive);
IF rtActive.Q AND NOT NoAck THEN
    xUnack := TRUE;
END_IF;
IF Ack OR xInhibit OR NoAck THEN
    xUnack := FALSE;
END_IF;

(* ---- State per ISA-18.2 / IEC 62682 state model ---- *)
IF xOOS OR NOT Enabled THEN
    State := 7;
ELSIF Supp THEN
    State := 6;
ELSIF xShelved THEN
    State := 5;
ELSIF xLatch AND NOT xCond THEN
    State := 4;
ELSIF xActive AND xUnack THEN
    State := 1;
ELSIF xActive THEN
    State := 2;
ELSIF xUnack THEN
    State := 3;
ELSE
    State := 0;
END_IF;

Active := xActive;
Unack := xUnack;
Shelved := xShelved;
Suppressed := Supp AND Enabled AND NOT xOOS;
OOS := xOOS;
EvtActive := rtActive.Q;
EvtRTN := ftActive.Q AND NOT xInhibit;</STSource>
	</FBProgram>
</FBSource>
<FBSource nameOfFBType="FB_Alarm" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Discrete alarm for a T_Alarm. Owner logic writes Alm.Inp_Cond before the call</comment>
	<inputParameters>
		<variables name="SuppressIn" typeName="BOOL">
			<comment>Additional design suppression from owner logic</comment>
			<attribute name="PositionPin" value="1"></attribute>
		</variables>
	</inputParameters>
	<inOutParameters>
		<variables name="Alm" typeName="T_Alarm">
			<comment>Alarm object</comment>
			<attribute name="PositionPin" value="2"></attribute>
		</variables>
	</inOutParameters>
	<privateLocalVariables>
		<variables name="fbCore" typeName="FB_AlmCore">
			<comment>Alarm state machine</comment>
		</variables>
	</privateLocalVariables>
	<FBProgram name="Main">
		<STSource>fbCore(Cond := Alm.Inp_Cond,
       Supp := Alm.Inp_Suppress OR SuppressIn,
       Enabled := Alm.Cfg_En,
       LatchCfg := Alm.Cfg_Latch,
       NoAck := Alm.Cfg_NoAck,
       OnDly := Alm.Cfg_OnDly,
       OffDly := Alm.Cfg_OffDly,
       MaxShelf := Alm.Cfg_MaxShelf,
       Ack := Alm.Cmd_Ack,
       Rst := Alm.Cmd_Reset,
       Shelve := Alm.Cmd_Shelve,
       Unshelve := Alm.Cmd_Unshelve,
       RemoveSvc := Alm.Cmd_RemoveSvc,
       ReturnSvc := Alm.Cmd_ReturnSvc);

Alm.Sts_Active := fbCore.Active;
Alm.Sts_Unack := fbCore.Unack;
Alm.Sts_Shelved := fbCore.Shelved;
Alm.Sts_Suppressed := fbCore.Suppressed;
Alm.Sts_OOS := fbCore.OOS;
Alm.Sts_State := fbCore.State;
Alm.Sts_ShelfLeft := fbCore.ShelfLeft;

(* ---- Alarm performance data (ISA-18.2 monitoring) ---- *)
IF fbCore.EvtActive THEN
    Alm.Val_Count := Alm.Val_Count + 1;
    RRTC_DT(OUT =&gt; Alm.Val_LastActive);
END_IF;
IF fbCore.EvtRTN THEN
    RRTC_DT(OUT =&gt; Alm.Val_LastRTN);
END_IF;

(* ---- Operator commands are one-shot: clear after use ---- *)
Alm.Cmd_Ack := FALSE;
Alm.Cmd_Reset := FALSE;
Alm.Cmd_Shelve := FALSE;
Alm.Cmd_Unshelve := FALSE;
Alm.Cmd_RemoveSvc := FALSE;
Alm.Cmd_ReturnSvc := FALSE;</STSource>
	</FBProgram>
</FBSource>
<FBSource nameOfFBType="FB_AlmLim" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Limit alarm for a T_AlmLim: high or low limit with deadband, ISA-18.2 state machine</comment>
	<inputParameters>
		<variables name="PV" typeName="REAL">
			<comment>Value compared with Alm.Cfg_Lim (EU)</comment>
			<attribute name="PositionPin" value="1"></attribute>
		</variables>
		<variables name="IsHigh" typeName="BOOL">
			<comment>TRUE = high alarm (PV above limit), FALSE = low alarm</comment>
			<attribute name="PositionPin" value="2"></attribute>
		</variables>
		<variables name="SuppressIn" typeName="BOOL">
			<comment>Additional design suppression from owner logic (e.g. bad PV)</comment>
			<attribute name="PositionPin" value="3"></attribute>
		</variables>
	</inputParameters>
	<inOutParameters>
		<variables name="Alm" typeName="T_AlmLim">
			<comment>Limit alarm object</comment>
			<attribute name="PositionPin" value="4"></attribute>
		</variables>
	</inOutParameters>
	<privateLocalVariables>
		<variables name="fbCore" typeName="FB_AlmCore">
			<comment>Alarm state machine</comment>
		</variables>
		<variables name="xRaw" typeName="BOOL">
			<comment>Limit comparison with deadband</comment>
		</variables>
	</privateLocalVariables>
	<FBProgram name="Main">
		<STSource>(* ---- Limit comparison with deadband (ISA-18.2 chattering control) ---- *)
IF IsHigh THEN
    IF PV &gt; Alm.Cfg_Lim THEN
        xRaw := TRUE;
    ELSIF PV &lt;= Alm.Cfg_Lim - Alm.Cfg_DB THEN
        xRaw := FALSE;
    END_IF;
ELSE
    IF PV &lt; Alm.Cfg_Lim THEN
        xRaw := TRUE;
    ELSIF PV &gt;= Alm.Cfg_Lim + Alm.Cfg_DB THEN
        xRaw := FALSE;
    END_IF;
END_IF;
Alm.Inp_Cond := xRaw;

fbCore(Cond := Alm.Inp_Cond,
       Supp := Alm.Inp_Suppress OR SuppressIn,
       Enabled := Alm.Cfg_En,
       LatchCfg := Alm.Cfg_Latch,
       NoAck := Alm.Cfg_NoAck,
       OnDly := Alm.Cfg_OnDly,
       OffDly := Alm.Cfg_OffDly,
       MaxShelf := Alm.Cfg_MaxShelf,
       Ack := Alm.Cmd_Ack,
       Rst := Alm.Cmd_Reset,
       Shelve := Alm.Cmd_Shelve,
       Unshelve := Alm.Cmd_Unshelve,
       RemoveSvc := Alm.Cmd_RemoveSvc,
       ReturnSvc := Alm.Cmd_ReturnSvc);

Alm.Sts_Active := fbCore.Active;
Alm.Sts_Unack := fbCore.Unack;
Alm.Sts_Shelved := fbCore.Shelved;
Alm.Sts_Suppressed := fbCore.Suppressed;
Alm.Sts_OOS := fbCore.OOS;
Alm.Sts_State := fbCore.State;
Alm.Sts_ShelfLeft := fbCore.ShelfLeft;

(* ---- Alarm performance data (ISA-18.2 monitoring) ---- *)
IF fbCore.EvtActive THEN
    Alm.Val_Count := Alm.Val_Count + 1;
    RRTC_DT(OUT =&gt; Alm.Val_LastActive);
END_IF;
IF fbCore.EvtRTN THEN
    RRTC_DT(OUT =&gt; Alm.Val_LastRTN);
END_IF;

(* ---- Operator commands are one-shot: clear after use ---- *)
Alm.Cmd_Ack := FALSE;
Alm.Cmd_Reset := FALSE;
Alm.Cmd_Shelve := FALSE;
Alm.Cmd_Unshelve := FALSE;
Alm.Cmd_RemoveSvc := FALSE;
Alm.Cmd_ReturnSvc := FALSE;</STSource>
	</FBProgram>
</FBSource>
<FBSource nameOfFBType="FB_AI" version="1.00" dateTime="dt#2026-10-20-14:49:05">
	<comment>Analog input for a T_AI: scaling, square root, low cut-off, NAMUR NE43 range check, NE107 status, filter, bad-value action, simulation, rate of change, ISA-18.2 alarms</comment>
	<inOutParameters>
		<variables name="AI" typeName="T_AI">
			<comment>Analog input object</comment>
			<attribute name="PositionPin" value="1"></attribute>
		</variables>
	</inOutParameters>
	<outputParameters>
		<variables name="PV" typeName="REAL">
			<comment>Process value (EU) = AI.Val_PV</comment>
			<attribute name="PositionPin" value="2"></attribute>
		</variables>
		<variables name="Bad" typeName="BOOL">
			<comment>PV bad = AI.Sts_Bad</comment>
			<attribute name="PositionPin" value="3"></attribute>
		</variables>
	</outputParameters>
	<privateLocalVariables>
		<variables name="xFirst" typeName="BOOL">
			<comment>First scan after cold / warm start</comment>
			<variableInit value="TRUE"></variableInit>
		</variables>
		<variables name="tonClk" typeName="TON">
			<comment>Free-running clock for elapsed time</comment>
		</variables>
		<variables name="xClkRst" typeName="BOOL">
			<comment>Clock restart</comment>
		</variables>
		<variables name="tClkLast" typeName="TIME">
			<comment>Clock value on previous scan</comment>
		</variables>
		<variables name="tDelta" typeName="TIME">
			<comment>Time since previous scan</comment>
		</variables>
		<variables name="rDt" typeName="REAL">
			<comment>Time since previous scan (s)</comment>
		</variables>
		<variables name="xRawErr" typeName="BOOL">
			<comment>Raw span not configured</comment>
		</variables>
		<variables name="xEUErr" typeName="BOOL">
			<comment>EU span not configured</comment>
		</variables>
		<variables name="rPctRaw" typeName="REAL">
			<comment>Signal in % of span, before characterisation</comment>
		</variables>
		<variables name="rPct" typeName="REAL">
			<comment>Signal in % of span, after characterisation</comment>
		</variables>
		<variables name="rEU" typeName="REAL">
			<comment>Unfiltered PV (EU)</comment>
		</variables>
		<variables name="rFilt" typeName="REAL">
			<comment>Filtered PV (EU)</comment>
		</variables>
		<variables name="rOut" typeName="REAL">
			<comment>Final PV (EU)</comment>
		</variables>
		<variables name="rLastGood" typeName="REAL">
			<comment>Last good PV (EU)</comment>
		</variables>
		<variables name="xFieldBad" typeName="BOOL">
			<comment>Field signal bad (ignores simulation)</comment>
		</variables>
		<variables name="xBad" typeName="BOOL">
			<comment>PV bad</comment>
		</variables>
		<variables name="xBadPrev" typeName="BOOL">
			<comment>PV bad on previous scan</comment>
		</variables>
		<variables name="xSimPrev" typeName="BOOL">
			<comment>Simulation on previous scan</comment>
		</variables>
		<variables name="xReinit" typeName="BOOL">
			<comment>Re-initialise filter and rate of change this scan</comment>
		</variables>
		<variables name="tRocAcc" typeName="TIME">
			<comment>Rate-of-change window time</comment>
		</variables>
		<variables name="rRocRef" typeName="REAL">
			<comment>PV at start of rate-of-change window</comment>
		</variables>
		<variables name="rRoc" typeName="REAL">
			<comment>Rate of change (EU/s)</comment>
		</variables>
		<variables name="fbHH" typeName="FB_AlmLim">
			<comment>High-high alarm</comment>
		</variables>
		<variables name="fbH" typeName="FB_AlmLim">
			<comment>High alarm</comment>
		</variables>
		<variables name="fbL" typeName="FB_AlmLim">
			<comment>Low alarm</comment>
		</variables>
		<variables name="fbLL" typeName="FB_AlmLim">
			<comment>Low-low alarm</comment>
		</variables>
		<variables name="fbROC" typeName="FB_AlmLim">
			<comment>Rate-of-change alarm</comment>
		</variables>
		<variables name="fbBad" typeName="FB_Alarm">
			<comment>Bad PV alarm</comment>
		</variables>
	</privateLocalVariables>
	<FBProgram name="Main">
		<STSource>(* ===== 1. Elapsed time since previous scan (free-running TON, restarts hourly) ===== *)
tonClk(IN := NOT xClkRst, PT := T#1H);
xClkRst := tonClk.Q;
IF tonClk.ET &gt;= tClkLast THEN
    tDelta := tonClk.ET - tClkLast;
ELSE
    tDelta := T#0S;
END_IF;
tClkLast := tonClk.ET;
rDt := DINT_TO_REAL(TIME_TO_DINT(tDelta)) * 0.001;

(* ===== 2. Configuration check ===== *)
xRawErr := AI.Cfg_RawMax = AI.Cfg_RawMin;
xEUErr := AI.Cfg_EUMax = AI.Cfg_EUMin;

(* ===== 3. Raw counts to % of span ===== *)
IF NOT xRawErr THEN
    rPctRaw := (INT_TO_REAL(AI.Inp_Raw) - INT_TO_REAL(AI.Cfg_RawMin)) * 100.0
               / (INT_TO_REAL(AI.Cfg_RawMax) - INT_TO_REAL(AI.Cfg_RawMin));
ELSE
    rPctRaw := 0.0;
END_IF;

(* ===== 4. Signal validation: NAMUR NE43 limits, channel and device diagnostics ===== *)
AI.Sts_URng := rPctRaw &lt; AI.Cfg_BadLoPct;
AI.Sts_ORng := rPctRaw &gt; AI.Cfg_BadHiPct;
xFieldBad := AI.Sts_URng OR AI.Sts_ORng OR AI.Inp_ChFault OR (AI.Inp_NE107 = 1)
             OR xRawErr OR xEUErr;

(* ===== 5. Characterisation: square root extraction, low cut-off ===== *)
rPct := rPctRaw;
IF AI.Cfg_SqrtExtract THEN
    IF rPct &gt; 0.0 THEN
        rPct := SQRT(rPct * 0.01) * 100.0;
    ELSE
        rPct := 0.0;
    END_IF;
END_IF;
IF (AI.Cfg_LoCutoff &gt; 0.0) AND (rPct &lt; AI.Cfg_LoCutoff) THEN
    rPct := 0.0;
END_IF;
rEU := AI.Cfg_EUMin + rPct * 0.01 * (AI.Cfg_EUMax - AI.Cfg_EUMin);

(* ===== 6. Simulation replaces the field signal ===== *)
AI.Sts_Sim := AI.Sim_En;
IF AI.Sim_En THEN
    rEU := AI.Sim_PV;
    xBad := FALSE;
ELSE
    xBad := xFieldBad;
END_IF;

(* ===== 7. First-order filter, re-initialised on start, recovery or sim change ===== *)
xReinit := xFirst OR (xBadPrev AND NOT xBad) OR (AI.Sim_En &lt;&gt; xSimPrev);
IF xReinit OR (AI.Cfg_FiltTC &lt;= 0.0) THEN
    rFilt := rEU;
ELSIF NOT xBad AND (rDt &gt; 0.0) THEN
    rFilt := rFilt + (rEU - rFilt) * rDt / (AI.Cfg_FiltTC + rDt);
END_IF;
xBadPrev := xBad;
xSimPrev := AI.Sim_En;

(* ===== 8. Bad value action ===== *)
IF xBad THEN
    CASE AI.Cfg_BadAction OF
        1: rOut := AI.Cfg_SubstPV;
        2: rOut := AI.Cfg_EUMin;
        3: rOut := AI.Cfg_EUMax;
    ELSE
        rOut := rLastGood;
    END_CASE;
    AI.Sts_Subst := TRUE;
ELSE
    rOut := rFilt;
    rLastGood := rFilt;
    AI.Sts_Subst := FALSE;
END_IF;

AI.Val_PV := rOut;
AI.Sts_Bad := xBad;
IF NOT xEUErr THEN
    AI.Val_PVPct := (rOut - AI.Cfg_EUMin) * 100.0 / (AI.Cfg_EUMax - AI.Cfg_EUMin);
ELSE
    AI.Val_PVPct := 0.0;
END_IF;

(* ===== 9. Quality and NAMUR NE107 status ===== *)
IF xBad THEN
    AI.Sts_Quality := 2;
ELSIF AI.Sim_En OR (AI.Inp_NE107 = 2) OR (AI.Inp_NE107 = 3) THEN
    AI.Sts_Quality := 1;
ELSE
    AI.Sts_Quality := 0;
END_IF;

IF xBad THEN
    AI.Sts_NE107 := 1;                          (* F: failure *)
ELSIF AI.Sim_En OR (AI.Inp_NE107 = 2) THEN
    AI.Sts_NE107 := 2;                          (* C: function check, incl. simulation *)
ELSIF AI.Inp_NE107 = 3 THEN
    AI.Sts_NE107 := 3;                          (* S: out of specification *)
ELSIF AI.Inp_NE107 = 4 THEN
    AI.Sts_NE107 := 4;                          (* M: maintenance required *)
ELSE
    AI.Sts_NE107 := 0;                          (* good *)
END_IF;

(* ===== 10. Rate of change over a 1 s window (EU/s), no spike on recovery / sim change ===== *)
IF xReinit OR xBad THEN
    rRocRef := rOut;
    tRocAcc := T#0S;
    rRoc := 0.0;
ELSE
    tRocAcc := tRocAcc + tDelta;
    IF tRocAcc &gt;= T#1S THEN
        rRoc := (rOut - rRocRef) / (DINT_TO_REAL(TIME_TO_DINT(tRocAcc)) * 0.001);
        rRocRef := rOut;
        tRocAcc := T#0S;
    END_IF;
END_IF;
AI.Val_ROC := rRoc;

(* ===== 11. Alarms (ISA-18.2): process alarms suppressed by design while PV is bad ===== *)
fbHH(PV := rOut, IsHigh := TRUE, SuppressIn := xBad, Alm := AI.Alm_HH);
fbH(PV := rOut, IsHigh := TRUE, SuppressIn := xBad, Alm := AI.Alm_H);
fbL(PV := rOut, IsHigh := FALSE, SuppressIn := xBad, Alm := AI.Alm_L);
fbLL(PV := rOut, IsHigh := FALSE, SuppressIn := xBad, Alm := AI.Alm_LL);
fbROC(PV := ABS(rRoc), IsHigh := TRUE, SuppressIn := xBad, Alm := AI.Alm_ROC);

AI.Alm_Bad.Inp_Cond := xFieldBad AND NOT AI.Sim_En;
fbBad(SuppressIn := FALSE, Alm := AI.Alm_Bad);

(* ===== 12. Pins ===== *)
PV := rOut;
Bad := xBad;
xFirst := FALSE;</STSource>
	</FBProgram>
</FBSource>
</FBExchangeFile>
