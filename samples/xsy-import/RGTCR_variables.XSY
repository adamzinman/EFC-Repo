	<FBSource nameOfFBType="DFB_Analog_Input" version="0.45" dateTime="dt#2026-02-24-14:40:40">
		<attribute name="TypeCodeCheckSumString" value="8439"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="E289"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="Input" typeName="T_U_ANA_STD_CH_IN">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="PV" typeName="DDT_Process_Value">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="Raw_Value" typeName="INT">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
			<variables name="Eng_Value" typeName="REAL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="Overrange" typeName="BOOL"></variables>
			<variables name="Underrange" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="M" typeName="REAL"></variables>
		</privateLocalVariables>
		<FBProgram name="Logic">
			<STSource>M := (PV.Eng_Max-PV.Eng_Min) / INT_TO_REAL(PV.Raw_Max-PV.Raw_Min);
PV.PV := (M * INT_TO_REAL(Input.ANA.VALUE-PV.Raw_Min))+PV.Eng_Min;

(* Prevents Raw Max causing a Divide by zero *)
IF PV.Raw_Max = 0 THEN
	PV.Raw_Max := 10000;
END_IF;

(* Prevents Engineering Scale from causing a Divide by 0*)
IF PV.Eng_Max = 0.0 THEN
	PV.Eng_Max := 100.0;
END_IF;


IF Input.ANA.VALUE = -800 THEN
	PV.PV := PV.Eng_Min - 0.999;
ELSIF Input.ANA.Value = 10800 THEN
	PV.PV := PV.Eng_Max + 0.999;
END_IF;

Raw_Value := Input.ANA.VALUE;
Eng_Value := PV.PV;
</STSource>
		</FBProgram>
