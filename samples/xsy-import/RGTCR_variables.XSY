							<outputVariable invertedPin="false" formalParameter="ENO"></outputVariable>
							<outputVariable invertedPin="false" formalParameter="OUT" effectiveParameter="PV.Overrange"></outputVariable>
						</descriptionFFB>
					</FFBBlock>
					<FFBBlock instanceName=".4" typeName="OR" additionnalPinNumber="2" enEnO="false" width="7" height="8">
						<objPosition posX="54" posY="14"></objPosition>
