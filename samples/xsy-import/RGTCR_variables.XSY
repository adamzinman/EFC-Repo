			<variables name="ONS_Manual" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="O_DLY" typeName="TON">
				<instanceElementDesc name="PT">
					<value>t#1s</value>
				</instanceElementDesc>
			</variables>
			<variables name="C_DLY" typeName="TON"></variables>
			<variables name="TON_0" typeName="TON"></variables>
			<variables name="RS_0" typeName="RS"></variables>
			<variables name="AutoChangeTrig" typeName="R_TRIG"></variables>
			<variables name="ManChangeTrig" typeName="R_TRIG"></variables>
			<variables name="SeqOffTrig" typeName="R_TRIG"></variables>
		</privateLocalVariables>
		<FBProgram name="DataMapping">
			<STSource>(* Mapping Inputs to Station Vars *)
Station.PT := PT.PV;
Station.InletCMD	:= InletValve.CMD;
Station.SampleCMD	:= SampleValve.CMD;
Station.VacuumCMD	:= VacuumValve.CMD;
Station.GrossWeight	:= Scale.GrossWeight;
Station.TareWeight	:= Scale.TareWeight;
Station.NetWeight	:= Scale.NetWeight;

(* Mapping Outputs *)
InletValve.Req 	:= Station.InletREQ;
SampleValve.Req	:= Station.SampleREQ;
VacuumValve.Req	:= Station.VacuumREQ;

IF Station.TareCMD THEN
	Scale.TareCMD := TRUE;
	Station.TareCMD := FALSE;
END_IF;

IF Station.ZeroCMD THEN
	Scale.ZeroCMD := TRUE;
	Station.ZeroCMD := FALSE;
END_IF;




</STSource>
		</FBProgram>
		<FBProgram name="Monitoring">
			<STSource>AutoChangeTrig (CLK := Seq.Auto,
                Q =&gt; ONS_Auto);

ManChangeTrig (CLK := Seq.Manual,
                Q =&gt; ONS_Manual);
SeqOffTrig(CLK := NOT Seq.Running);

(* IF Seq.Auto AND NOT Seq.Running THEN
	Station.InletREQ := FALSE;
	Station.VacuumREQ := FALSE;
	Station.SampleREQ := FALSE;
END_IF; *)

(* Station Selected Logic *)
IF Station.HMI_Select AND NOT Station.Selected THEN
	Station.Selected := TRUE;
	Station.Disabled := FALSE;
	Station.HMI_Select := FALSE;
ELSIF Station.HMI_Select AND Station.Selected THEN
	Station.Selected := FALSE;
	Station.Disabled := TRUE;
	Station.HMI_Select := FALSE;
END_IF;

(* TOTAL TARGET WEIGHT CALC *)
Station.TotalWeight := Station.TargetWeight + Station.SampleWeight;

(* HIGH MAX PRESSURE WARNING *)
Station.HighPressWarningReq := Station.Selected AND Station.Press_Max &gt;= 2500.0;

Station.ScaleLoaded := Station.GrossWeight &gt; 0.002;
Station.ScaleTared := Station.TareWeight &gt; 0.002;

Station.Disconnecting	:= Station.HMI_Disc;

IF Estop OR NOT Station.Selected THEN
	Station.StatusEnum := 0; (* Disabled *)
	Station.ReadyToStart := FALSE;
	Station.ReadyToFill := FALSE;
	Station.Active := FALSE;
	Station.Pressurizing := FALSE;
	Station.Sampling := FALSE;
	Station.Complete := FALSE;
	Station.Failed := FALSE;
	Station.Filling := FALSE;
	Station.Msg := 'Station Disabled';
ELSIF Station.Selected THEN
	Station.ReadytoStart	:= Station.ScaleLoaded AND NOT Station.Complete AND NOT Station.Failed;
	Station.ReadytoFill 	:= Station.ReadytoStart AND Station.ScaleTared AND Station.NetWeight &lt;=0.005 AND Station.TargetWeight &gt; 0.0 AND Station.Press_Max &gt; 0.0;

	(* STATION ACTIVE MODES *)
	Station.Active 		:= (Station.ReadytoFill OR Station.Active) AND 
					Seq.State &gt;= 24000 AND NOT Station.Complete AND NOT Station.Failed;

	IF Station.Active AND Seq.State &gt;= 25000 AND NOT Station.Sampling AND Station.PT &lt; Station.SamplePress AND Station.NetWeight &lt;= Station.TargetWeight THEN
		Station.Pressurizing := TRUE;
	ELSIF NOT Station.Active OR Station.NetWeight &gt;= Station.TargetWeight OR (Station.Active AND Station.Pressurizing AND Station.PT &gt;= Station.SamplePress) THEN
		Station.Pressurizing := FALSE;
	END_IF;

(* 	Station.Pressurizing 	:= Station.Active AND NOT Station.Filling AND NOT Station.Sampling AND 
					Station.PT &lt; Station.SamplePress; *)

	IF Station.Active AND Seq.State &gt;= 25000 AND NOT Station.Sampling AND Station.NetWeight &lt;= Station.TotalWeight THEN
		Station.Filling := TRUE;
	ELSIF NOT Station.Active OR (Station.Filling AND Station.NetWeight &gt;= Station.TotalWeight) THEN
		Station.Filling := FALSE; 
	END_IF;

(* 	Station.Filling		:= Station.Active AND NOT Station.Pressurizing AND NOT Station.Sampling AND Station.NetWeight &lt; Station.TotalWeight; *)

	IF Station.Active AND Seq.State &gt;= 27100 AND NOT Station.Filling AND Station.NetWeight &gt;= Station.TotalWeight THEN
		Station.Sampling := TRUE;
	ELSIF Station.Active AND Station.Sampling AND Station.NetWeight &lt;= Station.TargetWeight + 0.001 THEN
		Station.Sampling := FALSE;
	END_IF;

(* 	Station.Sampling	:= Station.Active AND Seq.State &gt;= 25400 AND(
					(Station.Filling AND Station.NetWeight &gt;= Station.TotalWeight) OR
					(Station.Sampling AND Station.NetWeight &gt;= Station.TargetWeight + 0.002)); *)	


	(* FILL COMPLETE STATUS *)	
	IF Station.Active AND Seq.State &gt;= 27100 AND NOT Station.Sampling AND Station.NetWeight &gt;= Station.TargetWeight THEN (* THIS WONT WORK IF WE OVERDRAW TO THE SAMPLE BOTTLE *)
		Station.Complete := TRUE;
		Station.Msg := 'Fill Complete';
	END_IF;

	IF Station.Active AND Station.PT &gt;= Station.Press_Max THEN
		Station.Failed 		:= TRUE;
		Station.Active 		:= FALSE;
		Station.Sampling	:= FALSE;
		Station.Filling		:= FALSE;
		Station.Pressurizing	:= FALSE;
	END_IF;
END_IF;

IF Station.Complete THEN
	Station.Msg := 'Fill Complete';
ELSIF Station.Failed THEN
	Station.Msg := 'Fill Failure Due to High Press';
ELSIF Station.Venting THEN
	Station.Msg := 'Venting Station';
ELSIF Station.Vacuuming THEN
	Station.Msg := 'Vacuuming Station';
ELSIF Station.Sampling THEN
	Station.Msg := 'Sampling from Vessel';
ELSIF Station.Pressurizing THEN
	Station.Msg := 'Pressurizing Sample Line';
ELSIF Station.Filling THEN
	Station.Msg := 'Filling Vessel';
ELSIF Station.Disconnecting THEN
	Station.Msg := 'Disconnect Mode';
ELSIF Station.ReadyToFill THEN
	Station.Msg := 'Ready to Fill';
ELSIF Station.ReadyToStart THEN
	Station.Msg := 'Ready to Start';
ELSIF Station.Selected THEN
	Station.Msg := 'Station Selected';
ELSIF Station.Disabled THEN
	Station.Msg := 'Station Disabled';
END_IF;


IF Station.HMI_Reset THEN
	Station.HMI_Reset := FALSE;
	Scale.ResetScale := TRUE;
	Station.TargetWeight := 0.0;
	Station.Press_Max := 0.0;
	Station.SampleWeight := 0.0;
	Station.SamplePress := 0.0;
	Station.Selected := FALSE;
	Station.Failed := FALSE;
	Station.Complete := FALSE;
END_IF;

IF ONS_Auto OR ONS_Manual OR SeqOffTrig.Q THEN
	Station.InletREQ	:= FALSE;
	Station.SampleREQ	:= FALSE;
	Station.VacuumREQ	:= FALSE;
ELSIF Seq.Running THEN
	Station.InletREQ	:= (Station.InletREQ OR Upstream_PT.PV &gt;= Station.PT) AND NOT Seq.Paused AND (Station.Venting OR Station.Pressurizing OR Station.Filling);
	Station.SampleREQ	:= NOT Seq.Paused AND (Station.Vacuuming OR Station.Pressurizing OR Station.Sampling);
	Station.VacuumREQ	:= NOT Seq.Paused AND Station.Vacuuming;
END_IF;
</STSource>
		</FBProgram>
	</FBSource>
