	<FBSource nameOfFBType="DFB_TMR" version="0.03" dateTime="dt#2026-01-28-13:11:18">
		<attribute name="TypeCodeCheckSumString" value="5B03"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="48C2"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<publicLocalVariables>
			<variables name="IN" typeName="BOOL"></variables>
			<variables name="PT" typeName="REAL"></variables>
			<variables name="PT_Raw" typeName="TIME"></variables>
			<variables name="ET" typeName="REAL"></variables>
			<variables name="ET_Raw" typeName="TIME"></variables>
			<variables name="TT" typeName="BOOL"></variables>
			<variables name="Q" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="TMR" typeName="TON"></variables>
		</privateLocalVariables>
		<FBProgram name="Logic">
			<STSource>PT_Raw	:= REAL_TO_TIME(PT*1000.0);


TMR (	IN	:= 	IN,
	PT	:= 	PT_RAW,
	ET	=&gt;	ET_Raw,
	Q	=&gt;	Q);

TT := IN AND NOT Q;

ET	:= TIME_TO_REAL(ET_Raw)/1000.0;

</STSource>
		</FBProgram>
	</FBSource>
