					<textBox width="10" height="4">Never open Vent Valve Automatically<objPosition posX="165" posY="186"></objPosition>
					</textBox>
					<textBox width="10" height="16">Shutdown Mode<objPosition posX="10" posY="130"></objPosition>
					</textBox>
					<textBox width="14" height="2">Max time for Shutdown<objPosition posX="76" posY="141"></objPosition>
					</textBox>
					<textBox width="15" height="2">Device Control<objPosition posX="117" posY="11"></objPosition>
					</textBox>
					<textBox width="10" height="30">Running Mode<objPosition posX="10" posY="70"></objPosition>
					</textBox>
					<textBox width="10" height="3">Idle Mode<objPosition posX="16" posY="6"></objPosition>
					</textBox>
					<textBox width="38" height="4">ENB:Command Received | Online: Command Out Issued | Good: System Running Ok<objPosition posX="55" posY="2"></objPosition>
					</textBox>
					<textBox width="38" height="2">Modes are set either from HMI or from Sequence Code<objPosition posX="4" posY="1"></objPosition>
					</textBox>
					<textBox width="14" height="2">Outlet Pressure Check for Recycle<objPosition posX="48" posY="154"></objPosition>
					</textBox>
					<textBox width="10" height="14">Priming Mode<objPosition posX="10" posY="52"></objPosition>
					</textBox>
					<textBox width="10" height="3">Offline Mode<objPosition posX="4" posY="6"></objPosition>
					</textBox>
					<textBox width="10" height="29">Cooling Mode<objPosition posX="10" posY="20"></objPosition>
					</textBox>
					<textBox width="10" height="5">Make sure compressor outlet pressure is higher than downstream press<objPosition posX="75" posY="101"></objPosition>
					</textBox>
					<textBox width="22" height="4">This turns on the commands for the cooling system<objPosition posX="79" posY="11"></objPosition>
					</textBox>
					<textBox width="15" height="2">Valve Control in this column<objPosition posX="156" posY="11"></objPosition>
					</textBox>
				</networkFBD>
			</FBDSource>
		</FBProgram>
		<FBProgram name="Operating_Modes">
			<STSource>IF Op_Select &lt;&gt; Op_Select_Last THEN
	Op_Select_Last := Op_Select;
	OpMode := Op_Select;
END_IF;


IF OpMode = eOpMode.Offline THEN
	ModeMessage 		:= 'Compressor Offline';
	ModeMessageColor 	:= Color.Gray;

	CompMode.Cool.Enb 	:= FALSE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;
ELSIF OpMode = eOpMode.Idle THEN
	ModeMessage := 'Compressor in Idle';
	ModeMessageColor := Color.Black;

	CompMode.Cool.Enb 	:= FALSE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;
ELSIF OpMode = eOpMode.Cool THEN
	ModeMessage := 'Compressor Cooling';
	ModeMessageColor := Color.Cyan;

	CompMode.Cool.Enb 	:= TRUE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;
ELSIF OpMode = eOpMode.Prime THEN
	ModeMessage := 'Compressor Priming';
	ModeMessageColor := Color.Cyan;	

	CompMode.Cool.Enb 	:= TRUE;
	CompMode.Prime.Enb 	:= TRUE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;
ELSIF OpMode = eOpMode.Run THEN
	ModeMessage := 'Compressor Running';
	ModeMessageColor := Color.Green;

	CompMode.Cool.Enb 	:= TRUE;
	CompMode.Prime.Enb 	:= TRUE;
	CompMode.Run.Enb	:= TRUE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;	
ELSIF OpMode = eOpMode.Shutdown THEN
	ModeMessage := 'Compressor Shutting Down';
	ModeMessageColor := Color.Yellow;

	CompMode.Cool.Enb 	:= TRUE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= TRUE;
	Maint := FALSE;	
ELSIF OpMode = eOpMode.Vent THEN
	ModeMessage := 'Compressor Venting';
	ModeMessageColor := Color.Yellow;

	CompMode.Cool.Enb 	:= FALSE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;	
ELSIF OpMode = eOpMode.Vacuum THEN
	ModeMessage := 'Compressor Ready for Vacuum';
	ModeMessageColor := Color.Yellow;

	CompMode.Cool.Enb 	:= FALSE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := FALSE;
ELSIF OpMode = eOpMode.Maintenance THEN
	ModeMessage := 'Compressor in Maintenance';
	ModeMessageColor := Color.Yellow;

	CompMode.Cool.Enb 	:= FALSE;
	CompMode.Prime.Enb 	:= FALSE;
	CompMode.Run.Enb	:= FALSE;
	CompMode.Vent.Enb	:= FALSE;
	CompMode.Vacuum.Enb	:= FALSE;
	CompMode.Blowdown.Enb	:= FALSE;
	CompMode.Shutdown.Enb	:= FALSE;
	Maint := TRUE;
END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="Seq">
			<STSource>(* Compressor Sequencing *)
(* Timer Calls *)
Init ();
Cooling();
CoolingTMO();
Priming();

(* Timer Presets *)
Init.PT := 0.5;
Cooling.PT := Vars.Cooling_Time;
CoolingTMO.PT := 60.0; (* Timeout is 60s after cooling should finish *)
Priming.PT := Vars.Priming_Time;

Seq.Disabled	:= Seq.State = 0;
Seq.Ready	:= Seq.State = 5000;
Seq.Running	:= Seq.State &gt; 5000;

(* Mode Control *)
IF Seq.HMI_Auto THEN
	Seq.Auto	:= TRUE;
	Seq.Manual	:= FALSE;
	Seq.Off	:= FALSE;
	Seq.HMI_Auto	:= FALSE;
ELSIF Seq.HMI_Manual THEN
	Seq.Auto	:= FALSE;
	Seq.Manual	:= TRUE;
	Seq.Off	:= FALSE;
	Seq.HMI_Manual	:= FALSE;
ELSIF Seq.HMI_Off THEN
	Seq.Auto	:= FALSE;
	Seq.Manual	:= FALSE;
	Seq.Off		:= TRUE;
	Seq.HMI_Off	:= FALSE;
END_IF;

(* Estop and Fault Logic *)
IF Estop_Active THEN
	Seq.State := 0;
	IF OpMode &lt;&gt; eOpMode.Maintenance THEN
		OpMode := eOpMode.Offline;
	END_IF;
ELSIF CompMode.Cool.Enb AND CompMode.Cool.Fail THEN
	Seq.State := 0;
ELSIF CompMode.Prime.Enb AND CompMode.Prime.Fail THEN
	Seq.State := 0;
ELSIF CompMode.Run.Enb AND CompMode.Run.Fail THEN
	Seq.State := 0;
ELSIF CompMode.Shutdown.Enb AND CompMode.Shutdown.Fail THEN
	Seq.State := 0;
END_IF;

(* Moving in and Out of Maint Mode *)
IF Seq.State &lt;= 5000 AND Op_Select = eOpMode.Maintenance THEN
	Seq.State := 100;
END_IF;

(* Handling Interlocks *)
IF Interlock OR Seq.Abort THEN
	IF Seq.State &gt;= 7000 AND Seq.State &lt; 9000 THEN
		Seq.State := 9000;
	ELSE
		Seq.State := 5000;
	END_IF;
END_IF;

(* Running and Cooling Mode Lost *)
IF Seq.State &gt;= 7000 AND NOT CompMode.Cool.Good THEN
	Seq.State := 9000;
END_IF;

(* Case Statement *)
CASE Seq.State OF 

	0: (* Disabled State *)
		IF Estop_Active THEN
			Seq.Msg := 'Emergency Stop Active';		
		ELSIF Interlock THEN
			Seq.Msg := 'Interlock Active';
		ELSE
			Seq.Msg := 'Disabled';
		END_IF;

		(* Time Resets *)
		Init.IN := FALSE;

		IF NOT Estop_Active AND NOT Interlock THEN
			Seq.State := 1000;
		END_IF;

	100: (* Holding State for Maintenance Mode *)
		IF Op_Select = eOpMode.Idle THEN
			Seq.State := 0;
		END_IF;

	1000: (* Initialization *)
		Seq.Msg := 'Initializing';
		Seq.Start := FALSE;
		Seq.Abort := FALSE;
		Init.IN := TRUE;
		
		IF Init.Q THEN
			Init.IN := FALSE;
			Seq.State := 5000;
			OpMode := eOpMode.Idle;
		END_IF;

	5000: (* Idle *)
		Seq.Msg := 'Compressor Ready to Start';
		Seq.Abort := FALSE;

		(* Time Resets *)
		Cooling.IN := FALSE;
		CoolingTMO.IN := FALSE;
		Priming.IN := FALSE;

		IF Seq.Start THEN
			Seq.Start := FALSE;
			Seq.State := 6000;
		END_IF;

	6000: (* Cooling Mode *)
		Seq.Msg := 'Compressor Cooling';
		OpMode := eOpMode.Cool;
		IF CompMode.Cool.Enb THEN
			Seq.State := 6100;
		END_IF;

	6100: (* Waiting for Cooling Online *)
		IF CompMode.Cool.Online THEN
			Cooling.IN := TRUE;
			Seq.State := 6200;
		ELSIF CompMode.Cool.Fail THEN
			Cooling.IN := FALSE;
			Seq.Msg := 'Cooling Failed';
			Seq.State := 0;
		END_IF;
	
	6200: (*Wait for Cooling Mode Good *)
		IF CompMode.Cool.Good THEN
			Cooling.IN:= TRUE;
			IF Cooling.Q THEN
				Cooling.IN := FALSE;
				Seq.State := 6300;
			END_IF;
		END_IF;


	6300: (* Cooling - Checking Setpoints *)
		CoolingTMO.IN := TRUE;
		IF	InterStgPT &lt; Vars.Max_Interstage_Press AND 
			Stg2DischTemp &lt; Vars.Max_Stg2_Disch_Temp AND
			CoolingFT &gt; Vars.Min_Coolant_Flow AND 
			InletPT &lt; Vars.Max_Priming_Press AND
			InterStgPT &lt; Vars.Max_Priming_Press AND
			OutletPT &lt; Vars.Max_Priming_Press THEN

			CoolingTMO.IN := FALSE;
			Seq.State := 7000;
		ELSE
			Seq.Msg := 'Compressor Starting Conditions Not Ok';

			IF CoolingTMO.Q THEN
				Seq.Msg := 'Cooling System Timeout';
				CoolingTMO.IN := FALSE;
				Seq.State := 5000;
			END_IF;
		END_IF;

	7000: (* Priming  *)
		Seq.Msg := 'Compressor Priming';
		OpMode := eOpMode.Prime;
		IF CompMode.Prime.Enb THEN
			Seq.State := 7100;
		END_IF;
	
	7100: (* Wait for Priming to come online *)
		IF CompMode.Prime.Online THEN
			Priming.IN := TRUE;
			Seq.State := 7200;
		END_IF;
	
	7200: (* Run Priming Timer *)
		IF Priming.Q THEN
			Priming.IN := FALSE;
			Seq.State := 8000;
		END_IF;

	8000: (* Running - Either Recovery or Feed *)
		Seq.Msg := 'Compressor Moving to Steady State';
		OpMode := eOpMode.Run;
		IF CompMode.Run.Enb THEN
			Seq.State := 8100;
		END_IF;
	
	8100: (* Wait for Run Mode Online *)
		IF CompMode.Run.Online THEN
			Seq.State := 8200;
		END_IF;

	8200: (* Running in Steady State *)
		Seq.Msg := 'Compressor Online';
		IF Seq.Abort THEN
			Seq.State := 9000;
		END_IF;

	9000: (* Controlled Shutdown *)
		Seq.Msg := 'Shutting Down';
		OpMode := eOpMode.Shutdown;
		IF CompMode.Shutdown.Enb THEN
			Seq.State := 9100;
		END_IF;
	
	9100: (* Wait for Shutdown Online *)
		IF CompMode.Shutdown.Online THEN
			Seq.State := 9200;
		END_IF;

	9200: (* Wait for Shutdown Complete *)
		Seq.Msg := 'Shutdown Complete';
		IF CompMode.Shutdown.Complete THEN
			Seq.State := 1000;
		END_IF;

END_CASE;

</STSource>
		</FBProgram>
	</FBSource>
