	<DDTSource DDTName="ReadVar" version="0.06" dateTime="dt#2024-02-15-08:51:47">
		<attribute name="TypeSignatureCheckSumString" value="EB2B"></attribute>
		<structure>
			<variables name="Enable" typeName="BOOL"></variables>
