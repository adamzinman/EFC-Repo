	<FBSource nameOfFBType="DFB_SCT_Fieldbus" version="0.15" dateTime="dt#2026-02-05-16:30:23">
		<attribute name="TypeCodeCheckSumString" value="A9BD"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="D8D6"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="TareAll" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="ZeroAll" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="ScaleRaw" typeName="T_Scales">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<publicLocalVariables>
			<variables name="OutputBusy" typeName="BOOL"></variables>
			<variables name="Num" typeName="INT"></variables>
			<variables name="Scale" typeName="ARRAY[1..16] OF DDT_Scale"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="Data" typeName="ARRAY[1..16] OF DDT_SCT2200"></variables>
			<variables name="RawInput" typeName="ARRAY[0..127] OF BYTE"></variables>
			<variables name="RawOutput" typeName="ARRAY[0..127] OF BYTE"></variables>
			<variables name="ByteNo" typeName="ARRAY[1..8] OF INT"></variables>
			<variables name="CMD" typeName="DDT_SCT2200_CMDs">
				<instanceElementDesc name="None">
					<value>2#0000_0000</value>
				</instanceElementDesc>
				<instanceElementDesc name="Zero">
					<value>2#0000_0001</value>
				</instanceElementDesc>
				<instanceElementDesc name="Tare">
					<value>2#0000_0010</value>
				</instanceElementDesc>
				<instanceElementDesc name="Tare_PT">
					<value>2#0000_0011</value>
				</instanceElementDesc>
				<instanceElementDesc name="SP1_Setting">
					<value>2#0000_1010</value>
				</instanceElementDesc>
				<instanceElementDesc name="SP2_Setting">
					<value>2#0000_1011</value>
				</instanceElementDesc>
				<instanceElementDesc name="DO_Setting">
					<value>2#0001_1001</value>
				</instanceElementDesc>
				<instanceElementDesc name="Reboot">
					<value>2#0010_0010</value>
				</instanceElementDesc>
				<instanceElementDesc name="Read_Cal">
					<value>2#0010_0011</value>
				</instanceElementDesc>
				<instanceElementDesc name="Write_Cal">
					<value>2#0010_0100</value>
				</instanceElementDesc>
				<instanceElementDesc name="Cal_Point_Acq">
					<value>2#0010_0101</value>
				</instanceElementDesc>
				<instanceElementDesc name="About_Cal">
					<value>2#0010_0110</value>
				</instanceElementDesc>
				<instanceElementDesc name="Lock_Key">
					<value>2#0010_1000</value>
				</instanceElementDesc>
			</variables>
			<variables name="LOOP" typeName="INT"></variables>
			<variables name="ScaleNo" typeName="INT"></variables>
			<variables name="DataNo" typeName="INT"></variables>
			<variables name="GrossWordHigh" typeName="WORD"></variables>
			<variables name="GrossWordLow" typeName="WORD"></variables>
			<variables name="NetWordHigh" typeName="WORD"></variables>
			<variables name="NetWordLow" typeName="WORD"></variables>
			<variables name="PRG_PB_Reset_CMDS" typeName="BOOL"></variables>
			<variables name="WriteState" typeName="ARRAY[1..16] OF DINT"></variables>
		</privateLocalVariables>
		<FBProgram name="InputMapping">
			<STSource>(* GRABBING THE RAW ARRAY FOR EASIER ALIASING *)
RawInput := ScaleRaw.Inputs.Input;

(* MOVING VALUES TO THEIR RESPECTIVE SCALES *)
FOR ScaleNo := 1 TO 16 DO
	FOR DataNo := 1 TO 8 DO
		ByteNo[DataNo] := ((ScaleNo-1)*8)+DataNo;
	END_FOR;

	(* BYTE 1: IN/OUT STATUS *)
	Data[ScaleNo].InputN1 		:= RawInput[ByteNo[1]].0;
	Data[ScaleNo].InputN2 		:= RawInput[ByteNo[1]].1;
	Data[ScaleNo].OutputN1 		:= RawInput[ByteNo[1]].2;
	Data[ScaleNo].OutputN2 		:= RawInput[ByteNo[1]].3;
	Data[ScaleNo].LastCmdResult	:= RawInput[ByteNo[1]].4;
	Data[ScaleNo].LoopCounter1		:= RawInput[ByteNo[1]].5;
	Data[ScaleNo].LoopCounter2 	:= RawInput[ByteNo[1]].6;
	Data[ScaleNo].ScalePresent		:= RawInput[ByteNo[1]].7;

	(* BTYE 2-4: RAW GROSS WEIGHT - 2=MSB 4=LSB *)
	GrossWordHigh := BYTE_TO_WORD (	IN := RawInput[ByteNo[2]]);
	GrossWordLow := BYTE_AS_WORD (	LOW := RawInput[ByteNo[3]],
	                          	HIGH := RawInput[ByteNo[4]]);
	Data[ScaleNo].GrossWeightRaw := WORD_AS_DINT (LOW := GrossWordLow,
	                          		HIGH := GrossWordHigh);
	Data[ScaleNo].GrossWeight := DINT_TO_REAL(Data[ScaleNo].GrossWeightRaw)/100.0;


	(* BYTE 5: SCALE STATUS *)

	(* BYTE 6-8: RAW NET WEIGHT - 6=MSB 8=LSB *)
	NetWordHigh := BYTE_TO_WORD (	IN := RawInput[ByteNo[6]]);
	NetWordLow := BYTE_AS_WORD (	LOW := RawInput[ByteNo[7]],
	                          	HIGH := RawInput[ByteNo[8]]);
	Data[ScaleNo].NetWeightRaw := WORD_AS_DINT (LOW := NetWordLow,
	                          		HIGH := NetWordHigh);
	Data[ScaleNo].NetWeight := DINT_TO_REAL(Data[ScaleNo].NetWeightRaw)/100.0;




	(* MOVING OUTPUT DATA TO THE RAW ARRAY *)
	IF Data[ScaleNo].Cmd_Issued AND NOT OutputBusy THEN
		RawOutput[1] := INT_TO_BYTE(ScaleNo);
		RawOutput[2] := Data[ScaleNo].Cmd_Val;
	END_IF;






END_FOR;

ScaleRaw.Outputs.Output := RawOutput;
</STSource>
		</FBProgram>
		<FBProgram name="Commands">
			<STSource>(* Makes sure the scale number being referenced is within bounds *)
IF %S13 OR Num &lt; 1 or Num &gt; 16 THEN
	Num := 16;
END_IF;



FOR LOOP := 1 TO 16 DO
	IF PRG_PB_Reset_CMDS OR %S13 THEN
		Data[LOOP].Cmd_Val := CMD.None;
		Scale[LOOP].TareCmd := FALSE;
		Scale[LOOP].ZeroCmd := FALSE;
	ELSIF TareAll THEN
		Data[LOOP].Cmd_Val := CMD.Tare;
		Scale[LOOP].TareCmd := TRUE;
	ELSIF ZeroAll THEN
		Data[LOOP].Cmd_Val := CMD.Zero;
		Scale[LOOP].ZeroCmd := TRUE;
	END_IF;
END_FOR;

(* IF Data[Num].Cmd_Val &lt;&gt; 0  AND *)

CASE WriteState[Num] OF 
	0: (* Disabled if no scale present *)
		Data[Num].Cmd_Transmitted := FALSE;
		IF Data[Num].ScalePresent THEN
			WriteState[Num] := 1000;
		END_IF;
	
	1000: (* Waits for Command*)
		IF Data[Num].Cmd_Val &gt; 0 THEN
			WriteState[Num] := 2000;
			Data[Num].Cmd_Transmitted := TRUE;
		ELSE
			IF Num &lt; 16 THEN
				Num := Num + 1;
			ELSE
				Num := 1;
			END_IF;
		END_IF;

	2000: (* Look for Command to be Received *)
		IF Data[Num].CMD_Received THEN
			WriteState[Num] := 0;
		END_IF;
		(* INCOMPLETE *)

END_CASE;
			
</STSource>
		</FBProgram>
	</FBSource>
