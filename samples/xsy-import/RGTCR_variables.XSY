	<FBSource nameOfFBType="DFB_Minebea_OLD" version="0.24" dateTime="dt#2025-12-10-14:20:11">
		<attribute name="TypeCodeCheckSumString" value="49CF"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="60B1"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="Input" typeName="ARRAY[0..7] OF BYTE">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
			<variables name="Freshness" typeName="BOOL">
				<attribute name="PositionPin" value="3"></attribute>
			</variables>
			<variables name="Freshness_1" typeName="BOOL">
				<attribute name="PositionPin" value="4"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Scale" typeName="DDT_Scale">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="Output" typeName="ARRAY[0..7] OF BYTE">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="Raw" typeName="DDT_Minebea"></variables>
			<variables name="StabilityTimeout" typeName="BOOL"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="Write" typeName="DDT_MinebeaWriteCmd">
				<instanceElementDesc name="Lock_Keypad">
					<value>3</value>
				</instanceElementDesc>
				<instanceElementDesc name="Unlock_Keypad">
					<value>4</value>
				</instanceElementDesc>
				<instanceElementDesc name="FixedTare">
					<value>31</value>
				</instanceElementDesc>
				<instanceElementDesc name="Send_Init_Data">
					<value>33</value>
				</instanceElementDesc>
				<instanceElementDesc name="Start_App">
					<value>40</value>
				</instanceElementDesc>
				<instanceElementDesc name="Start_Cal">
					<value>107</value>
				</instanceElementDesc>
				<instanceElementDesc name="Stop_Cal">
					<value>108</value>
				</instanceElementDesc>
				<instanceElementDesc name="Set_to_Zero">
					<value>112</value>
				</instanceElementDesc>
				<instanceElementDesc name="Tare">
					<value>113</value>
				</instanceElementDesc>
				<instanceElementDesc name="Cancel_Tare">
					<value>114</value>
				</instanceElementDesc>
				<instanceElementDesc name="Reset_Power_Fail">
					<value>117</value>
				</instanceElementDesc>
				<instanceElementDesc name="TareWithFixed">
					<value>118</value>
				</instanceElementDesc>
				<instanceElementDesc name="CopyGrossToTare">
					<value>119</value>
				</instanceElementDesc>
				<instanceElementDesc name="AckCmdError">
					<value>121</value>
				</instanceElementDesc>
			</variables>
			<variables name="Read" typeName="DDT_MinebeaReadCmd">
				<instanceElementDesc name="IndStatus">
					<value>2#0000_0001</value>
				</instanceElementDesc>
				<instanceElementDesc name="Exponent">
					<value>2#0000_0100</value>
				</instanceElementDesc>
				<instanceElementDesc name="Unit">
					<value>2#0000_0100</value>
				</instanceElementDesc>
				<instanceElementDesc name="ScaleInterval">
					<value>2#0000_0100</value>
				</instanceElementDesc>
				<instanceElementDesc name="SerialNo">
					<value>2#0000_0110</value>
				</instanceElementDesc>
				<instanceElementDesc name="Gross">
					<value>2#0000_1000</value>
				</instanceElementDesc>
				<instanceElementDesc name="Net">
					<value>2#0000_1001</value>
				</instanceElementDesc>
				<instanceElementDesc name="Tare">
					<value>2#0000_1010</value>
				</instanceElementDesc>
				<instanceElementDesc name="ScaleEndValue">
					<value>2#0000_1110</value>
				</instanceElementDesc>
				<instanceElementDesc name="FixedTare">
					<value>2#0001_1111</value>
				</instanceElementDesc>
				<instanceElementDesc name="Reference">
					<value>2#1011_1110</value>
				</instanceElementDesc>
				<instanceElementDesc name="ADUstatus">
					<value>2#0000_0001</value>
				</instanceElementDesc>
				<instanceElementDesc name="CmdStatus">
					<value>2#0000_0001</value>
				</instanceElementDesc>
				<instanceElementDesc name="Activs">
					<value>2#0000_0001</value>
				</instanceElementDesc>
				<instanceElementDesc name="LastError">
					<value>2#0000_0100</value>
				</instanceElementDesc>
			</variables>
			<variables name="StateData" typeName="DINT"></variables>
			<variables name="StateRead" typeName="DINT"></variables>
			<variables name="StartupDLY" typeName="TON"></variables>
			<variables name="StartupDLY_IN" typeName="BOOL"></variables>
			<variables name="WriteTrigTMO" typeName="TON"></variables>
			<variables name="WriteTrigTMO_IN" typeName="BOOL"></variables>
			<variables name="ReadValDLY" typeName="TON"></variables>
			<variables name="ReadValDLY_IN" typeName="BOOL"></variables>
			<variables name="ResetPowerFailTMR" typeName="TON"></variables>
			<variables name="ResetPowerFailTMR_IN" typeName="BOOL"></variables>
			<variables name="StabilityTMO" typeName="TON"></variables>
			<variables name="StabilityTMO_IN" typeName="BOOL"></variables>
			<variables name="ReadWord" typeName="ARRAY[0..1] OF WORD"></variables>
			<variables name="WriteWord" typeName="ARRAY[0..1] OF WORD"></variables>
			<variables name="WriteTrig" typeName="BOOL"></variables>
			<variables name="ReadTypeBuffer" typeName="BYTE"></variables>
			<variables name="DataReady" typeName="BOOL"></variables>
			<variables name="WeightScaleFactor" typeName="REAL"></variables>
			<variables name="ValTrig" typeName="R_TRIG"></variables>
		</privateLocalVariables>
		<FBProgram name="ScaleReading">
			<STSource>
(* Timers *)
StartupDLY 	(IN:=StartupDLY_IN, 	PT:= T#1S);
WriteTrigTMO	(IN:=WriteTrigTMO_IN,	PT:= T#30S);
ReadValDLY	(IN:=ReadValDLY_IN,	PT:= T#500MS);
ResetPowerFailTMR (IN:=ResetPowerFailTMR_IN, PT:= T#500MS);
StabilityTMO	(IN:=StabilityTMO_IN,	PT:= T#30S);

(* Trigger *)
ValTrig (CLK:= StateRead=5000);

(* Cycle Commands through values *)
IF ValTrig.Q THEN
	IF Raw.ReadType = Read.Exponent THEN
		ReadTypeBuffer := Read.Gross;
	ELSIF Raw.ReadType = Read.Gross THEN
		ReadTypeBuffer := Read.Net;
	ELSIF Raw.ReadType = Read.Net THEN
		ReadTypeBuffer := Read.Tare;
	ELSIF Raw.ReadType = Read.Tare THEN
		ReadTypeBuffer := Read.Exponent;
	ELSE
		ReadTypeBuffer := Read.Gross;
	END_IF;
END_IF;



(*Grab and Sort Data from ReadValue*)
IF DataReady THEN
	IF Raw.ReadType = Read.Exponent THEN
		Raw.Exponent		:= Input[0];
		Raw.Unit		:= Input[1];
		Raw.ScaleInterval	:= Input[2];
		(* Raw.LastError		:= Input[3]; *)

		IF Raw.Exponent = 0 THEN
			WeightScaleFactor := 1.0;
		ELSIF Raw.Exponent = 1 THEN
			WeightScaleFactor := 10.0;
		ELSIF Raw.Exponent = 2 THEN
			WeightScaleFactor := 100.0;
		ELSIF Raw.Exponent = 3 THEN
			WeightScaleFactor := 1000.0;
		END_IF;
		DataReady := FALSE;

	ELSIF Raw.ReadType = Read.Gross THEN
		Scale.GrossWeight	:= DINT_TO_REAL(Raw.ReadVal)/WeightScaleFactor;
		DataReady := FALSE;
	ELSIF Raw.ReadType = Read.Net THEN
		Scale.NetWeight	:= DINT_TO_REAL(Raw.ReadVal)/WeightScaleFactor;
		DataReady := FALSE;
	ELSIF Raw.ReadType = Read.Tare THEN
		Scale.TareWeight	:= DINT_TO_REAL(Raw.ReadVal)/WeightScaleFactor;
		DataReady := FALSE;
	END_IF;
END_IF;

(*Set State to Zero if Error*)
IF Scale.Warning OR Scale.Alarm OR Scale.Fault THEN
	StateRead := 0;
END_IF;

(* Read Value Sequence *)
CASE StateRead OF
	0: (* Commands Disabled *)
		(*Reset all Timers*)
		StartupDLY_IN	:= FALSE;
		WriteTrigTMO_IN	:= FALSE;
		ReadValDLY_IN	:= FALSE;
		DataReady := FALSE;

		IF NOT (Scale.Warning OR Scale.Alarm OR Scale.Fault) THEN
			StateRead := 1000;
		END_IF;
			
	1000: (* Check if Handshake Bit is 0 *)
		IF Raw.WriteHandShake = 0 THEN
			StartupDLY_IN := TRUE;
			StateRead := 2000;
		ELSE
			Write.Byte5 := 0;
			StateRead := 1100;
		END_IF;

	1100: (* Wait for Reset *)
		IF Raw.WriteHandShake = 0 THEN
			StartupDLY_IN := TRUE;
			StateRead := 2000;
		END_IF;

	2000: (* Delay *)
		IF StartupDLY.Q THEN
			STartupDLY_IN := FALSE;
			StateRead := 5000;
		END_IF;

	5000: (* Idle *)
		DataReady := FALSE;
		IF WriteTrig THEN
			Raw.DataTypeCmd := ReadTypeBuffer;
			WriteTrigTMO_IN := TRUE;
			WriteTrig := FALSE;
			StateRead := 5100;
		END_IF;
	
	5100: (* Wait for System to Change the Read Type*)
		IF Raw.DataTypeCmd = Raw.ReadType THEN
			WriteTrigTMO_IN := FALSE;
			ReadValDLY_IN := TRUE;
			StateRead := 5200;
		END_IF;

	5200: (*Wait for DLY to End, then Read Value*)
		IF ReadValDLY.Q THEN
			ReadValDLY_IN := FALSE;
			DataReady := TRUE;
			StateRead := 5300;
		END_IF;

	5300: (*Wait for Data to be Recorded into the Proper Locations*)
		IF DataReady = FALSE THEN
			StateRead := 5000;
		END_IF;
			
END_CASE;

(* Taring the Scale *)
IF Scale.TareCmd AND NOT Raw.CmdActive THEN
	Scale.Msg := 'Taring Scale';
	Raw.Tare := TRUE;
ELSIF Raw.Tare AND Raw.CmdActive THEN
	Scale.TareCmd := FALSE;
ELSIF NOT Scale.TareCmd AND Raw.TareActive THEN
	Raw.Tare := FALSE;
	Scale.Msg := 'Scale Tare Sucessful';
END_IF;
	

(* Zeroing the Scale *)
IF Scale.ZeroCmd AND NOT Raw.CmdActive THEN
	IF Raw.InsideZeroSettingRange THEN
		Scale.Msg := 'Zeroing Scale';
		Raw.SetZero := TRUE;
	ELSE
		Scale.Msg := 'Scale Weight Outside Zero Range';
		Raw.SetZero := FALSE;
	END_IF;
ELSIF Raw.SetZero AND Raw.CmdActive THEN
	Scale.ZeroCmd := FALSE;
ELSIF NOT Scale.ZeroCmd AND ABS(Scale.GrossWeight) &lt;= 1.0 THEN
	Raw.SetZero := FALSE;
END_IF;



(* Warning, Alarms, and Faults*)
Scale.Warning	:= Raw.CalActive OR Raw.OverScaleEndValue OR Raw.LargeOverload OR Raw.BelowZero or Raw.OutsideAdjustment;
Scale.Alarm		:= Raw.ScaleError OR Raw.CmdError OR StabilityTimeout;
Scale.Fault		:= Raw.PowerFail;


(* Reset Functions*)
IF Raw.PowerFail THEN
	Scale.Msg := 'Scale Power Failure - Reset Required';
	IF Scale.ResetScale AND NOT Raw.ResetPowerFail THEN
		Raw.ResetPowerFail := TRUE;
		Scale.ResetScale := FALSE;
	ELSIF NOT Raw.PowerFail AND Raw.ResetPowerFail THEN
		Raw.ResetPowerFail := FALSE;
	END_IF;
END_IF;


(* Reset the Stability Timeout Alarm *)
IF StabilityTimeout AND Scale.ResetScale THEN
	StabilityTimeout := FALSE;
END_IF;
</STSource>
		</FBProgram>
		<FBProgram name="DataMapping">
			<STSource>
(** Assign Inputs **)
(*Bytes 0-3*)
ReadWord[0] := BYTE_AS_WORD (LOW := Input[1], HIGH := Input[0]);
ReadWord[1] := BYTE_AS_WORD (LOW := Input[3], HIGH := Input[2]);
Raw.ReadVal := WORD_AS_DINT (LOW := ReadWord[1], HIGH := ReadWord[0]);

(*Byte 4*)
Raw.ReadType 	:= (Input[4]);

(*Byte 5*)
Raw.RefWeightChanged	:= Input[5].0;
Raw.PowerFail		:= Input[5].6;
Raw.WriteHandShake 	:= Input[5].7;

(* Byte 6*)
Raw.CalActive	:= Input[6].1;
Raw.TareActive	:= Input[6].2;
Raw.CmdError	:= Input[6].6;
Raw.CmdActive	:= Input[6].7;

(*Byte 7*)
Raw.ScaleError			:= Input[7].0;
Raw.OverScaleEndValue		:= Input[7].1;
Raw.LargeOverload		:= Input[7].2;
Raw.BelowZero			:= Input[7].3;
Raw.QtrDRange			:= Input[7].4;
Raw.InsideZeroSettingRange	:= Input[7].5;
Raw.Stability			:= Input[7].6;
Raw.OutsideAdjustment		:= Input[7].7;

(** Assign Outputs **)
(* Bytes 0-3*)
DINT_AS_WORD (IN := Raw.WriteCmd, LOW =&gt; WriteWord[0], HIGH =&gt; WriteWord[1]);
WORD_AS_BYTE (IN := WriteWord[0], LOW =&gt; Output[3], HIGH =&gt; Output[2]);
WORD_AS_BYTE (IN := WriteWord[1], LOW =&gt; Output[1], HIGH =&gt; Output[0]);


(*Byte 4*)
Output[4] := Raw.DataTypeCmd;

(*Byte 5*)
Output[5] := Raw.WriteDataType;

(*Byte 6*)
Output[6].3 := Raw.CalStart;
Output[6].4 := Raw.CalStop;

(*Byte 7*)
Output[7].0 := Raw.SetZero;
Output[7].1 := Raw.Tare;
Output[7].2 := Raw.CancelTare;
Output[7].5 := Raw.ResetPowerFail;
Output[7].6 := Raw.SetFixedTare;
Output[7].7 := Raw.UseAsFixedTare;

</STSource>
		</FBProgram>
	</FBSource>
	<DDTSource DDTName="DDT_Minebea" version="0.08" dateTime="dt#2026-02-11-16:51:19">
		<attribute name="TypeSignatureCheckSumString" value="C10C"></attribute>
		<structure>
			<variables name="WriteCmd" typeName="DINT"></variables>
			<variables name="DataTypeCmd" typeName="BYTE">
				<comment>Fill this to change the requested </comment>
			</variables>
			<variables name="WriteDataType" typeName="BYTE"></variables>
			<variables name="CalStart" typeName="BOOL">
				<comment>start calibration with „default weight“</comment>
			</variables>
			<variables name="CalStop" typeName="BOOL">
				<comment>stop calibration with „default weights“</comment>
			</variables>
			<variables name="SetZero" typeName="BOOL">
				<comment>sets the scale to zero if the weight is within the zero-setting range</comment>
			</variables>
			<variables name="Tare" typeName="BOOL">
				<comment>tares the scale</comment>
			</variables>
			<variables name="CancelTare" typeName="BOOL">
				<comment>cancels the tare weight on the scale</comment>
			</variables>
			<variables name="ResetPowerFail" typeName="BOOL">
				<comment>causes power-fail flag in the slave’s read data to be reset</comment>
			</variables>
			<variables name="SetFixedTare" typeName="BOOL">
				<comment>tares the scale with the value in the fixed tare memory</comment>
			</variables>
			<variables name="UseAsFixedTare" typeName="BOOL">
				<comment>writes the current gross value into the fixed tare memory</comment>
			</variables>
			<variables name="ReadVal" typeName="DINT">
				<comment>Current Read Value</comment>
			</variables>
			<variables name="ReadType" typeName="BYTE"></variables>
			<variables name="Exponent" typeName="BYTE"></variables>
			<variables name="Unit" typeName="BYTE"></variables>
			<variables name="ScaleInterval" typeName="BYTE"></variables>
			<variables name="RefWeightChanged" typeName="BOOL">
				<comment>If the application is read out or re-initialized, the bit is set. With the command 0x79 = acknowledge a </comment>
			</variables>
			<variables name="PowerFail" typeName="BOOL">
				<comment>Power to scale was interrupted (this signal must be reset using either the “Reset power fail” bit or the Write data </comment>
			</variables>
			<variables name="WriteHandShake" typeName="BOOL">
				<comment>0 = Minebea Intec indicator (conrol unit) or complete scale is ready to receive new write values</comment>
			</variables>
			<variables name="CalActive" typeName="BOOL">
				<comment>Scale is being calibrated/adjusted or the unit was changed; the exponent has changed, scale has been switched</comment>
			</variables>
			<variables name="TareActive" typeName="BOOL">
				<comment>Scale is tared</comment>
			</variables>
			<variables name="CmdError" typeName="BOOL">
				<comment>After every write cycle, the parameter is checked for validity, or if it is an action, it is checked for feasibility. </comment>
			</variables>
			<variables name="CmdActive" typeName="BOOL">
				<comment>The requested action is still active (e.g., the scale is waiting for stability after receiving a tare command).</comment>
			</variables>
			<variables name="ScaleError" typeName="BOOL">
				<comment>Scale is in error state, e.g., ‘err 54’. The read data (weight values) in bytes 0-3 are then invalid. </comment>
			</variables>
			<variables name="OverScaleEndValue" typeName="BOOL">
				<comment>Scale is above scale end value to the point at which “H” is displayed (maximum scale range of e.g., 5000 kg)</comment>
			</variables>
			<variables name="LargeOverload" typeName="BOOL">
				<comment>The scale is loaded beyond the overload range</comment>
			</variables>
			<variables name="BelowZero" typeName="BOOL">
				<comment>The scale is below zero</comment>
			</variables>
			<variables name="QtrDRange" typeName="BOOL"></variables>
			<variables name="InsideZeroSettingRange" typeName="BOOL">
				<comment>Scale is within zero-setting range</comment>
			</variables>
			<variables name="Stability" typeName="BOOL">
				<comment>The scale is stable</comment>
			</variables>
			<variables name="OutsideAdjustment" typeName="BOOL">
				<comment>The scale is between the scale end value and overload; if the W&amp;M mode is active, then also when weight &lt; 0</comment>
			</variables>
		</structure>
	</DDTSource>
