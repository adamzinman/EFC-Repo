	<FBSource nameOfFBType="DFB_Process_Value" version="0.18" dateTime="dt#2026-03-13-15:31:58">
		<attribute name="TypeCodeCheckSumString" value="B394"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="C599"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="Reset" typeName="BOOL">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="PV" typeName="DDT_Process_Value">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inOutParameters>
		<privateLocalVariables>
			<variables name="LL_TMR" typeName="TON"></variables>
			<variables name="L_TMR" typeName="TON"></variables>
			<variables name="H_TMR" typeName="TON"></variables>
			<variables name="HH_TMR" typeName="TON"></variables>
			<variables name="LL_TMR_IN" typeName="BOOL"></variables>
			<variables name="L_TMR_IN" typeName="BOOL"></variables>
			<variables name="H_TMR_IN" typeName="BOOL"></variables>
			<variables name="HH_TMR_IN" typeName="BOOL"></variables>
			<variables name="LL_TMR_PT" typeName="TIME"></variables>
			<variables name="L_TMR_PT" typeName="TIME"></variables>
			<variables name="H_TMR_PT" typeName="TIME"></variables>
			<variables name="HH_TMR_PT" typeName="TIME"></variables>
		</privateLocalVariables>
		<FBProgram name="Alarms">
			<STSource>(* CONVERT TIMER PT FROM INTO TO TIME *)
(* TIMEBASE IN IN MILLISECONDS SO HAVE TO MULTIPLY BY 1000 *)
LL_TMR_PT := 1000*REAL_TO_TIME(PV.LL.DLY);
L_TMR_PT := 1000*REAL_TO_TIME(PV.L.DLY);
H_TMR_PT := 1000*REAL_TO_TIME(PV.H.DLY);
HH_TMR_PT := 1000*REAL_TO_TIME(PV.HH.DLY);

(* DECLARE TIMERS*)
LL_TMR(IN:=LL_TMR_IN, PT:=LL_TMR_PT);
L_TMR(IN:=L_TMR_IN, PT:=L_TMR_PT);
H_TMR(IN:=H_TMR_IN, PT:=H_TMR_PT);
HH_TMR(IN:=HH_TMR_IN, PT:=HH_TMR_PT);

(*Low Low*)
LL_TMR_IN := PV.LL.Enabled AND NOT PV.LL.Inhibit AND PV.PV &lt;= PV.LL.SP;
PV.LL.Alarm := LL_TMR.Q OR (PV.LL.Alarm AND NOT Reset);

(*Low*)
L_TMR_IN := PV.L.Enabled AND NOT PV.L.Inhibit AND PV.PV &lt;= PV.L.SP;
PV.L.Alarm := L_TMR.Q OR (PV.L.Alarm AND L_TMR_IN);

(*High*)
H_TMR_IN := PV.H.Enabled AND NOT PV.H.Inhibit AND PV.PV &gt;= PV.H.SP;
PV.H.Alarm := H_TMR.Q OR (PV.H.Alarm AND H_TMR_IN);

(*High High*)
HH_TMR_IN := PV.HH.Enabled AND NOT PV.HH.Inhibit AND PV.PV &gt;= PV.HH.SP;
PV.HH.Alarm := HH_TMR.Q OR (PV.HH.Alarm AND NOT Reset);

</STSource>
		</FBProgram>
	</FBSource>
