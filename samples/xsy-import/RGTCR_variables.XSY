			<variables name="ErrorCode" typeName="INT"></variables>
		</structure>
	</DDTSource>
	<FBSource nameOfFBType="DFB_Minebea" version="0.29" dateTime="dt#2026-05-28-11:44:40">
		<attribute name="TypeCodeCheckSumString" value="0143"></attribute>
		<attribute name="TypeSignatureCheckSumString" value="F2D4"></attribute>
		<attribute name="UseNewTplSignAlgo" value="TRUE"></attribute>
		<inputParameters>
			<variables name="ReadData" typeName="ARRAY[0..7] OF WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</inputParameters>
		<inOutParameters>
			<variables name="Scale" typeName="DDT_Scale">
				<attribute name="PositionPin" value="2"></attribute>
			</variables>
		</inOutParameters>
		<outputParameters>
			<variables name="WriteData" typeName="ARRAY[0..7] OF WORD">
				<attribute name="PositionPin" value="1"></attribute>
			</variables>
		</outputParameters>
		<publicLocalVariables>
			<variables name="State" typeName="INT"></variables>
			<variables name="ReadVar" typeName="DINT"></variables>
			<variables name="WriteVar" typeName="WORD"></variables>
			<variables name="ReadWord" typeName="ARRAY[0..2] OF WORD"></variables>
			<variables name="ReadByte" typeName="ARRAY[0..4] OF BYTE"></variables>
			<variables name="i" typeName="INT"></variables>
			<variables name="Exp" typeName="REAL"></variables>
			<variables name="Units" typeName="STRING"></variables>
		</publicLocalVariables>
		<privateLocalVariables>
			<variables name="StateDLY" typeName="DFB_TMR"></variables>
			<variables name="TimeBase" typeName="REAL">
				<variableInit value="0.15"></variableInit>
			</variables>
		</privateLocalVariables>
		<FBProgram name="Commands">
			<STSource>(* Var Mapping *)
ReadVar  := WORD_AS_DINT (LOW := ReadData[1],
                          HIGH := ReadData[0]); 
WriteData[2] := WriteVar;

(*ReadWord[2] := INT_TO_WORD(ReadData[0]);*)
WORD_AS_BYTE (IN := ReadWord[0],
              LOW =&gt; ReadByte[0],
              HIGH =&gt; ReadByte[1]);

(* Timer Call *)
StateDLY();
Exp := 1000.0;

(* Timer Set *)
StateDLY.PT := TimeBase;


(* Variable Grabs *)

CASE State OF
	0: (* Disabled *)
		State := 1000;

	1000: (* Gross Weight *)
		WriteVar := 2048;
		StateDLY.IN := TRUE;;
		IF StateDLY.Q THEN
			StateDLY.IN := FALSE;
			Scale.GrossWeight := DINT_TO_REAL(ReadVar)/Exp;
			State := 2000;
		END_IF;


	2000: (* Net Weight *)
		WriteVar := 2304;
		StateDLY.IN := TRUE;;
		IF StateDLY.Q THEN
			StateDLY.IN := FALSE;
			Scale.NetWeight := DINT_TO_REAL(ReadVar)/Exp;
			State := 3000;
		END_IF;

	3000: (* Tare Weight *)
		WriteVar := 2560;
		StateDLY.IN := TRUE;;
		IF StateDLY.Q THEN
			StateDLY.IN := FALSE;
			Scale.TareWeight := DINT_TO_REAL(ReadVar)/Exp;
			State := 4000;
		END_IF;		

	4000: (* Zero Command - If Applicable *)
		IF Scale.ZeroCMD THEN
			WriteVar := 112;
			StateDLY.IN := TRUE;;
			IF StateDLY.Q THEN
				StateDLY.IN := FALSE;
				Scale.ZeroCMD := FALSE;
				State := 1000; (* If you run a tare, start over at beginning of loop to get updated values *)
			END_IF;
		ELSE
			State := 5000;
		END_IF;  

	5000: (* Zero Command - If Applicable *)
		IF Scale.TareCMD THEN
			WriteVar := 113;
			StateDLY.IN := TRUE;;
			IF StateDLY.Q THEN
				StateDLY.IN := FALSE;
				Scale.TareCMD := FALSE;
				State := 1000; (* If you run a tare, start over at beginning of loop to get updated values *)
			END_IF;
		ELSE
			State := 6000;
		END_IF;  

	6000: (* Cancel Tare - If Applicable *)
		(* Come back to this once it's tested *)
		IF Scale.ResetScale THEN
			WriteVar := 114;
			StateDLY.IN := TRUE;;
			IF StateDLY.Q THEN
				StateDLY.IN := FALSE;
				Scale.ResetScale := FALSE;
				State := 1000; (* If you run a tare, start over at beginning of loop to get updated values *)
			END_IF;
		ELSE
			State := 1000;
		END_IF;  


(* 	7000: (* Exponent/Unit - This is different from the others *)
		WriteVar := 1024;
		StateDLY.IN := TRUE;;
		IF StateDLY.Q THEN
			StateDLY.IN := FALSE;
			(* Determine Scaling Factor *)
			CASE BYTE_TO_INT(ReadByte[0]) OF
				0: Exp := 1.0;
				1: Exp := 10.0;
				2: Exp := 100.0;
				3: Exp := 1000.0;
			END_CASE;

			CASE BYTE_TO_INT(ReadByte[1]) OF 
				0: Units := 'Error';
				1: Units := 'mg';
				2: Units := 'g';
				3: Units := 'kg';
				4: Units := 't';
				5: Units := 'lbs';
			END_CASE;
			State := 1000;			
		END_IF; *)



END_CASE;
</STSource>
		</FBProgram>
	</FBSource>
