						<contact typeContact="openContact" contactVariableName="Interlock"></contact>
						<HLink nbCells="10"></HLink>
						<coil typeCoil="coil" coilVariableName="Valve.Interlock"></coil>
					</typeLine>
					<typeLine>
						<emptyLine nbRows="48"></emptyLine>
					</typeLine>
					<textBox width="8" height="1">Moves the interlock bit just for display purposes on the scada<objPosition posX="1" posY="50"></objPosition>
					</textBox>
					<textBox width="8" height="1">Mode control for the valve<objPosition posX="1" posY="4"></objPosition>
					</textBox>
					<textBox width="8" height="1">This takes the request from either manual or auto and if the logic is satisfied then issue the command to the valve.<objPosition posX="1" posY="24"></objPosition>
					</textBox>
					<textBox width="8" height="1">Permissive Control<objPosition posX="1" posY="0"></objPosition>
					</textBox>
					<textBox width="8" height="1">If no feedback from the valve, then put a 1s delay to simulate the valve action<objPosition posX="1" posY="34"></objPosition>
					</textBox>
					<textBox width="8" height="1">Cycle Counting Logic<objPosition posX="1" posY="43"></objPosition>
					</textBox>
				</networkLD>
			</LDSource>
		</FBProgram>
	</FBSource>
